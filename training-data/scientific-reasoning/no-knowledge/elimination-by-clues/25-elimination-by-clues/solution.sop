      "properties": {
        "has passed through the egg stage": false,
        "has passed through the larval stage": true,
        "has passed through the pupal stage": true,
        "is adult": true
      }
    },
    {
      "label": "D",
      "properties": {
        "has passed through the egg stage": true,
        "has passed through the larval stage": true,
        "has passed through the pupal stage": true,
        "is adult": true
      }
    }
  ],
  "clues": [
    {
      "property": "has passed through the egg stage",
      "value": true
    },
    {
      "property": "has passed through the larval stage",
      "value": true
    },
    {
      "property": "has passed through the pupal stage",
      "value": true
    }
