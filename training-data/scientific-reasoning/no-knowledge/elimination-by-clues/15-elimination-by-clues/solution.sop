@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "has access to food": true,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": false
      }
    },
    {
      "label": "B",
      "properties": {
        "has access to food": true,
        "has access to water": false,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    },
    {
      "label": "C",
      "properties": {
        "has access to food": false,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    },
    {
      "label": "D",
      "properties": {
        "has access to food": true,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    }
  ],
  "clues": [
    {
      "property": "has access to food",
      "value": true
    },
    {
      "property": "has access to water",
      "value": true
    },
    {
      "property": "is not blocked by an obstacle",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

