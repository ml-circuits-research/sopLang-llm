@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": false,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the pollution source is reduced": false,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    }
  ],
  "clues": [
    {
      "property": "the pollution source is reduced",
      "value": true
    },
    {
      "property": "water is monitored",
      "value": true
    },
    {
      "property": "the habitat is not destroyed of intervention",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

