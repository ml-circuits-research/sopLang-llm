@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "has water": true,
        "has air": true,
        "the temperature is suitable": true,
        "the shoot receives light": false
      }
    },
    {
      "label": "B",
      "properties": {
        "has water": true,
        "has air": false,
        "the temperature is suitable": true,
        "the shoot receives light": true
      }
    },
    {
      "label": "C",
      "properties": {
        "has water": false,
        "has air": true,
        "the temperature is suitable": true,
        "the shoot receives light": true
      }
    },
    {
      "label": "D",
      "properties": {
        "has water": true,
        "has air": true,
        "the temperature is suitable": true,
        "the shoot receives light": true
      }
    }
  ],
  "clues": [
    {
      "property": "has water",
      "value": true
    },
    {
      "property": "has air",
      "value": true
    },
    {
      "property": "the shoot receives light",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

