@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": false
      }
    },
    {
      "label": "B",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": false,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "C",
      "properties": {
        "air reaches the lungs": false,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "D",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    }
  ],
  "clues": [
    {
      "property": "air reaches the lungs",
      "value": true
    },
    {
      "property": "oxygen passes into the blood",
      "value": true
    },
    {
      "property": "oxygen reaches the cells",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

