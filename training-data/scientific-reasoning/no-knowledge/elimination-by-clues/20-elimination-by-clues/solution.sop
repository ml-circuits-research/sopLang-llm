@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "there is water": true,
        "there is food": true,
        "shelter is available": false,
        "temperature is tolerable": true
      }
    },
    {
      "label": "B",
      "properties": {
        "there is water": true,
        "there is food": false,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there is water": false,
        "there is food": true,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there is water": true,
        "there is food": true,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    }
  ],
  "clues": [
    {
      "property": "there is water",
      "value": true
    },
    {
      "property": "there is food",
      "value": true
    },
    {
      "property": "shelter is available",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

