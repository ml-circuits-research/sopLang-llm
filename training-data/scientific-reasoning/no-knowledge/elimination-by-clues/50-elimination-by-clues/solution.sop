@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": false,
        "provides thermal insulation": true
      }
    },
    {
      "label": "B",
      "properties": {
        "is waterproof": true,
        "is flexible": false,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "C",
      "properties": {
        "is waterproof": false,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "D",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    }
  ],
  "clues": [
    {
      "property": "is waterproof",
      "value": true
    },
    {
      "property": "is flexible",
      "value": true
    },
    {
      "property": "is transparent",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

