@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": false,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the same unit is used": false,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    }
  ],
  "clues": [
    {
      "property": "the same unit is used",
      "value": true
    },
    {
      "property": "the instrument is checked",
      "value": true
    },
    {
      "property": "the conditions are the same",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

