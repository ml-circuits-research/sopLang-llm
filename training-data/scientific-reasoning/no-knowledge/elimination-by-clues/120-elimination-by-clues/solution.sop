@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": false
      }
    },
    {
      "label": "B",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": false,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "C",
      "properties": {
        "provides enough energy": false,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "D",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    }
  ],
  "clues": [
    {
      "property": "provides enough energy",
      "value": true
    },
    {
      "property": "contains source of protein",
      "value": true
    },
    {
      "property": "the amount of sugar is below the given limit",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

