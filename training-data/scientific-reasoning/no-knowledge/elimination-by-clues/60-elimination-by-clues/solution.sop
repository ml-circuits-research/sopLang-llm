@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "is heated": true,
        "can flows": true,
        "is cooled": false,
        "is in a container closed": true
      }
    },
    {
      "label": "B",
      "properties": {
        "is heated": true,
        "can flows": false,
        "is cooled": true,
        "is in a container closed": true
      }
    },
    {
      "label": "C",
      "properties": {
        "is heated": false,
        "can flows": true,
        "is cooled": true,
        "is in a container closed": true
      }
    },
    {
      "label": "D",
      "properties": {
        "is heated": true,
        "can flows": true,
        "is cooled": true,
        "is in a container closed": true
      }
    }
  ],
  "clues": [
    {
      "property": "is heated",
      "value": true
    },
    {
      "property": "can flows",
      "value": true
    },
    {
      "property": "is cooled",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

