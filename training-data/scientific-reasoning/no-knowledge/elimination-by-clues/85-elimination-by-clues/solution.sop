@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": true,
        "the orientation produces attraction": false,
        "there is no large obstacle": true
      }
    },
    {
      "label": "B",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": false,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the object responds to the magnet": false,
        "the magnet is close enough": true,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": true,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    }
  ],
  "clues": [
    {
      "property": "the object responds to the magnet",
      "value": true
    },
    {
      "property": "the magnet is close enough",
      "value": true
    },
    {
      "property": "the orientation produces attraction",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

