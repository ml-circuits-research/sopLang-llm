@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": false,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the stimulus is detected": false,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    }
  ],
  "clues": [
    {
      "property": "the stimulus is detected",
      "value": true
    },
    {
      "property": "the signal is transmitted",
      "value": true
    },
    {
      "property": "the muscle can respond",
      "value": true
    }
  ]
