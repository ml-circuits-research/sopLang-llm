@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": false
      }
    },
    {
      "label": "B",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": false,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there are rock fragments": false,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    }
  ],
  "clues": [
    {
      "property": "there are rock fragments",
      "value": true
    },
    {
      "property": "there is a transport agent",
      "value": true
    },
    {
      "property": "sediments can accumulate in layers",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

