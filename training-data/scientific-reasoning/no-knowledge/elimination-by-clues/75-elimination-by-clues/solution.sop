@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the source vibrates": true,
        "there is a Environment between source and receptor": true,
        "the receiver works": true,
        "the path is not blocked strong": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the source vibrates": true,
        "there is a Environment between source and receptor": false,
        "the receiver works": true,
        "the path is not blocked strong": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the source vibrates": false,
        "there is a Environment between source and receptor": true,
        "the receiver works": true,
        "the path is not blocked strong": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the source vibrates": true,
        "there is a Environment between source and receptor": true,
        "the receiver works": true,
        "the path is not blocked strong": true
      }
    }
  ],
  "clues": [
    {
      "property": "the source vibrates",
      "value": true
    },
    {
      "property": "there is a Environment between source and receptor",
      "value": true
    },
    {
      "property": "the path is not blocked strong",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

