@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": false
      }
    },
    {
      "label": "B",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": false,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there is liquid water": false,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    }
  ],
  "clues": [
    {
      "property": "there is liquid water",
      "value": true
    },
    {
      "property": "receives energy for evaporation",
      "value": true
    },
    {
      "property": "the droplets can collect",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

