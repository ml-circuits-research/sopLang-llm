@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": false,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the location is on the part oriented toward Sun": false,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    }
  ],
  "clues": [
    {
      "property": "the location is on the part oriented toward Sun",
      "value": true
    },
    {
      "property": "nothing blocks the light in the model",
      "value": true
    },
    {
      "property": "the observer remains at the same place on the surface",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

