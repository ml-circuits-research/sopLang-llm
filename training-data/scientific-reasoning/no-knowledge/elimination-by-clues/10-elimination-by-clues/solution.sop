@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the soil is moist": true,
        "the stem transports water": true,
        "the leaf receives light": false,
        "the root is functional": true
      }
    },
    {
      "label": "B",
      "properties": {
        "the soil is moist": true,
        "the stem transports water": false,
        "the leaf receives light": true,
        "the root is functional": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the soil is moist": false,
        "the stem transports water": true,
        "the leaf receives light": true,
        "the root is functional": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the soil is moist": true,
        "the stem transports water": true,
        "the leaf receives light": true,
        "the root is functional": true
      }
    }
  ],
  "clues": [
    {
      "property": "the soil is moist",
      "value": true
    },
    {
      "property": "the stem transports water",
      "value": true
    },
    {
      "property": "the leaf receives light",
      "value": true
    }
  ]
