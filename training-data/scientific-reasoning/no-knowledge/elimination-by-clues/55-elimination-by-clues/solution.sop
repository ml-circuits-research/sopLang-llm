@slots literal
{
  "cases": [
    {
      "label": "iron",
      "properties": {
        "the component is attracted by a magnet": true,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "pebbles",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": true,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "sand",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "salt dissolved",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": false,
        "remains after evaporation of the water": true
      }
    }
  ],
  "clues": [
    {
      "property": "the component is attracted by a magnet",
      "value": true
    }
  ]
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
let compatible = slots.cases.slice();
for (const clue of slots.clues) {
  compatible = compatible.filter((entry) => entry.properties[clue.property] === clue.value);
}
probe(compatible.length > 0, "the clues must not contradict every case");
probe(compatible.length === 1, "the clues must leave exactly one case, not " + compatible.length);
return "Case " + compatible[0].label + ".";

