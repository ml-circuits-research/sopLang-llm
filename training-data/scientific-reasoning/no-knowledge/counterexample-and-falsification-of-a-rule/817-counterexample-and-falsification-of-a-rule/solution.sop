@slots literal
{
  "observations": [
    {
      "label": "syringe A",
      "properties": [
        "has an opening"
      ]
    },
    {
      "label": "the balloon B",
      "properties": [
        "keeps air trapped",
        "can change its volume"
      ]
    },
    {
      "label": "the container C",
      "properties": [
        "keeps air trapped",
        "has an opening"
      ]
    },
    {
      "label": "the tube D",
      "properties": [
        "can change its volume",
        "has an opening"
      ]
    },
    {
      "label": "the piston E",
      "properties": [
        "keeps air trapped",
        "can change its volume",
        "has an opening"
      ]
    }
  ],
  "subject": "can change its volume",
  "required": "has an opening"
}

@answer jsEval
const slots = $slots;
for (const observation of slots.observations) {
}
const counterexample = slots.observations.find((observation) => observation.properties.indexOf(slots.subject) !== -1 && observation.properties.indexOf(slots.required) === -1);
probe(counterexample !== undefined, "the data must contain one observation that refutes the universal claim");
return "The statement is false. Counterexample: " + counterexample.label + ".";

