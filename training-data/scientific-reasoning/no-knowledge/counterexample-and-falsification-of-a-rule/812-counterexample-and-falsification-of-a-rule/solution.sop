@slots literal
{
  "observations": [
    {
      "label": "the object A",
      "properties": [
        "has an air cavity"
      ]
    },
    {
      "label": "the object B",
      "properties": [
        "has an air cavity",
        "has a large volume"
      ]
    },
    {
      "label": "the object C",
      "properties": [
        "has a large volume"
      ]
    },
    {
      "label": "the object D",
      "properties": [
        "has a large volume",
        "has low mass for its volume"
      ]
    },
    {
      "label": "the object E",
      "properties": [
        "has an air cavity",
        "has low mass for its volume"
      ]
    }
  ],
  "subject": "has an air cavity",
  "required": "has a large volume"
}

@answer jsEval
const slots = $slots;
for (const observation of slots.observations) {
}
const counterexample = slots.observations.find((observation) => observation.properties.indexOf(slots.subject) !== -1 && observation.properties.indexOf(slots.required) === -1);
probe(counterexample !== undefined, "the data must contain one observation that refutes the universal claim");
return "The statement is false. Counterexample: " + counterexample.label + ".";

