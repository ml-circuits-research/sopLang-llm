@slots literal
{
  "observations": [
    {
      "label": "the sample A",
      "properties": [
        "has microorganisms in the model"
      ]
    },
    {
      "label": "the sample B",
      "properties": [
        "has large particles",
        "has fine particles"
      ]
    },
    {
      "label": "the sample C",
      "properties": [
        "has large particles",
        "has microorganisms in the model"
      ]
    },
    {
      "label": "the sample D",
      "properties": [
        "has fine particles",
        "has microorganisms in the model"
      ]
    },
    {
      "label": "the sample E",
      "properties": [
        "has large particles",
        "has fine particles",
        "has microorganisms in the model"
      ]
    }
  ],
  "subject": "has microorganisms in the model",
  "required": "has fine particles"
}

@answer jsEval
const slots = $slots;
for (const observation of slots.observations) {
}
const counterexample = slots.observations.find((observation) => observation.properties.indexOf(slots.subject) !== -1 && observation.properties.indexOf(slots.required) === -1);
probe(counterexample !== undefined, "the data must contain one observation that refutes the universal claim");
return "The statement is false. Counterexample: " + counterexample.label + ".";

