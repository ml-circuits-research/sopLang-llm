@slots literal
{
  "observations": [
    {
      "label": "the seed with wing A",
      "properties": [
        "is light in weight",
        "can float"
      ]
    },
    {
      "label": "the fruit with hooks B",
      "properties": [
        "can cling"
      ]
    },
    {
      "label": "the fruit floating C",
      "properties": [
        "is light in weight",
        "can cling"
      ]
    },
    {
      "label": "the acorn D",
      "properties": [
        "can cling",
        "can float"
      ]
    },
    {
      "label": "the seed fluffy E",
      "properties": [
        "is light in weight",
        "can cling",
        "can float"
      ]
    }
  ],
  "subject": "can cling",
  "required": "can float"
}

@answer jsEval
const slots = $slots;
for (const observation of slots.observations) {
}
const counterexample = slots.observations.find((observation) => observation.properties.indexOf(slots.subject) !== -1 && observation.properties.indexOf(slots.required) === -1);
probe(counterexample !== undefined, "the data must contain one observation that refutes the universal claim");
return "The statement is false. Counterexample: " + counterexample.label + ".";

