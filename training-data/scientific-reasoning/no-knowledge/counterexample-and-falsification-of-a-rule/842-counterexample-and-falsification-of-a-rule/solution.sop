@slots literal
{
  "observations": [
    {
      "label": "the battery A",
      "properties": [
        "produces motion"
      ]
    },
    {
      "label": "the bulb B",
      "properties": [
        "stores energy",
        "produces light"
      ]
    },
    {
      "label": "the motor C",
      "properties": [
        "stores energy",
        "produces motion"
      ]
    },
    {
      "label": "the wire D",
      "properties": [
        "produces light",
        "produces motion"
      ]
    },
    {
      "label": "the resistor E",
      "properties": [
        "stores energy",
        "produces light",
        "produces motion"
      ]
    }
  ],
  "subject": "stores energy",
  "required": "produces light"
}

@answer jsEval
const slots = $slots;
for (const observation of slots.observations) {
}
const counterexample = slots.observations.find((observation) => observation.properties.indexOf(slots.subject) !== -1 && observation.properties.indexOf(slots.required) === -1);
probe(counterexample !== undefined, "the data must contain one observation that refutes the universal claim");
return "The statement is false. Counterexample: " + counterexample.label + ".";

