@slots literal
{
  "label": "D",
  "properties": {
    "the location is on the part oriented toward Sun": true,
    "nothing blocks the light in the model": true,
    "Earth rotates": true,
    "the observer remains at the same place on the surface": true
  },
  "required": [
    "Earth rotates",
    "the location is on the part oriented toward Sun",
    "nothing blocks the light in the model",
    "the observer remains at the same place on the surface"
  ],
  "stages": [
    "the location is in zone illuminated",
    "Earth rotates",
    "the location reaches toward the edge of the zone illuminated",
    "the location enters zone of night"
  ]
}

@answer jsEval
const slots = $slots;
const links = 3;
const missing = slots.required.filter((property) => !(property in slots.properties));
const reached = slots.stages[links];
const predecessor = slots.stages[slots.stages.length - 2];
probe(predecessor !== reached, "the predecessor of the final stage must differ from the reached stage");
const reach = reached.toLowerCase() === "we evaporate the water" ? "after three links we reach at “" + reached + "”" : "after three links we reach “" + reached + "”";
return "(1) Yes, case " + slots.label + "; (2) " + reach + "; (3) immediately before it is “" + predecessor + "”.";

