@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": false,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the stimulus is detected": false,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    }
  ],
  "required": [
    "the information is interpreted",
    "the muscle can respond",
    "the signal is transmitted",
    "the stimulus is detected"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

