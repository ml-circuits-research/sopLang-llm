@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": false,
        "provides thermal insulation": true
      }
    },
    {
      "label": "B",
      "properties": {
        "is waterproof": true,
        "is flexible": false,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "C",
      "properties": {
        "is waterproof": false,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "D",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    }
  ],
  "required": [
    "is flexible",
    "is waterproof",
    "is transparent",
    "provides thermal insulation"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

