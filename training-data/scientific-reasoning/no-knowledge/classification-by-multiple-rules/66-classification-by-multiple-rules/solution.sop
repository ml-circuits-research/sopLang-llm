@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": false,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the source is switched on": false,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    }
  ],
  "required": [
    "the screen is behind the object",
    "nothing blocks the source before the object",
    "the object is opaque",
    "the source is switched on"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

