@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": false,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the battery is connected": false,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    }
  ],
  "required": [
    "the battery is connected",
    "the bulb is connected",
    "the wires form a path continuous",
    "the switch is closed"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

