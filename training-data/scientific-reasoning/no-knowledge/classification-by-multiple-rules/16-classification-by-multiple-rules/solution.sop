@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "there is water": true,
        "there is food": true,
        "shelter is available": false,
        "temperature is tolerable": true
      }
    },
    {
      "label": "B",
      "properties": {
        "there is water": true,
        "there is food": false,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there is water": false,
        "there is food": true,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there is water": true,
        "there is food": true,
        "shelter is available": true,
        "temperature is tolerable": true
      }
    }
  ],
  "required": [
    "shelter is available",
    "there is water",
    "there is food",
    "temperature is tolerable"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

