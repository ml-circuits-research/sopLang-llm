@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "has passed through the egg stage": true,
        "has passed through the larval stage": true,
        "has passed through the pupal stage": false,
        "is adult": true
      }
    },
    {
      "label": "B",
      "properties": {
        "has passed through the egg stage": true,
        "has passed through the larval stage": false,
        "has passed through the pupal stage": true,
        "is adult": false
      }
    },
    {
      "label": "C",
      "properties": {
        "has passed through the egg stage": false,
        "has passed through the larval stage": true,
        "has passed through the pupal stage": true,
        "is adult": true
      }
    },
    {
      "label": "D",
      "properties": {
        "has passed through the egg stage": true,
        "has passed through the larval stage": true,
        "has passed through the pupal stage": true,
        "is adult": true
      }
    }
  ],
  "required": [
    "has passed through the larval stage",
    "has passed through the pupal stage",
    "has passed through the egg stage",
    "is adult"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

