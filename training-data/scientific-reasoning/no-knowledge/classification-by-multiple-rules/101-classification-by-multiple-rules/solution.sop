@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": false,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the location is on the part oriented toward Sun": false,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    }
  ],
  "required": [
    "Earth rotates",
    "the location is on the part oriented toward Sun",
    "nothing blocks the light in the model",
    "the observer remains at the same place on the surface"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

