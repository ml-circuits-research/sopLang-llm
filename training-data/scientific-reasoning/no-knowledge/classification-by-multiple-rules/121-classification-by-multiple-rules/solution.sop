@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": false,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the same unit is used": false,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the same unit is used": true,
        "the instrument is checked": true,
        "the measurement is repeated": true,
        "the conditions are the same": true
      }
    }
  ],
  "required": [
    "the conditions are the same",
    "the instrument is checked",
    "the measurement is repeated",
    "the same unit is used"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

