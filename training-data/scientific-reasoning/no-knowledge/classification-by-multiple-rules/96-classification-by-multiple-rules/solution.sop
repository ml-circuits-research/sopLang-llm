@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": false
      }
    },
    {
      "label": "B",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": false,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there is liquid water": false,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there is liquid water": true,
        "receives energy for evaporation": true,
        "the vapor reaches a colder zone": true,
        "the droplets can collect": true
      }
    }
  ],
  "required": [
    "there is liquid water",
    "the droplets can collect",
    "receives energy for evaporation",
    "the vapor reaches a colder zone"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

