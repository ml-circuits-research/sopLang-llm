@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "food is chewed": true,
        "reaches the stomach": true,
        "reaches the small intestine": false,
        "the nutrients can be absorbed": true
      }
    },
    {
      "label": "B",
      "properties": {
        "food is chewed": true,
        "reaches the stomach": false,
        "reaches the small intestine": true,
        "the nutrients can be absorbed": true
      }
    },
    {
      "label": "C",
      "properties": {
        "food is chewed": false,
        "reaches the stomach": true,
        "reaches the small intestine": true,
        "the nutrients can be absorbed": true
      }
    },
    {
      "label": "D",
      "properties": {
        "food is chewed": true,
        "reaches the stomach": true,
        "reaches the small intestine": true,
        "the nutrients can be absorbed": true
      }
    }
  ],
  "required": [
    "reaches the small intestine",
    "reaches the stomach",
    "food is chewed",
    "the nutrients can be absorbed"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

