@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": true,
        "the orientation produces attraction": false,
        "there is no large obstacle": true
      }
    },
    {
      "label": "B",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": false,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the object responds to the magnet": false,
        "the magnet is close enough": true,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the object responds to the magnet": true,
        "the magnet is close enough": true,
        "the orientation produces attraction": true,
        "there is no large obstacle": true
      }
    }
  ],
  "required": [
    "the magnet is close enough",
    "there is no large obstacle",
    "the object responds to the magnet",
    "the orientation produces attraction"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

