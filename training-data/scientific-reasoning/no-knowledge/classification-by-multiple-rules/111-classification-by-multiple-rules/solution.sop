@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": false,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the pollution source is reduced": false,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the pollution source is reduced": true,
        "water is monitored": true,
        "waste are collected": true,
        "the habitat is not destroyed of intervention": true
      }
    }
  ],
  "required": [
    "water is monitored",
    "waste are collected",
    "the habitat is not destroyed of intervention",
    "the pollution source is reduced"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

