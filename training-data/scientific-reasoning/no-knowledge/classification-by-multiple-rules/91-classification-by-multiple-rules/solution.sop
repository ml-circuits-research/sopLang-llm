@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "the same amount of soil": true,
        "the same amount of water": true,
        "the same time of drainage": true,
        "the same container": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the same amount of soil": true,
        "the same amount of water": false,
        "the same time of drainage": true,
        "the same container": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the same amount of soil": false,
        "the same amount of water": true,
        "the same time of drainage": true,
        "the same container": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the same amount of soil": true,
        "the same amount of water": true,
        "the same time of drainage": true,
        "the same container": true
      }
    }
  ],
  "required": [
    "the same amount of water",
    "the same amount of soil",
    "the same container",
    "the same time of drainage"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

