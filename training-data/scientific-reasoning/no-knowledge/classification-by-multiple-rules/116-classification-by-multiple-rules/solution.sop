@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": false
      }
    },
    {
      "label": "B",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": false,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "C",
      "properties": {
        "provides enough energy": false,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "D",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    }
  ],
  "required": [
    "the amount of sugar is below the given limit",
    "contains fiber",
    "contains source of protein",
    "provides enough energy"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

