@slots literal
{
  "cases": [
    {
      "label": "A",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": false
      }
    },
    {
      "label": "B",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": false,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "C",
      "properties": {
        "air reaches the lungs": false,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "D",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    }
  ],
  "required": [
    "air reaches the lungs",
    "oxygen reaches the cells",
    "oxygen passes into the blood",
    "the blood circulates"
  ],
  "forbidden": []
}

@answer jsEval
const slots = $slots;
for (const entry of slots.cases) {
}
const matching = slots.cases.filter((entry) => slots.required.every((property) => entry.properties[property] === true) && slots.forbidden.every((property) => entry.properties[property] === false));
probe(matching.length > 0, "at least one case must satisfy the competition rule");
probe(matching.length === 1, "the competition rule must leave exactly one case, not " + matching.length);
return "Case " + matching[0].label + ".";

