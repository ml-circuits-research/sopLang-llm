@slots literal
{
  "rules": [
    {
      "from": "the pollutant enters the stream",
      "to": "the water carries it downstream"
    },
    {
      "from": "the water carries it downstream",
      "to": "downstream organisms have been exposed"
    },
    {
      "from": "downstream organisms have been exposed",
      "to": "effects may appear farther from the source"
    }
  ],
  "known": "the pollutant enters the stream"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

