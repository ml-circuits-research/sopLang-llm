@slots literal
{
  "rules": [
    {
      "from": "the warm body is placed in a cooler environment",
      "to": "heat begins to transfer"
    },
    {
      "from": "heat begins to transfer",
      "to": "insulation slows the transfer"
    },
    {
      "from": "insulation slows the transfer",
      "to": "temperature falls more slowly"
    }
  ],
  "known": "the warm body is placed in a cooler environment"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

