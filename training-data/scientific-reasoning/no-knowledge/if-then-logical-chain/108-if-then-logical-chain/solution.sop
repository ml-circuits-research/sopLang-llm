@slots literal
{
  "rules": [
    {
      "from": "the rock breaks into fragments",
      "to": "the fragments have been transported"
    },
    {
      "from": "the fragments have been transported",
      "to": "the fragments have been deposited"
    },
    {
      "from": "the fragments have been deposited",
      "to": "forms layers of sediment"
    }
  ],
  "known": "the rock breaks into fragments"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

