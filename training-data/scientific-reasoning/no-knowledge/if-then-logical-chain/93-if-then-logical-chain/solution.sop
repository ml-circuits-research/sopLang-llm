@slots literal
{
  "rules": [
    {
      "from": "we pour water onto the soil",
      "to": "water enters the spaces between particles"
    },
    {
      "from": "water enters the spaces between particles",
      "to": "a part is retained"
    },
    {
      "from": "a part is retained",
      "to": "the remainder drains away"
    }
  ],
  "known": "we pour water onto the soil"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

