@slots literal
{
  "rules": [
    {
      "from": "the mouth breaks up food",
      "to": "food reaches the stomach"
    },
    {
      "from": "food reaches the stomach",
      "to": "reaches the small intestine"
    },
    {
      "from": "reaches the small intestine",
      "to": "nutrients pass into the blood"
    }
  ],
  "known": "the mouth breaks up food"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

