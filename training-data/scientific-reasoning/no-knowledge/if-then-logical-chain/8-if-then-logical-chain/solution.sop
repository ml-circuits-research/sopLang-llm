@slots literal
{
  "rules": [
    {
      "from": "water enters the root",
      "to": "water moves up through the stem"
    },
    {
      "from": "water moves up through the stem",
      "to": "water reaches the leaf"
    },
    {
      "from": "water reaches the leaf",
      "to": "the leaf uses water and light"
    }
  ],
  "known": "water enters the root"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

