@slots literal
{
  "rules": [
    {
      "from": "we choose the food",
      "to": "the food is digested"
    },
    {
      "from": "the food is digested",
      "to": "nutrients have been absorbed"
    },
    {
      "from": "nutrients have been absorbed",
      "to": "the body can use them"
    }
  ],
  "known": "we choose the food"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

