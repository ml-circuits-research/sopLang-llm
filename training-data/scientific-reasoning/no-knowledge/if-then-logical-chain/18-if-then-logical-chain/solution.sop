@slots literal
{
  "rules": [
    {
      "from": "the animal finds shelter",
      "to": "avoids the hours very hot"
    },
    {
      "from": "avoids the hours very hot",
      "to": "finds water"
    },
    {
      "from": "finds water",
      "to": "goes out to look for food"
    }
  ],
  "known": "the animal finds shelter"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

