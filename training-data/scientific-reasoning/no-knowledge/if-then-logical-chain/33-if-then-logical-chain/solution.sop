@slots literal
{
  "rules": [
    {
      "from": "air enters the lungs",
      "to": "oxygen passes into the blood"
    },
    {
      "from": "oxygen passes into the blood",
      "to": "the blood transports oxygen"
    },
    {
      "from": "the blood transports oxygen",
      "to": "oxygen reaches the cells"
    }
  ],
  "known": "air enters the lungs"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

