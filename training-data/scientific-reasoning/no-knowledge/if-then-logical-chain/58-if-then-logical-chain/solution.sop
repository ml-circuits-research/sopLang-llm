@slots literal
{
  "rules": [
    {
      "from": "the ice receives heat",
      "to": "the ice melts"
    },
    {
      "from": "the ice melts",
      "to": "liquid water receives more heat"
    },
    {
      "from": "liquid water receives more heat",
      "to": "part turns into vapor"
    }
  ],
  "known": "the ice receives heat"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

