@slots literal
{
  "rules": [
    {
      "from": "we bring closer the magnet",
      "to": "the object enters the action zone"
    },
    {
      "from": "the object enters the action zone",
      "to": "attraction occurs"
    },
    {
      "from": "attraction occurs",
      "to": "the object moves toward the magnet"
    }
  ],
  "known": "we bring closer the magnet"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

