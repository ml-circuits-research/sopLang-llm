@slots literal
{
  "rules": [
    {
      "from": "we apply a push",
      "to": "the object begins to move"
    },
    {
      "from": "the object begins to move",
      "to": "friction opposes motion"
    },
    {
      "from": "friction opposes motion",
      "to": "the object slows down"
    }
  ],
  "known": "we apply a push"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

