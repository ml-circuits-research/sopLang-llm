@slots literal
{
  "rules": [
    {
      "from": "we establish the requirements",
      "to": "we test the properties"
    },
    {
      "from": "we test the properties",
      "to": "we eliminate the materials unsuitable"
    },
    {
      "from": "we eliminate the materials unsuitable",
      "to": "we choose the material which meets all the requirements"
    }
  ],
  "known": "we establish the requirements"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

