@slots literal
{
  "rules": [
    {
      "from": "the source emits light",
      "to": "light reaches the object"
    },
    {
      "from": "light reaches the object",
      "to": "the opaque object blocks part of the light"
    },
    {
      "from": "the opaque object blocks part of the light",
      "to": "a shadowed area appears on the screen"
    }
  ],
  "known": "the source emits light"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

