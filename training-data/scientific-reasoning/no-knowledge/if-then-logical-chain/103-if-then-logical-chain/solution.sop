@slots literal
{
  "rules": [
    {
      "from": "the location is in zone illuminated",
      "to": "Earth rotates"
    },
    {
      "from": "Earth rotates",
      "to": "the location reaches toward the edge of the zone illuminated"
    },
    {
      "from": "the location reaches toward the edge of the zone illuminated",
      "to": "the location enters zone of night"
    }
  ],
  "known": "the location is in zone illuminated"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

