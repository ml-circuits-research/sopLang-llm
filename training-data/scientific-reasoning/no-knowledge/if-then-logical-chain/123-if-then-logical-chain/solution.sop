@slots literal
{
  "rules": [
    {
      "from": "we define what we measure",
      "to": "we choose the instrument and unit"
    },
    {
      "from": "we choose the instrument and unit",
      "to": "we measure several times"
    },
    {
      "from": "we measure several times",
      "to": "we compare values"
    }
  ],
  "known": "we define what we measure"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

