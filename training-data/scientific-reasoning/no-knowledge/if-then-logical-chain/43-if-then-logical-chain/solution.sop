@slots literal
{
  "rules": [
    {
      "from": "microbes reach the surface",
      "to": "has transferred onto the hands"
    },
    {
      "from": "has transferred onto the hands",
      "to": "hands touch the mouth"
    },
    {
      "from": "hands touch the mouth",
      "to": "microbes can enters body"
    }
  ],
  "known": "microbes reach the surface"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

