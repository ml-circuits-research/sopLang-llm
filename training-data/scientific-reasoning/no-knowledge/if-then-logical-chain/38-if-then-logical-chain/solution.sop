@slots literal
{
  "rules": [
    {
      "from": "the receptor detects the stimulus",
      "to": "the signal starts"
    },
    {
      "from": "the signal starts",
      "to": "the signal is interpreted"
    },
    {
      "from": "the signal is interpreted",
      "to": "the muscle performs the response"
    }
  ],
  "known": "the receptor detects the stimulus"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

