@slots literal
{
  "rules": [
    {
      "from": "plants grow",
      "to": "the rabbit eats plants"
    },
    {
      "from": "the rabbit eats plants",
      "to": "the fox finds the rabbit"
    },
    {
      "from": "the fox finds the rabbit",
      "to": "energy from food reaches the fox"
    }
  ],
  "known": "plants grow"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

