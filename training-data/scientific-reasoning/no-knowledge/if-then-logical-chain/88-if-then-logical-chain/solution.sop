@slots literal
{
  "rules": [
    {
      "from": "we connect the battery",
      "to": "we close the path through the wires"
    },
    {
      "from": "we close the path through the wires",
      "to": "the path passes through the bulb"
    },
    {
      "from": "the path passes through the bulb",
      "to": "the bulb lights up"
    }
  ],
  "known": "we connect the battery"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

