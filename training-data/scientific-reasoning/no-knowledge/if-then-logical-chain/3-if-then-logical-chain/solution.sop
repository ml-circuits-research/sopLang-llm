@slots literal
{
  "rules": [
    {
      "from": "the seed absorbs water",
      "to": "the seed coat softens"
    },
    {
      "from": "the seed coat softens",
      "to": "the young root emerges"
    },
    {
      "from": "the young root emerges",
      "to": "the shoot appears"
    }
  ],
  "known": "the seed absorbs water"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

