@slots literal
{
  "rules": [
    {
      "from": "water evaporates",
      "to": "the vapor rises"
    },
    {
      "from": "the vapor rises",
      "to": "the vapor cools and condenses"
    },
    {
      "from": "the vapor cools and condenses",
      "to": "the droplets can fall and be collected"
    }
  ],
  "known": "water evaporates"
}

@answer jsEval
const slots = $slots;
const conclusion = new Map();
for (const rule of slots.rules) {
  conclusion.set(rule.from, rule.to);
}
const chain = [slots.known];
while (conclusion.has(chain[chain.length - 1])) {
  const next = conclusion.get(chain[chain.length - 1]);
  chain.push(next);
}
return "The deduced chain is: " + chain.join(" → ") + ".";

