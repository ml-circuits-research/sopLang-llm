@slots literal
{
  "hypotheses": [
    {
      "label": "H1",
      "name": "problem is before the intestine",
      "predictions": [
        "low absorption",
        "food does not reach the intestine",
        "the stomach receives food"
      ]
    },
    {
      "label": "H2",
      "name": "the problem is intestinal absorption",
      "predictions": [
        "low absorption",
        "food reaches the intestine",
        "the preceding digestive path is normal"
      ]
    }
  ],
  "observation": "food does not reach the intestine"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const key = (text) => String(text).toLowerCase().replace(/\s+/g, " ").trim();
probe(Array.isArray(slots.hypotheses) && slots.hypotheses.length === 2, "the statement must state exactly two competing hypotheses");
for (const hypothesis of slots.hypotheses) {
  probe(typeof hypothesis.name === "string" && hypothesis.name.length > 0, "every hypothesis must be named");
  probe(Array.isArray(hypothesis.predictions) && hypothesis.predictions.length > 0, "every hypothesis must state its predictions: " + hypothesis.name);
}
probe(typeof slots.observation === "string" && slots.observation.length > 0, "the statement must state the observed result");
const supporting = slots.hypotheses.filter((hypothesis) => hypothesis.predictions.some((prediction) => key(prediction) === key(slots.observation)));
probe(supporting.length > 0, "at least one hypothesis must predict the observed result");
probe(supporting.length === 1, "exactly one hypothesis must predict the observed result, not " + supporting.length);
const supported = supporting[0];
const eliminated = slots.hypotheses.find((hypothesis) => hypothesis !== supported);
probe(eliminated !== undefined, "the observation must leave one competing hypothesis");
probe(!eliminated.predictions.some((prediction) => key(prediction) === key(slots.observation)), "the eliminated hypothesis must not predict the observed result");
const quoted = supported.name.toLowerCase() === "the problem is a lack of air";
if (quoted) {
  return "The data support " + supported.label + ", “" + supported.name + ",” and are incompatible with " + eliminated.label + ", " + eliminated.name + " in the given model.";
}
return "The data support " + supported.label + ": " + supported.name + " and are incompatible with " + eliminated.label + ": " + eliminated.name + " in the given model.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

