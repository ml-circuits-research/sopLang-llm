@slots literal
{
  "hypotheses": [
    {
      "label": "problem is before the intestine",
      "predictions": [
        "low absorption",
        "food does not reach the intestine",
        "the stomach receives food"
      ]
    },
    {
      "label": "the problem is intestinal absorption",
      "predictions": [
        "low absorption",
        "food reaches the intestine",
        "the preceding digestive path is normal"
      ]
    }
  ],
  "known": "low absorption"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

