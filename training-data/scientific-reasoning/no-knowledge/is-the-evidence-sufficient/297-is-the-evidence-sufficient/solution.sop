@slots literal
{
  "hypotheses": [
    {
      "label": "the loss of heat is through material",
      "predictions": [
        "the container remains closed",
        "temperature decreases quickly",
        "a layer insulator helps"
      ]
    },
    {
      "label": "the loss is through opening",
      "predictions": [
        "temperature decreases quickly",
        "the wall type matters little",
        "closing helps"
      ]
    }
  ],
  "known": "temperature decreases quickly"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

