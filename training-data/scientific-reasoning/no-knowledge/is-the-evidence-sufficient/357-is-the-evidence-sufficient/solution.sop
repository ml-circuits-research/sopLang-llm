@slots literal
{
  "hypotheses": [
    {
      "label": "the lack of the layer comes from transport that is too strong",
      "predictions": [
        "the water is fast-flowing",
        "little deposition",
        "the sediments appear farther downstream"
      ]
    },
    {
      "label": "the lack of the layer comes from a lack of fragments",
      "predictions": [
        "the water may be slow-flowing",
        "no deposits appear in the collector",
        "no fragments are present"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

