@slots literal
{
  "hypotheses": [
    {
      "label": "the value unusual is a random error",
      "predictions": [
        "the instrument passes the check",
        "a alone measurement differs",
        "the repeated measurements groups"
      ]
    },
    {
      "label": "the instrument is misadjusted",
      "predictions": [
        "another instrument gives a different level",
        "repetition keeps deviation",
        "all the measurements are shifted"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

