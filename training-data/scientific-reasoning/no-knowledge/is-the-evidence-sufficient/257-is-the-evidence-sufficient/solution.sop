@slots literal
{
  "hypotheses": [
    {
      "label": "the soil is too dry",
      "predictions": [
        "wilted leaves",
        "dry soil",
        "watering helps"
      ]
    },
    {
      "label": "the stem does not transport water",
      "predictions": [
        "wilted leaves",
        "moist soil",
        "watering alone does not help"
      ]
    }
  ],
  "known": "wilted leaves"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

