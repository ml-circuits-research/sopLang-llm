@slots literal
{
  "hypotheses": [
    {
      "label": "the source of pollution is still active",
      "predictions": [
        "increases after discharge",
        "level large near source",
        "stopping the source reduces rapid the input new"
      ]
    },
    {
      "label": "the pollutant is in sediments old",
      "predictions": [
        "increasing does not follow discharges new",
        "level decreases slowly",
        "the source is stopped"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

