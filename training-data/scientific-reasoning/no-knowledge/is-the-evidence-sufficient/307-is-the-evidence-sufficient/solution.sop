@slots literal
{
  "hypotheses": [
    {
      "label": "the droplets come from condensation",
      "predictions": [
        "appear on the part cold a of the lid",
        "without hole above",
        "the container contains water warm"
      ]
    },
    {
      "label": "the droplets come from outside",
      "predictions": [
        "appear and when the container e empty",
        "does not depend of the vapor from container",
        "surface external is wet"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

