@slots literal
{
  "hypotheses": [
    {
      "label": "the short distance is caused by friction",
      "predictions": [
        "the same push",
        "short distance",
        "rough surface"
      ]
    },
    {
      "label": "the short distance is caused by the push",
      "predictions": [
        "short distance",
        "identical surface area",
        "weaker push"
      ]
    }
  ],
  "known": "short distance"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

