@slots literal
{
  "hypotheses": [
    {
      "label": "the lack of satiety comes from a portion with too little energy",
      "predictions": [
        "increasing the portion helps",
        "energy below target",
        "protein may be present"
      ]
    },
    {
      "label": "the lack comes from unsuitable composition",
      "predictions": [
        "energy at target",
        "the required component is missing",
        "changing the composition helps"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

