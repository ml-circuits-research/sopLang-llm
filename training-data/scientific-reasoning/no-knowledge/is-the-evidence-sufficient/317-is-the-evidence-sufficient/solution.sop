@slots literal
{
  "hypotheses": [
    {
      "label": "the shadow is missing because of the object transparent",
      "predictions": [
        "screen aligned",
        "light passes through object",
        "source lit"
      ]
    },
    {
      "label": "the shadow is missing because of the screen",
      "predictions": [
        "the screen is not behind the object",
        "opaque object",
        "source lit"
      ]
    }
  ],
  "known": "source lit"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

