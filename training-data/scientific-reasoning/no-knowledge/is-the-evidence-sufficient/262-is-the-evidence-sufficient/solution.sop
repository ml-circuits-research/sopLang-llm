@slots literal
{
  "hypotheses": [
    {
      "label": "rabbits decrease from lack of food",
      "predictions": [
        "little grass",
        "rabbits decrease",
        "the tracks of fox must not increase"
      ]
    },
    {
      "label": "rabbits decrease through predation",
      "predictions": [
        "grass sufficient",
        "rabbits decrease",
        "the tracks of fox increase"
      ]
    }
  ],
  "known": "rabbits decrease"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

