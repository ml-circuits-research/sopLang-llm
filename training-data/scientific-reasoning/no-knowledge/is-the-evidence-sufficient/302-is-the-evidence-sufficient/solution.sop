@slots literal
{
  "hypotheses": [
    {
      "label": "the the liquid is cloudy because of the sand",
      "predictions": [
        "the filter clarifies it",
        "the magnet does not change the turbidity",
        "sand on filter"
      ]
    },
    {
      "label": "the the liquid is cloudy because of the fine iron particles",
      "predictions": [
        "the filter can retain them as well",
        "the magnet reduces the particles",
        "particles magnetic"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

