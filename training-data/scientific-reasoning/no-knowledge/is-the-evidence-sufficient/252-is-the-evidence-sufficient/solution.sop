@slots literal
{
  "hypotheses": [
    {
      "label": "the problem is a lack of air",
      "predictions": [
        "the rootlet does not appear",
        "improves after ventilation",
        "humid"
      ]
    },
    {
      "label": "the problem is a temperature that is too low",
      "predictions": [
        "the rootlet does not appear",
        "improves after warming",
        "humid"
      ]
    }
  ],
  "known": "the rootlet does not appear"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

