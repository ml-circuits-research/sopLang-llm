@slots literal
{
  "hypotheses": [
    {
      "label": "transmission is through hands",
      "predictions": [
        "microbes on hands",
        "washing reduces cases",
        "surface is reached"
      ]
    },
    {
      "label": "transmission is direct through food",
      "predictions": [
        "covering of the food reduces cases",
        "the food are exposed",
        "the hands can be clean"
      ]
    }
  ],
  "known": "the general problem that both hypotheses try to explain"
}

@answer jsEval
const slots = $slots;
const discriminating = slots.hypotheses.map((hypothesis) => hypothesis.predictions.find((value) => value !== slots.known));
return "No. We need a discriminating observation, for example \u201c" + discriminating[0] + "\u201d versus \u201c" + discriminating[1] + "\u201d.";

