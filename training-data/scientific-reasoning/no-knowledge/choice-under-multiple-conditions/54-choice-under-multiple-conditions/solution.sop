@slots literal
{
  "options": [
    {
      "label": "iron",
      "properties": {
        "the component is attracted by a magnet": true,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "pebbles",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": true,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "sand",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": true,
        "remains after evaporation of the water": true
      }
    },
    {
      "label": "salt dissolved",
      "properties": {
        "the component is attracted by a magnet": false,
        "is greater than the mesh of the sieve": false,
        "does not pass through the filter": false,
        "remains after evaporation of the water": true
      }
    }
  ],
  "required": [
    "the component is attracted by a magnet",
    "does not pass through the filter",
    "remains after evaporation of the water"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

