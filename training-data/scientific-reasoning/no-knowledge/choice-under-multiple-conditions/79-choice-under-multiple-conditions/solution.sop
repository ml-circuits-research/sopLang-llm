@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "the same object is used": true,
        "the push is the same": true,
        "surface is known": true,
        "distance is measured the same": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the same object is used": true,
        "the push is the same": false,
        "surface is known": true,
        "distance is measured the same": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the same object is used": false,
        "the push is the same": true,
        "surface is known": true,
        "distance is measured the same": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the same object is used": true,
        "the push is the same": true,
        "surface is known": true,
        "distance is measured the same": true
      }
    }
  ],
  "required": [
    "distance is measured the same",
    "the same object is used",
    "surface is known",
    "the push is the same"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

