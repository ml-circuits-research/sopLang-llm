@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": false,
        "provides thermal insulation": true
      }
    },
    {
      "label": "B",
      "properties": {
        "is waterproof": true,
        "is flexible": false,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "C",
      "properties": {
        "is waterproof": false,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    },
    {
      "label": "D",
      "properties": {
        "is waterproof": true,
        "is flexible": true,
        "is transparent": true,
        "provides thermal insulation": true
      }
    }
  ],
  "required": [
    "is flexible",
    "is waterproof",
    "is transparent",
    "provides thermal insulation"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

