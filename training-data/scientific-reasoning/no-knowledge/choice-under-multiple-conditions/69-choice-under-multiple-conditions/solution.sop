@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": false,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the source is switched on": false,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the source is switched on": true,
        "the object is opaque": true,
        "the screen is behind the object": true,
        "nothing blocks the source before the object": true
      }
    }
  ],
  "required": [
    "the screen is behind the object",
    "nothing blocks the source before the object",
    "the object is opaque",
    "the source is switched on"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

