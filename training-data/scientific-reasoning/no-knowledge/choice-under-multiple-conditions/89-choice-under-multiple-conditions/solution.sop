@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": false,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the battery is connected": false,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the battery is connected": true,
        "the wires form a path continuous": true,
        "the bulb is connected": true,
        "the switch is closed": true
      }
    }
  ],
  "required": [
    "the battery is connected",
    "the bulb is connected",
    "the wires form a path continuous",
    "the switch is closed"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

