@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": false
      }
    },
    {
      "label": "B",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": false,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "C",
      "properties": {
        "provides enough energy": false,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    },
    {
      "label": "D",
      "properties": {
        "provides enough energy": true,
        "contains source of protein": true,
        "contains fiber": true,
        "the amount of sugar is below the given limit": true
      }
    }
  ],
  "required": [
    "the amount of sugar is below the given limit",
    "contains fiber",
    "contains source of protein",
    "provides enough energy"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

