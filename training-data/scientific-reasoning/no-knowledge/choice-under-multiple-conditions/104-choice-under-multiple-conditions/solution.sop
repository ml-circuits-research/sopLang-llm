@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": false,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the location is on the part oriented toward Sun": false,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the location is on the part oriented toward Sun": true,
        "nothing blocks the light in the model": true,
        "Earth rotates": true,
        "the observer remains at the same place on the surface": true
      }
    }
  ],
  "required": [
    "Earth rotates",
    "the location is on the part oriented toward Sun",
    "nothing blocks the light in the model",
    "the observer remains at the same place on the surface"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

