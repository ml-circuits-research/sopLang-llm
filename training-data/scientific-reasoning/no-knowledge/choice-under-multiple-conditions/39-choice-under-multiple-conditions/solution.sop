@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": false
      }
    },
    {
      "label": "B",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": false,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "C",
      "properties": {
        "the stimulus is detected": false,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    },
    {
      "label": "D",
      "properties": {
        "the stimulus is detected": true,
        "the signal is transmitted": true,
        "the information is interpreted": true,
        "the muscle can respond": true
      }
    }
  ],
  "required": [
    "the information is interpreted",
    "the muscle can respond",
    "the signal is transmitted",
    "the stimulus is detected"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

