@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": false
      }
    },
    {
      "label": "B",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": false,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    },
    {
      "label": "C",
      "properties": {
        "there are rock fragments": false,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    },
    {
      "label": "D",
      "properties": {
        "there are rock fragments": true,
        "there is a transport agent": true,
        "deposition occurs": true,
        "sediments can accumulate in layers": true
      }
    }
  ],
  "required": [
    "deposition occurs",
    "there are rock fragments",
    "there is a transport agent",
    "sediments can accumulate in layers"
  ]
}

@answer jsEval
const slots = $slots;
probe(Array.isArray(slots.options) && slots.options.length > 0, "the statement must list at least one option");
probe(Array.isArray(slots.required) && slots.required.length > 0, "the question must list at least one mandatory condition");
for (const option of slots.options) {
  probe(typeof option.label === "string" && option.label.length > 0, "every option must carry a label");
  probe(slots.required.every((property) => property in option.properties), "option " + option.label + " must state every mandatory condition");
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

