@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "has access to food": true,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": false
      }
    },
    {
      "label": "B",
      "properties": {
        "has access to food": true,
        "has access to water": false,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    },
    {
      "label": "C",
      "properties": {
        "has access to food": false,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    },
    {
      "label": "D",
      "properties": {
        "has access to food": true,
        "has access to water": true,
        "has shelter": true,
        "is not blocked by an obstacle": true
      }
    }
  ],
  "required": [
    "has access to water",
    "has access to food",
    "has shelter",
    "is not blocked by an obstacle"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

