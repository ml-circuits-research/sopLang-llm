@slots literal
{
  "options": [
    {
      "label": "A",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": false
      }
    },
    {
      "label": "B",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": false,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "C",
      "properties": {
        "air reaches the lungs": false,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    },
    {
      "label": "D",
      "properties": {
        "air reaches the lungs": true,
        "oxygen passes into the blood": true,
        "the blood circulates": true,
        "oxygen reaches the cells": true
      }
    }
  ],
  "required": [
    "air reaches the lungs",
    "oxygen reaches the cells",
    "oxygen passes into the blood",
    "the blood circulates"
  ]
}

@answer jsEval
const slots = $slots;
for (const option of slots.options) {
}
const failed = (option) => slots.required.find((property) => option.properties[property] !== true) ?? null;
const matching = slots.options.filter((option) => failed(option) === null);
probe(matching.length > 0, "at least one option must meet every mandatory condition");
probe(matching.length === 1, "the mandatory conditions must leave exactly one option, not " + matching.length);
return "Option " + matching[0].label + ".";

