@slots literal
{
  "result": "the room reaches a comfortable state with reduced consumption",
  "conditions": [
    {
      "letter": "A",
      "text": "heat losses have been limited"
    },
    {
      "letter": "B",
      "text": "there is sufficient light"
    },
    {
      "letter": "C",
      "text": "unnecessary devices are switched off"
    }
  ],
  "letters": [
    "A",
    "B",
    "C"
  ],
  "yesAlone": "B",
  "noAlone": "B",
  "analyzed": "B"
}

@answer jsEval
const slots = $slots;
const letters = slots.conditions.map((entry) => entry.letter).join("");
const clause = slots.analyzed === "A" ? "not sufficient on its own" : "is not alone sufficient";
return slots.analyzed + " is necessary, but " + clause + ". The set " + slots.letters.join("\u2227") + " is sufficient in the model.";

