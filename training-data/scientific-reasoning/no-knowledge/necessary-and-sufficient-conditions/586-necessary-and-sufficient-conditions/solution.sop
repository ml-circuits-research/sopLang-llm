@slots literal
{
  "result": "the teaching circuit operates safely",
  "conditions": [
    {
      "letter": "A",
      "text": "the conducting path is continuous"
    },
    {
      "letter": "B",
      "text": "the useful contacts are conductive"
    },
    {
      "letter": "C",
      "text": "the touched parts have been insulated"
    }
  ],
  "letters": [
    "A",
    "B",
    "C"
  ],
  "yesAlone": "C",
  "noAlone": "C",
  "analyzed": "C"
}

@answer jsEval
const slots = $slots;
const letters = slots.conditions.map((entry) => entry.letter).join("");
const clause = slots.analyzed === "A" ? "not sufficient on its own" : "is not alone sufficient";
return slots.analyzed + " is necessary, but " + clause + ". The set " + slots.letters.join("\u2227") + " is sufficient in the model.";

