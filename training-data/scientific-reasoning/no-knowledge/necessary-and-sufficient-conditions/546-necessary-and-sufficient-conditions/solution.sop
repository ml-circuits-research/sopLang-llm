@slots literal
{
  "result": "the load can be lifted with the available force",
  "conditions": [
    {
      "letter": "A",
      "text": "there is a fulcrum"
    },
    {
      "letter": "B",
      "text": "effort is applied on the correct side"
    },
    {
      "letter": "C",
      "text": "effort arm is large enough"
    }
  ],
  "letters": [
    "A",
    "B",
    "C"
  ],
  "yesAlone": "A",
  "noAlone": "A",
  "analyzed": "A"
}

@answer jsEval
const slots = $slots;
const letters = slots.conditions.map((entry) => entry.letter).join("");
const clause = slots.analyzed === "A" ? "not sufficient on its own" : "is not alone sufficient";
return slots.analyzed + " is necessary, but " + clause + ". The set " + slots.letters.join("\u2227") + " is sufficient in the model.";

