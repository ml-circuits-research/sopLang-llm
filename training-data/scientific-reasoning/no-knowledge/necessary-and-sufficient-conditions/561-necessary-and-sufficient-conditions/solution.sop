@slots literal
{
  "result": "the object floats",
  "conditions": [
    {
      "letter": "A",
      "text": "average density is below that of water"
    },
    {
      "letter": "B",
      "text": "the object does not take water into the air cavity"
    },
    {
      "letter": "C",
      "text": "the volume is maintained"
    }
  ],
  "letters": [
    "A",
    "B",
    "C"
  ],
  "yesAlone": "A",
  "noAlone": "A",
  "analyzed": "A"
}

@answer jsEval
const slots = $slots;
const letters = slots.conditions.map((entry) => entry.letter).join("");
const clause = slots.analyzed === "A" ? "not sufficient on its own" : "is not alone sufficient";
return slots.analyzed + " is necessary, but " + clause + ". The set " + slots.letters.join("\u2227") + " is sufficient in the model.";

