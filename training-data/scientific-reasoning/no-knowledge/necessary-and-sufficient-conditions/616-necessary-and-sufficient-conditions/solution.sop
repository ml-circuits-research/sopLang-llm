@slots literal
{
  "result": "the water meets the treatment model requirements",
  "conditions": [
    {
      "letter": "A",
      "text": "large particles have been removed"
    },
    {
      "letter": "B",
      "text": "fine particles have been filtered"
    },
    {
      "letter": "C",
      "text": "microorganisms have been reduced by the dedicated stage"
    }
  ],
  "letters": [
    "A",
    "B",
    "C"
  ],
  "yesAlone": "C",
  "noAlone": "C",
  "analyzed": "C"
}

@answer jsEval
const slots = $slots;
const letters = slots.conditions.map((entry) => entry.letter).join("");
const clause = slots.analyzed === "A" ? "not sufficient on its own" : "is not alone sufficient";
return slots.analyzed + " is necessary, but " + clause + ". The set " + slots.letters.join("\u2227") + " is sufficient in the model.";

