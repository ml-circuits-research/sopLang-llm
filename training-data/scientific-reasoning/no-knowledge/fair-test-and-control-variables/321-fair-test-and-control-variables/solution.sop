@slots literal
{
  "factor": "distance source-receptor",
  "levelA": 1,
  "levelB": 5,
  "controls": [
    "the same source",
    "the same vibration",
    "the same receptor"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

