@slots literal
{
  "factor": "degree of compaction",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same amount of soil",
    "the same water",
    "the same container"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

