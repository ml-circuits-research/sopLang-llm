@slots literal
{
  "factor": "number of breaks in the path",
  "levelA": 0,
  "levelB": 2,
  "controls": [
    "the same battery",
    "the same bulb",
    "the same remaining wires"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

