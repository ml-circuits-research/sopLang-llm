@slots literal
{
  "factor": "sieve mesh size",
  "levelA": 1,
  "levelB": 4,
  "controls": [
    "the same mixture",
    "the same quantity",
    "the same time of sieving"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

