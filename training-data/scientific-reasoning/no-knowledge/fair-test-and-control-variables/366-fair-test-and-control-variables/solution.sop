@slots literal
{
  "factor": "the number of components balanced from mass",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same quantity total",
    "the same interval",
    "the same criteria of evaluation"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

