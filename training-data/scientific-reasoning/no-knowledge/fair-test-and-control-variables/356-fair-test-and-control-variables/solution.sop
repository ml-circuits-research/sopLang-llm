@slots literal
{
  "factor": "water speed in the model",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same quantity of fragments",
    "the same channel",
    "the same time"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

