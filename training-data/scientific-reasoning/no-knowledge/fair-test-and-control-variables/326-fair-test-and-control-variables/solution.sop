@slots literal
{
  "factor": "rough surfaceness",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same object",
    "the same push",
    "the same method of measurement"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

