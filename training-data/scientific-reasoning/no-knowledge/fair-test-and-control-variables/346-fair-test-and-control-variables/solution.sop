@slots literal
{
  "factor": "energy received by the water surface",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same amount of water",
    "the same surface",
    "the same time"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

