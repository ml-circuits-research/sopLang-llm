@slots literal
{
  "factor": "amount of water received per day",
  "levelA": 10,
  "levelB": 50,
  "controls": [
    "the same species",
    "the same light",
    "the same temperature"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

