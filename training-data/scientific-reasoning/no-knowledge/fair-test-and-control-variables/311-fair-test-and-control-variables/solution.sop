@slots literal
{
  "factor": "insulation thickness",
  "levelA": 0,
  "levelB": 2,
  "controls": [
    "the same temperature initial",
    "the same container",
    "the same time"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

