@slots literal
{
  "factor": "number of breaths per minute in the model exercise",
  "levelA": 10,
  "levelB": 30,
  "controls": [
    "the same effort",
    "the same person-model",
    "the same interval"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

