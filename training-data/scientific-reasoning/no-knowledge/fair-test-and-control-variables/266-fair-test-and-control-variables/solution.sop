@slots literal
{
  "factor": "shaded area",
  "levelA": 10,
  "levelB": 70,
  "controls": [
    "the same species",
    "the same quantity of food",
    "the same day"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

