@slots literal
{
  "factor": "intensity of the stimulus",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same receptor",
    "the same path of signal",
    "the same time"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

