@slots literal
{
  "factor": "temperature",
  "levelA": 10,
  "levelB": 28,
  "controls": [
    "the same type of seeds",
    "the same amount of water",
    "the same time of observation"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

