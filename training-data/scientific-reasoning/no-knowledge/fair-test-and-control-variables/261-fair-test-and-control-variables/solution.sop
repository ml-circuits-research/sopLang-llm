@slots literal
{
  "factor": "amount of grass available",
  "levelA": 20,
  "levelB": 80,
  "controls": [
    "the same surface",
    "the same interval",
    "the same source of water"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

