@slots literal
{
  "factor": "duration of proper washing",
  "levelA": 5,
  "levelB": 25,
  "controls": [
    "the same quantity initial of contamination",
    "the same soap",
    "the same method of measurement"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

