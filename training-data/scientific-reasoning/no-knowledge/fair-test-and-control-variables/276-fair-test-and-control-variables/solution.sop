@slots literal
{
  "factor": "degree to which the food is broken up",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same quantity of food",
    "the same time",
    "the same model digestive"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

