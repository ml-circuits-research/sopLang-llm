@slots literal
{
  "factor": "distance of the object relative to source",
  "levelA": 1,
  "levelB": 3,
  "controls": [
    "the same source",
    "the same object",
    "the same screen"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

