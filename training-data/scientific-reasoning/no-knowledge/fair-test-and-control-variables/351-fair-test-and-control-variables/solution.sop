@slots literal
{
  "factor": "model rotation angle",
  "levelA": 0,
  "levelB": 180,
  "controls": [
    "the same source",
    "the same point marked",
    "the same source position"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

