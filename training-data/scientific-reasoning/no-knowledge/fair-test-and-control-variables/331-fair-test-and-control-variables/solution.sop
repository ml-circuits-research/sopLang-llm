@slots literal
{
  "factor": "distance relative to magnet",
  "levelA": 1,
  "levelB": 5,
  "controls": [
    "the same magnet",
    "the same object",
    "the same orientation"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

