@slots literal
{
  "factor": "temperature in the interval certain",
  "levelA": 15,
  "levelB": 28,
  "controls": [
    "the same number initial of eggs",
    "the same food",
    "the same species"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

