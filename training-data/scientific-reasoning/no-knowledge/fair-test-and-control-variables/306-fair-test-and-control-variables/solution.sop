@slots literal
{
  "factor": "heating duration",
  "levelA": 1,
  "levelB": 5,
  "controls": [
    "the same amount of water",
    "the same container",
    "the same power of heating"
  ]
}

@answer jsEval
const slots = $slots;
return "We change only \u201c" + slots.factor + "\u201d and we control " + slots.controls.join(", ") + ".";

