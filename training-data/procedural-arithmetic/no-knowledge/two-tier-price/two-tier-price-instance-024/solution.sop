@slots literal
{
  "printer": "print shop",
  "unitWord": "bundles",
  "basePrice": 37,
  "threshold": 16,
  "discountedPrice": 16,
  "quantity": 20
}

@answer jsEval
const slots = $slots;
let total = 0;
for (let index = 0; index < slots.quantity; index += 1) {
  total += index < slots.threshold ? slots.basePrice : slots.discountedPrice;
}
return "The total is " + total + " units.";

