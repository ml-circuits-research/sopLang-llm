@slots literal
{
  "printer": "print shop",
  "unitWord": "bundles",
  "basePrice": 35,
  "threshold": 10,
  "discountedPrice": 32,
  "quantity": 11
}

@answer jsEval
const slots = $slots;
let total = 0;
for (let index = 0; index < slots.quantity; index += 1) {
  total += index < slots.threshold ? slots.basePrice : slots.discountedPrice;
}
return "The total is " + total + " units.";

