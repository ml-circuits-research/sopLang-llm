@slots literal
{
  "printer": "copy house",
  "unitWord": "bundles",
  "basePrice": 32,
  "threshold": 14,
  "discountedPrice": 22,
  "quantity": 32
}

@answer jsEval
const slots = $slots;
let total = 0;
for (let index = 0; index < slots.quantity; index += 1) {
  total += index < slots.threshold ? slots.basePrice : slots.discountedPrice;
}
return "The total is " + total + " units.";

