@slots literal
{
  "printer": "binder",
  "unitWord": "bundles",
  "basePrice": 16,
  "threshold": 22,
  "discountedPrice": 2,
  "quantity": 34
}

@answer jsEval
const slots = $slots;
let total = 0;
for (let index = 0; index < slots.quantity; index += 1) {
  total += index < slots.threshold ? slots.basePrice : slots.discountedPrice;
}
return "The total is " + total + " units.";

