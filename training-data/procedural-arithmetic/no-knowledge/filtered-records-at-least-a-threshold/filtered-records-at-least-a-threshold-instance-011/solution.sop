@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "threshold": 17,
  "values": [
    14,
    20,
    19,
    13,
    9,
    38,
    39,
    7,
    30,
    17,
    15
  ]
}

@answer jsEval
const slots = $slots;
const values = slots.values;
const kept = values.filter((value) => value >= slots.threshold);
let total = 0;
for (const value of kept) {
  total += value;
}
return kept.length + " records were kept, and their total is " + total + " crates.";

