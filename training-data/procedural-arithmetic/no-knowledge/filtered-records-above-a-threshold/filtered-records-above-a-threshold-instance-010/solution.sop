@slots literal
{
  "depot": "market depot",
  "unit": "crates",
  "threshold": 10,
  "values": [
    24,
    6,
    14,
    11,
    46,
    33,
    10,
    7
  ]
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(Array.isArray(slots.values) && slots.values.length > 0, "the records must be a non-empty list");
const values = slots.values;
for (const value of values) {
  probe(Number.isInteger(value) && value > 0, "every record must be a positive whole number of crates");
}
probe(Number.isInteger(slots.threshold) && slots.threshold > 0, "the threshold must be a positive whole number of crates");
const kept = values.filter((value) => value > slots.threshold);
probe(kept.length > 0, "the threshold must leave at least one record");
let total = 0;
for (const value of kept) {
  total += value;
}
return kept.length + " records were kept, and their total is " + total + " crates.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

