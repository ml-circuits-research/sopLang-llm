@slots literal
{
  "depot": "market depot",
  "unit": "parts",
  "values": [
    24,
    31,
    3,
    14,
    14
  ],
  "threshold": 8,
  "nth": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: nthLargest
const extreme1 = [...current].sort((left, right) => right - left)[slots.nth - 1];
current = extreme1;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

