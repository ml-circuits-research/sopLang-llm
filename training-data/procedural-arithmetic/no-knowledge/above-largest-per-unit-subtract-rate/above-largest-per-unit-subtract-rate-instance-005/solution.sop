@slots literal
{
  "depot": "river depot",
  "unit": "parts",
  "values": [
    11,
    10,
    14,
    29,
    11,
    15,
    26
  ],
  "threshold": 18,
  "rate": 10,
  "perUnit": 5
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: subtractRate
const adjusted3 = current - slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

