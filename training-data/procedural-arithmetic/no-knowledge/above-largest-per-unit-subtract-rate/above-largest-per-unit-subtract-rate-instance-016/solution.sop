@slots literal
{
  "depot": "harbour depot",
  "unit": "litres",
  "values": [
    24,
    6,
    37,
    10,
    37
  ],
  "threshold": 20,
  "rate": 2,
  "perUnit": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: subtractRate
const adjusted3 = current - slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

