@slots literal
{
  "holder": "Mara",
  "unit": "shipments",
  "values": [
    31,
    16,
    75,
    14,
    24
  ],
  "bonus": 17
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value > target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The largest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

