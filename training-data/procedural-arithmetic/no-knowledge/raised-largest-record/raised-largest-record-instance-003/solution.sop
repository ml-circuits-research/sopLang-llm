@slots literal
{
  "holder": "Tomas",
  "unit": "shipments",
  "values": [
    53,
    18,
    11,
    52,
    13
  ],
  "bonus": 13
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value > target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The largest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

