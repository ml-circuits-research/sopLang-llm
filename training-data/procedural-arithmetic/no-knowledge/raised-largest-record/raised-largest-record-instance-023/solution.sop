@slots literal
{
  "holder": "Luca",
  "unit": "shipments",
  "values": [
    74,
    27,
    63,
    70,
    29
  ],
  "bonus": 14
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value > target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The largest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

