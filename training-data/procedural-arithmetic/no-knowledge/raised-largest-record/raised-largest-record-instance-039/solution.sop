@slots literal
{
  "holder": "Mara",
  "unit": "shipments",
  "values": [
    12,
    50,
    15,
    70,
    45
  ],
  "bonus": 7
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value > target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The largest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

