@slots literal
{
  "holder": "Ravi",
  "unit": "shipments",
  "values": [
    68,
    17,
    69,
    37,
    31
  ],
  "bonus": 10
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value > target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The largest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

