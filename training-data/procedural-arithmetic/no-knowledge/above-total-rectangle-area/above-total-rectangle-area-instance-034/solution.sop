@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    24,
    8,
    16,
    20,
    29,
    25,
    23,
    13
  ],
  "threshold": 12,
  "width": 4
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: rectangleArea
const adjusted2 = current * slots.width;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

