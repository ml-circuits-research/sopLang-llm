@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    5,
    36,
    20,
    4,
    29
  ],
  "threshold": 8,
  "rate": 4,
  "perUnit": 4,
  "multiplier": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
// stage 4: perUnit
const scaled3 = current * slots.perUnit;
current = scaled3;
// stage 5: addRate
const adjusted4 = current + slots.rate;
current = adjusted4;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

