@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    23,
    22,
    37,
    26,
    6,
    40
  ],
  "threshold": 14,
  "rate": 8,
  "perUnit": 3,
  "multiplier": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
// stage 4: perUnit
const scaled3 = current * slots.perUnit;
current = scaled3;
// stage 5: addRate
const adjusted4 = current + slots.rate;
current = adjusted4;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

