@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    12,
    32,
    17,
    28,
    4,
    38
  ],
  "threshold": 27,
  "rate": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: subtractRate
const adjusted2 = current - slots.rate;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

