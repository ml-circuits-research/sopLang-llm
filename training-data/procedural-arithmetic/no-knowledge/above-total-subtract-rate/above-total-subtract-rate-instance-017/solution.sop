@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    23,
    15,
    19,
    4,
    15,
    33,
    14,
    27
  ],
  "threshold": 9,
  "rate": 6
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepAbove
const kept0 = values.filter((value) => value > slots.threshold);
probe(kept0.length > 0 && kept0.length < values.length, "the filter must keep some records and drop some");
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: subtractRate
const adjusted2 = current - slots.rate;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

