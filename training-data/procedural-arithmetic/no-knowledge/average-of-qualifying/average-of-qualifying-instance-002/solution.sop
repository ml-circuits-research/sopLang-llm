@slots literal
{
  "scores": [
    4,
    58,
    47,
    17,
    34,
    13,
    53
  ],
  "minimum": 10
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

