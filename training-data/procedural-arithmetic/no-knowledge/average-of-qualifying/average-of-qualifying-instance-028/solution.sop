@slots literal
{
  "scores": [
    19,
    16,
    46,
    42,
    17,
    6,
    53
  ],
  "minimum": 24
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

