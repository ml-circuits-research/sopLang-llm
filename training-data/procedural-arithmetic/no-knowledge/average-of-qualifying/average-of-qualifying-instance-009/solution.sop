@slots literal
{
  "scores": [
    21,
    14,
    23,
    44,
    53,
    35,
    5,
    32
  ],
  "minimum": 24
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

