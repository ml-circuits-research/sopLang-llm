@slots literal
{
  "scores": [
    42,
    38,
    37,
    52,
    7,
    58,
    37,
    10
  ],
  "minimum": 15
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

