@slots literal
{
  "scores": [
    57,
    19,
    34,
    14,
    56,
    6,
    19,
    29
  ],
  "minimum": 22
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

