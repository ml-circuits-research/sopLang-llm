@slots literal
{
  "scores": [
    58,
    33,
    34,
    23,
    20,
    5,
    16,
    2
  ],
  "minimum": 22
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

