@slots literal
{
  "scores": [
    47,
    52,
    8,
    21,
    2,
    30,
    44,
    28
  ],
  "minimum": 15
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

