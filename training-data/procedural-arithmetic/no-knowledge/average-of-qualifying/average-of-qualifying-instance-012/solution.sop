@slots literal
{
  "scores": [
    17,
    29,
    8,
    49,
    50,
    31,
    51,
    48
  ],
  "minimum": 20
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

