@slots literal
{
  "scores": [
    51,
    13,
    40,
    8,
    21,
    8,
    55,
    48
  ],
  "minimum": 11
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

