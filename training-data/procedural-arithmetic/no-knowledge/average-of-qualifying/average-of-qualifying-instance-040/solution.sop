@slots literal
{
  "scores": [
    50,
    26,
    15,
    27,
    33,
    49,
    19,
    19
  ],
  "minimum": 25
}

@qualifying aggregate
source: $slots.scores
op: count
predicate:
  atLeast: $slots.minimum

@summary aggregate
source: $slots.scores
op: average
predicate:
  atLeast: $slots.minimum

@answer jsEval
const slots = $slots;
return $qualifying + " scores qualify and their average is " + $summary + ".";

