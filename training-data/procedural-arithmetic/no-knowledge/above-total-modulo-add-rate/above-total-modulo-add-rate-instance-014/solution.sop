@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    31,
    8,
    34,
    23,
    17,
    15,
    9
  ],
  "threshold": 17,
  "rate": 4,
  "divisor": 5
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: modulo
const adjusted2 = current % slots.divisor;
current = adjusted2;
// stage 4: addRate
const adjusted3 = current + slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

