@slots literal
{
  "workshop": "printing workshop",
  "unit": "sheets",
  "values": [
    29,
    10,
    17,
    20
  ],
  "rate": 25
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let consumed = 0;
for (const value of values) {
  consumed += value;
}
const extra = (consumed * slots.rate) / 100;
return (consumed + extra) + " sheets must be ordered, which is " + consumed + " consumed plus " + extra + " extra.";

