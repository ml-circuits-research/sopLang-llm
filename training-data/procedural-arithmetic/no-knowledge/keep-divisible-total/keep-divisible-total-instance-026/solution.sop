@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    40,
    38,
    12,
    19,
    35,
    23
  ],
  "divisor": 4
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepDivisibleBy
const kept0 = current.filter((value) => value % slots.divisor === 0);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

