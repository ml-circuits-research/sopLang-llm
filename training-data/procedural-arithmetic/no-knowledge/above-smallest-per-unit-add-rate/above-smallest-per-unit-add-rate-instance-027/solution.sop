@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    13,
    18,
    26,
    24,
    28
  ],
  "threshold": 15,
  "rate": 10,
  "perUnit": 5
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: smallest
const extreme1 = Math.min(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: addRate
const adjusted3 = current + slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

