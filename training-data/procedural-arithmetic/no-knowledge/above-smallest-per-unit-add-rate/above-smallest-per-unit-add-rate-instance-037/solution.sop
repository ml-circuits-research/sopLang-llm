@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    20,
    12,
    28,
    7,
    18,
    32,
    14,
    3
  ],
  "threshold": 24,
  "rate": 3,
  "perUnit": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: smallest
const extreme1 = Math.min(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: addRate
const adjusted3 = current + slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

