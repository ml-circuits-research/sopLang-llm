@slots literal
{
  "word": "deliberately",
  "position": "last"
}

@answer jsEval
const slots = $slots;
const characters = [...slots.word];
const letter = slots.position === "first" ? characters[0] : characters[characters.length - 1];
probe(typeof letter === "string" && letter.length === 1, "the chosen position must hold exactly one letter");
return letter;

