@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    10,
    28,
    6,
    28,
    10,
    24,
    7,
    18
  ],
  "threshold": 8,
  "rate": 10,
  "edges": [
    [
      6,
      7
    ],
    [
      10,
      18
    ],
    [
      18,
      24
    ],
    [
      24,
      28
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@stage2 jsEval
const slots = $slots;
let current = $stage1;
const adjusted3 = current + slots.rate;
current = adjusted3;
return current;

@answer jsEval
probe(Number.isInteger($stage2) && $stage2 >= 0, "the answer must be a whole number that is not negative");
return $stage2 + " units.";

