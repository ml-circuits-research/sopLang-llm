@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    26,
    4,
    10,
    21,
    3,
    39
  ],
  "threshold": 13,
  "rate": 6,
  "edges": [
    [
      3,
      4
    ],
    [
      4,
      10
    ],
    [
      10,
      21
    ],
    [
      21,
      26
    ],
    [
      26,
      39
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@stage2 jsEval
const slots = $slots;
let current = $stage1;
const adjusted3 = current + slots.rate;
current = adjusted3;
return current;

@answer jsEval
probe(Number.isInteger($stage2) && $stage2 >= 0, "the answer must be a whole number that is not negative");
return $stage2 + " units.";

