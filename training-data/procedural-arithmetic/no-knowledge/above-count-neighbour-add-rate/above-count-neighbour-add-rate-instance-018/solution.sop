@slots literal
{
  "depot": "market depot",
  "unit": "sheets",
  "values": [
    32,
    4,
    31,
    22,
    25
  ],
  "threshold": 12,
  "rate": 8,
  "edges": [
    [
      4,
      22
    ],
    [
      22,
      25
    ],
    [
      25,
      31
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@stage2 jsEval
const slots = $slots;
let current = $stage1;
const adjusted3 = current + slots.rate;
current = adjusted3;
return current;

@answer jsEval
probe(Number.isInteger($stage2) && $stage2 >= 0, "the answer must be a whole number that is not negative");
return $stage2 + " units.";

