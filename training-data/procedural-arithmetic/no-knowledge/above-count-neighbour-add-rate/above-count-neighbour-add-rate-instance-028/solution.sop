@slots literal
{
  "depot": "market depot",
  "unit": "crates",
  "values": [
    21,
    4,
    26,
    13,
    28,
    42,
    10,
    6
  ],
  "threshold": 16,
  "rate": 3,
  "edges": [
    [
      4,
      6
    ],
    [
      6,
      10
    ],
    [
      13,
      21
    ],
    [
      21,
      26
    ],
    [
      28,
      42
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@stage2 jsEval
const slots = $slots;
let current = $stage1;
const adjusted3 = current + slots.rate;
current = adjusted3;
return current;

@answer jsEval
probe(Number.isInteger($stage2) && $stage2 >= 0, "the answer must be a whole number that is not negative");
return $stage2 + " units.";

