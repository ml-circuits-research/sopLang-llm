@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    30,
    7,
    40,
    23,
    32,
    41,
    26,
    23
  ],
  "threshold": 22,
  "rate": 6,
  "edges": [
    [
      7,
      23
    ],
    [
      26,
      30
    ],
    [
      30,
      32
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@stage2 jsEval
const slots = $slots;
let current = $stage1;
const adjusted3 = current + slots.rate;
current = adjusted3;
return current;

@answer jsEval
probe(Number.isInteger($stage2) && $stage2 >= 0, "the answer must be a whole number that is not negative");
return $stage2 + " units.";

