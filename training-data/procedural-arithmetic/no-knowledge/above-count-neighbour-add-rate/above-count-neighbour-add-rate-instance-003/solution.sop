@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    20,
    5,
    42,
    13,
    18,
    33
  ],
  "threshold": 9,
  "rate": 7,
  "edges": [
    [
      5,
      13
    ],
    [
      18,
      20
    ],
    [
      20,
      33
    ]
  ]
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: count
const count1 = current.length;
current = count1;
// stage 3: neighbourCount
const neighbours2 = slots.edges.reduce((count, edge) => count + (edge[0] === current || edge[1] === current ? 1 : 0), 0);
current = neighbours2;
// stage 4: addRate
const adjusted3 = current + slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

