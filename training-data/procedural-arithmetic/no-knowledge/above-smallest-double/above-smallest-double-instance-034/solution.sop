@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    6,
    4,
    7,
    34,
    16,
    18,
    34
  ],
  "threshold": 25,
  "multiplier": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: smallest
const extreme1 = Math.min(...current);
current = extreme1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

