@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    32,
    34,
    11,
    36,
    9,
    22,
    15,
    17
  ],
  "threshold": 20,
  "rate": 5,
  "perUnit": 2,
  "multiplier": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: double
const scaled3 = current * slots.multiplier;
current = scaled3;
// stage 5: addRate
const adjusted4 = current + slots.rate;
current = adjusted4;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

