@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    21,
    26,
    3,
    12,
    35,
    19,
    7,
    9
  ],
  "threshold": 22,
  "rate": 10,
  "perUnit": 4,
  "multiplier": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: perUnit
const scaled2 = current * slots.perUnit;
current = scaled2;
// stage 4: double
const scaled3 = current * slots.multiplier;
current = scaled3;
// stage 5: addRate
const adjusted4 = current + slots.rate;
current = adjusted4;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

