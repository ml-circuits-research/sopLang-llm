@slots literal
{
  "holder": "Tomas",
  "unit": "shipments",
  "values": [
    37,
    38,
    45,
    57,
    31
  ],
  "bonus": 11
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value < target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The smallest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

