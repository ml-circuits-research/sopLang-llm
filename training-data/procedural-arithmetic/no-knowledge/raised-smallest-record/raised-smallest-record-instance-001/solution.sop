@slots literal
{
  "holder": "Nadia",
  "unit": "shipments",
  "values": [
    22,
    23,
    66,
    48,
    61
  ],
  "bonus": 12
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value < target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The smallest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

