@slots literal
{
  "holder": "Priya",
  "unit": "shipments",
  "values": [
    73,
    31,
    33,
    39,
    21
  ],
  "bonus": 8
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let target = values[0];
for (const value of values) {
  if (value < target) {
    target = value;
  }
}
let total = 0;
for (const value of values) {
  total += value;
}
return "The smallest record becomes " + (target + slots.bonus) + " shipments, so the total is " + (total + slots.bonus) + " shipments.";

