@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    32,
    29,
    16,
    11,
    5,
    16,
    30,
    35
  ],
  "threshold": 27,
  "divisor": 5,
  "favourableDivisor": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

