@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    32,
    25,
    7,
    11,
    21,
    20,
    31
  ],
  "threshold": 13,
  "divisor": 4,
  "favourableDivisor": 5
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

