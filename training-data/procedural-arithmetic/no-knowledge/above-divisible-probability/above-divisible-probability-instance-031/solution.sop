@slots literal
{
  "depot": "river depot",
  "unit": "tickets",
  "values": [
    27,
    26,
    42,
    17,
    35,
    24,
    37,
    30
  ],
  "threshold": 23,
  "divisor": 6,
  "favourableDivisor": 5
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

