@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    28,
    32,
    10,
    3,
    19,
    39
  ],
  "threshold": 27,
  "divisor": 4,
  "favourableDivisor": 7
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

