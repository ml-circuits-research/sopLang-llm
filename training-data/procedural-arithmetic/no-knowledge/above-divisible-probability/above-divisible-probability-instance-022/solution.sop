@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    32,
    37,
    26,
    23,
    40,
    30
  ],
  "threshold": 25,
  "divisor": 5,
  "favourableDivisor": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

