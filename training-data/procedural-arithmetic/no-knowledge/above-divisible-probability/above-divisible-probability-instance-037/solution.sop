@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    36,
    39,
    20,
    8,
    17,
    30,
    15,
    19
  ],
  "threshold": 11,
  "divisor": 6,
  "favourableDivisor": 5
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

