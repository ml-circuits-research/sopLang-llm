@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    9,
    29,
    15,
    36,
    14
  ],
  "threshold": 12,
  "divisor": 3,
  "favourableDivisor": 6
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

