@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    34,
    36,
    22,
    10,
    33,
    15,
    32,
    26
  ],
  "threshold": 21,
  "divisor": 4,
  "favourableDivisor": 6
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

