@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    3,
    24,
    38,
    39,
    42
  ],
  "threshold": 20,
  "divisor": 3,
  "favourableDivisor": 4
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

