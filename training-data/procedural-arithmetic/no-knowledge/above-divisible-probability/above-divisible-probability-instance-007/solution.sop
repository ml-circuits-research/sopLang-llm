@slots literal
{
  "depot": "market depot",
  "unit": "crates",
  "values": [
    19,
    11,
    24,
    25,
    38,
    40,
    33,
    13
  ],
  "threshold": 20,
  "divisor": 4,
  "favourableDivisor": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const kept1 = current.filter((value) => value % slots.divisor === 0);
current = kept1;
return current;

@stage1 fraction
source: $stage0
divisibleBy: $slots.favourableDivisor

@answer jsEval
return $stage1 + ".";

