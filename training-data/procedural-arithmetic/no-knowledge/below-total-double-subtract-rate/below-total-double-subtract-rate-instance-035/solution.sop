@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    29,
    23,
    40,
    19,
    29,
    17
  ],
  "threshold": 22,
  "rate": 4,
  "multiplier": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
// stage 4: subtractRate
const adjusted3 = current - slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

