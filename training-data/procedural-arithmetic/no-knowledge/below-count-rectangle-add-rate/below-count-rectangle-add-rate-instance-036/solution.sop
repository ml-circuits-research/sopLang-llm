@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    24,
    9,
    3,
    18,
    30
  ],
  "threshold": 10,
  "rate": 3,
  "width": 8
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: count
const count1 = current.length;
current = count1;
// stage 3: rectangleArea
const adjusted2 = current * slots.width;
current = adjusted2;
// stage 4: addRate
const adjusted3 = current + slots.rate;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

