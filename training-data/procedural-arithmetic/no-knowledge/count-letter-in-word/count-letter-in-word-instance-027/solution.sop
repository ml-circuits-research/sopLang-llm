@slots literal
{
  "word": "refrigerator",
  "letter": "t"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.word === "string" && slots.word.length > 0, "the word must be a non-empty string");
probe(typeof slots.letter === "string" && slots.letter.length === 1, "the letter must be a single character");
const characters = [...slots.word.toLowerCase()];
const wanted = slots.letter.toLowerCase();
let occurrences = 0;
for (const character of characters) {
  if (character === wanted) {
    occurrences += 1;
  }
}
probe(occurrences >= 0 && occurrences <= characters.length, "the count must lie between zero and the word length");
return occurrences + " times.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

