@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    14,
    11,
    40,
    3,
    14,
    25,
    37
  ],
  "threshold": 14,
  "edges": [
    [
      3,
      11
    ],
    [
      11,
      14
    ],
    [
      25,
      37
    ],
    [
      37,
      40
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

