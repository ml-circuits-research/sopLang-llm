@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    6,
    26,
    6,
    26,
    14,
    29,
    16,
    22
  ],
  "threshold": 12,
  "edges": [
    [
      6,
      14
    ],
    [
      14,
      16
    ],
    [
      16,
      22
    ],
    [
      22,
      26
    ],
    [
      26,
      29
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

