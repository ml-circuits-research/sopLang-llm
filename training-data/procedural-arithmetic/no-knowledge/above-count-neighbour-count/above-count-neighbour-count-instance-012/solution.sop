@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    29,
    12,
    37,
    42,
    3,
    7
  ],
  "threshold": 21,
  "edges": [
    [
      3,
      7
    ],
    [
      7,
      12
    ],
    [
      12,
      29
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

