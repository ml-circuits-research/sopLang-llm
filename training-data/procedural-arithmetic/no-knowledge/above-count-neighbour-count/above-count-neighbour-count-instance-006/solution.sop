@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    6,
    18,
    21,
    15,
    41,
    27,
    29,
    17
  ],
  "threshold": 16,
  "edges": [
    [
      6,
      15
    ],
    [
      17,
      18
    ],
    [
      18,
      21
    ],
    [
      21,
      27
    ],
    [
      27,
      29
    ],
    [
      29,
      41
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

