@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    31,
    3,
    29,
    33,
    6,
    21,
    15,
    21
  ],
  "threshold": 25,
  "edges": [
    [
      3,
      6
    ],
    [
      15,
      21
    ],
    [
      21,
      29
    ],
    [
      31,
      33
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

