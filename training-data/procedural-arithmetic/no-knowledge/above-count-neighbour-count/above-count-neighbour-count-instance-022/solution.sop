@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    21,
    36,
    9,
    11,
    4,
    28,
    31
  ],
  "threshold": 16,
  "edges": [
    [
      4,
      9
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

