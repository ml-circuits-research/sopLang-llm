@slots literal
{
  "depot": "market depot",
  "unit": "parts",
  "values": [
    5,
    38,
    28,
    11,
    11,
    20
  ],
  "threshold": 8,
  "edges": [
    [
      5,
      11
    ],
    [
      11,
      20
    ],
    [
      28,
      38
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

