@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    14,
    13,
    37,
    40,
    19,
    22,
    42,
    4
  ],
  "threshold": 19,
  "edges": [
    [
      4,
      13
    ],
    [
      13,
      14
    ],
    [
      14,
      19
    ],
    [
      19,
      22
    ],
    [
      40,
      42
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

