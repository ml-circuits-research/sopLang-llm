@slots literal
{
  "depot": "north depot",
  "unit": "sheets",
  "values": [
    15,
    31,
    8,
    33,
    30,
    5,
    41
  ],
  "threshold": 8,
  "edges": [
    [
      5,
      8
    ],
    [
      8,
      15
    ],
    [
      30,
      31
    ],
    [
      33,
      41
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

