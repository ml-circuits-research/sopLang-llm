@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    4,
    34,
    8,
    18,
    36,
    38,
    3
  ],
  "threshold": 10,
  "edges": [
    [
      3,
      4
    ],
    [
      8,
      18
    ],
    [
      18,
      34
    ],
    [
      36,
      38
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

