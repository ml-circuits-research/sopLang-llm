@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    26,
    41,
    7,
    37,
    26,
    5,
    41,
    6
  ],
  "threshold": 9,
  "edges": [
    [
      5,
      6
    ],
    [
      6,
      7
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

