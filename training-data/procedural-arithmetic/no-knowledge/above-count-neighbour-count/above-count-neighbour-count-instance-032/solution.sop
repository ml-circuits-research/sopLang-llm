@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    40,
    11,
    37,
    16,
    17,
    5,
    27,
    3
  ],
  "threshold": 18,
  "edges": [
    [
      3,
      5
    ],
    [
      11,
      16
    ],
    [
      16,
      17
    ],
    [
      17,
      27
    ],
    [
      27,
      37
    ],
    [
      37,
      40
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

