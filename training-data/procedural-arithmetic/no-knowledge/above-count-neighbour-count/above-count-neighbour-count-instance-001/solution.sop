@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    13,
    3,
    28,
    35,
    22,
    25,
    36
  ],
  "threshold": 25,
  "edges": [
    [
      3,
      13
    ],
    [
      13,
      22
    ],
    [
      22,
      25
    ],
    [
      25,
      28
    ],
    [
      28,
      35
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

