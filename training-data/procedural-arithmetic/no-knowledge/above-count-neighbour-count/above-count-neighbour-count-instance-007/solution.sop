@slots literal
{
  "depot": "market depot",
  "unit": "sheets",
  "values": [
    32,
    3,
    30,
    4,
    6,
    38
  ],
  "threshold": 16,
  "edges": [
    [
      3,
      4
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

