@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    6,
    26,
    4,
    13,
    32,
    3,
    35,
    41
  ],
  "threshold": 15,
  "edges": [
    [
      3,
      4
    ],
    [
      4,
      6
    ],
    [
      6,
      13
    ],
    [
      13,
      26
    ],
    [
      32,
      35
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

