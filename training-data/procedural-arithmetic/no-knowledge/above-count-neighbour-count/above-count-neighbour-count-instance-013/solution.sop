@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    7,
    5,
    32,
    31,
    11,
    28,
    37
  ],
  "threshold": 10,
  "edges": [
    [
      5,
      7
    ],
    [
      7,
      11
    ],
    [
      11,
      28
    ],
    [
      32,
      37
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

