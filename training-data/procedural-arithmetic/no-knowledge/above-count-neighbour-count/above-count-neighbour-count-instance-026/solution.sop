@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    20,
    31,
    5,
    18,
    28,
    42,
    26,
    13
  ],
  "threshold": 18,
  "edges": [
    [
      5,
      13
    ],
    [
      18,
      20
    ],
    [
      20,
      26
    ],
    [
      26,
      28
    ],
    [
      28,
      31
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

