@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    16,
    33,
    6,
    3,
    29
  ],
  "threshold": 11,
  "edges": [
    [
      3,
      6
    ],
    [
      16,
      29
    ],
    [
      29,
      33
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

