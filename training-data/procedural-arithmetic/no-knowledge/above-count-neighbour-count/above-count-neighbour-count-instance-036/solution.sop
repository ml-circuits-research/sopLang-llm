@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    10,
    32,
    3,
    4,
    10,
    34,
    17,
    29
  ],
  "threshold": 16,
  "edges": [
    [
      3,
      4
    ],
    [
      4,
      10
    ],
    [
      10,
      17
    ],
    [
      32,
      34
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

