@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    39,
    41,
    4,
    8,
    5,
    14,
    12,
    24
  ],
  "threshold": 12,
  "edges": [
    [
      4,
      5
    ],
    [
      8,
      12
    ],
    [
      14,
      24
    ],
    [
      39,
      41
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

