@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    41,
    28,
    3,
    17,
    25,
    41
  ],
  "threshold": 27,
  "edges": [
    [
      3,
      17
    ],
    [
      25,
      28
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

