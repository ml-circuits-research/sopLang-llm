@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    4,
    25,
    37,
    11,
    7,
    32,
    33
  ],
  "threshold": 14,
  "edges": [
    [
      4,
      7
    ],
    [
      11,
      25
    ],
    [
      25,
      32
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

