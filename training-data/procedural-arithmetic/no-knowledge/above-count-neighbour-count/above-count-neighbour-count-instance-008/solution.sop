@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    32,
    37,
    4,
    33,
    27
  ],
  "threshold": 26,
  "edges": [
    [
      4,
      27
    ],
    [
      27,
      32
    ],
    [
      33,
      37
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

