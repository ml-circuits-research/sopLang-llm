@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    15,
    34,
    30,
    32,
    29,
    4,
    21,
    14
  ],
  "threshold": 23,
  "edges": [
    [
      4,
      14
    ],
    [
      14,
      15
    ],
    [
      15,
      21
    ],
    [
      29,
      30
    ],
    [
      30,
      32
    ],
    [
      32,
      34
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

