@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    27,
    34,
    10,
    36,
    19,
    7,
    28,
    25
  ],
  "threshold": 8,
  "edges": [
    [
      7,
      10
    ],
    [
      19,
      25
    ],
    [
      25,
      27
    ],
    [
      34,
      36
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

