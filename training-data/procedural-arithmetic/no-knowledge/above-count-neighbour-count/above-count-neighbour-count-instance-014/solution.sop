@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    17,
    8,
    3,
    26,
    20
  ],
  "threshold": 12,
  "edges": [
    [
      3,
      8
    ],
    [
      8,
      17
    ],
    [
      17,
      20
    ],
    [
      20,
      26
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

