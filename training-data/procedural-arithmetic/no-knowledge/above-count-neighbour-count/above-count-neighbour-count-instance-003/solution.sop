@slots literal
{
  "depot": "river depot",
  "unit": "tickets",
  "values": [
    36,
    13,
    8,
    42,
    6,
    11,
    27,
    3
  ],
  "threshold": 24,
  "edges": [
    [
      3,
      6
    ],
    [
      6,
      8
    ],
    [
      11,
      13
    ],
    [
      13,
      27
    ],
    [
      27,
      36
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

