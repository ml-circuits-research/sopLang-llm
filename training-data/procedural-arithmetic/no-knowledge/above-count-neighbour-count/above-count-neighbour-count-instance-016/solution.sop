@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    12,
    3,
    5,
    22,
    34,
    33,
    6,
    4
  ],
  "threshold": 12,
  "edges": [
    [
      3,
      4
    ],
    [
      5,
      6
    ],
    [
      6,
      12
    ],
    [
      22,
      33
    ],
    [
      33,
      34
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

