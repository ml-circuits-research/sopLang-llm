@slots literal
{
  "depot": "river depot",
  "unit": "tickets",
  "values": [
    16,
    39,
    31,
    30,
    4
  ],
  "threshold": 14,
  "edges": [
    [
      4,
      16
    ],
    [
      30,
      31
    ],
    [
      31,
      39
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

