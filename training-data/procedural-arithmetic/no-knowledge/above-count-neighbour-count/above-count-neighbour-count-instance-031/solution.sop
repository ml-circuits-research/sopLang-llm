@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    25,
    20,
    16,
    31,
    6,
    25,
    5,
    39
  ],
  "threshold": 12,
  "edges": [
    [
      5,
      6
    ],
    [
      16,
      20
    ],
    [
      20,
      25
    ],
    [
      25,
      31
    ],
    [
      31,
      39
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

