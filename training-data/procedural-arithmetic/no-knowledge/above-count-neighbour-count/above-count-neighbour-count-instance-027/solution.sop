@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    33,
    28,
    20,
    7,
    35,
    23,
    41,
    24
  ],
  "threshold": 13,
  "edges": [
    [
      7,
      20
    ],
    [
      20,
      23
    ],
    [
      23,
      24
    ],
    [
      28,
      33
    ],
    [
      33,
      35
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

