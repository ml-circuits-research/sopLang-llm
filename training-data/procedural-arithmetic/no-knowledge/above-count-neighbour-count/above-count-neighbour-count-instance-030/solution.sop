@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    4,
    24,
    15,
    34,
    31,
    32
  ],
  "threshold": 15,
  "edges": [
    [
      4,
      15
    ],
    [
      15,
      24
    ],
    [
      24,
      31
    ],
    [
      31,
      32
    ]
  ]
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const count1 = current.length;
current = count1;
return current;

@stage1 graphPath
from: $stage0
edges: $slots.edges
count: true

@answer jsEval
return $stage1 + " neighbours.";

