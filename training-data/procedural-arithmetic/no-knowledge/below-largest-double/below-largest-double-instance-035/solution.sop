@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    13,
    19,
    3,
    40,
    39,
    36,
    27,
    38
  ],
  "threshold": 18,
  "multiplier": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

