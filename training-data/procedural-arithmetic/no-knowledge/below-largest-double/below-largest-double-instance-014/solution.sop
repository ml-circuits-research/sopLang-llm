@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    38,
    30,
    39,
    34,
    35,
    5,
    4,
    31
  ],
  "threshold": 25,
  "multiplier": 2
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

