@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    4,
    18,
    34,
    29,
    12,
    11
  ],
  "threshold": 23,
  "multiplier": 2
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepBelow
const kept0 = values.filter((value) => value < slots.threshold);
probe(kept0.length > 0 && kept0.length < values.length, "the threshold must keep some records and drop some");
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

