@slots literal
{
  "depot": "river depot",
  "unit": "tickets",
  "values": [
    38,
    4,
    23,
    30,
    12,
    28
  ],
  "threshold": 11
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: squareArea
const adjusted2 = current * current;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

