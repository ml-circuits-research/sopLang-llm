@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    23,
    41,
    34,
    40,
    12
  ],
  "threshold": 15,
  "edges": [
    [
      23,
      34
    ],
    [
      34,
      40
    ],
    [
      40,
      41
    ]
  ],
  "target": 40
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

