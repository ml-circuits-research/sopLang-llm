@slots literal
{
  "depot": "harbour depot",
  "unit": "tickets",
  "values": [
    34,
    15,
    17,
    35,
    11
  ],
  "threshold": 17,
  "edges": [
    [
      11,
      15
    ],
    [
      17,
      34
    ],
    [
      34,
      35
    ]
  ],
  "target": 34
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

