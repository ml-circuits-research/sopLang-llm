@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    18,
    42,
    11,
    22,
    32,
    25,
    28,
    38
  ],
  "threshold": 22,
  "edges": [
    [
      11,
      18
    ],
    [
      25,
      28
    ],
    [
      32,
      38
    ],
    [
      38,
      42
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

