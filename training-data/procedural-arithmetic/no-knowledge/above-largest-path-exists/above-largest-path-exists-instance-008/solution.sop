@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    37,
    35,
    4,
    23,
    11,
    10,
    6,
    14
  ],
  "threshold": 17,
  "edges": [
    [
      6,
      10
    ],
    [
      10,
      11
    ],
    [
      11,
      14
    ],
    [
      35,
      37
    ]
  ],
  "target": 35
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

