@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    34,
    6,
    24,
    3,
    15,
    25,
    19
  ],
  "threshold": 12,
  "edges": [
    [
      3,
      6
    ],
    [
      6,
      15
    ],
    [
      15,
      19
    ],
    [
      24,
      25
    ],
    [
      25,
      34
    ]
  ],
  "target": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

