@slots literal
{
  "depot": "north depot",
  "unit": "sheets",
  "values": [
    33,
    13,
    3,
    13,
    22
  ],
  "threshold": 23,
  "edges": [
    [
      13,
      22
    ],
    [
      22,
      33
    ]
  ],
  "target": 22
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

