@slots literal
{
  "depot": "river depot",
  "unit": "parts",
  "values": [
    32,
    9,
    22,
    30,
    20,
    16
  ],
  "threshold": 9,
  "edges": [
    [
      9,
      16
    ],
    [
      16,
      20
    ],
    [
      22,
      30
    ],
    [
      30,
      32
    ]
  ],
  "target": 20
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

