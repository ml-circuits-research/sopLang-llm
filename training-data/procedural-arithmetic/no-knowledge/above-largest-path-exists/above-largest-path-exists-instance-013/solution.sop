@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    28,
    3,
    27,
    26,
    31,
    14
  ],
  "threshold": 22,
  "edges": [
    [
      14,
      26
    ],
    [
      26,
      27
    ],
    [
      28,
      31
    ]
  ],
  "target": 27
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

