@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    17,
    27,
    22,
    40,
    10,
    12,
    38
  ],
  "threshold": 25,
  "edges": [
    [
      12,
      17
    ],
    [
      22,
      27
    ],
    [
      27,
      38
    ],
    [
      38,
      40
    ]
  ],
  "target": 22
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

