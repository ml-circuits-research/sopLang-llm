@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    11,
    14,
    41,
    11,
    35,
    33,
    34,
    3
  ],
  "threshold": 15,
  "edges": [
    [
      3,
      11
    ],
    [
      11,
      14
    ],
    [
      33,
      34
    ],
    [
      35,
      41
    ]
  ],
  "target": 34
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

