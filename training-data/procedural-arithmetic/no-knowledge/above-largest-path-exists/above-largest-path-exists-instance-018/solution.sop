@slots literal
{
  "depot": "river depot",
  "unit": "litres",
  "values": [
    33,
    35,
    36,
    21,
    13
  ],
  "threshold": 18,
  "edges": [
    [
      13,
      21
    ],
    [
      33,
      35
    ],
    [
      35,
      36
    ]
  ],
  "target": 21
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

