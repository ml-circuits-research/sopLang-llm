@slots literal
{
  "depot": "river depot",
  "unit": "parts",
  "values": [
    35,
    10,
    13,
    13,
    11,
    12,
    39
  ],
  "threshold": 27,
  "edges": [
    [
      10,
      11
    ],
    [
      11,
      12
    ],
    [
      12,
      13
    ],
    [
      13,
      35
    ],
    [
      35,
      39
    ]
  ],
  "target": 12
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

