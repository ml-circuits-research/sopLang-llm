@slots literal
{
  "depot": "north depot",
  "unit": "sheets",
  "values": [
    23,
    4,
    18,
    37,
    23,
    12,
    33,
    41
  ],
  "threshold": 20,
  "edges": [
    [
      4,
      12
    ],
    [
      12,
      18
    ],
    [
      18,
      23
    ],
    [
      23,
      33
    ],
    [
      33,
      37
    ],
    [
      37,
      41
    ]
  ],
  "target": 4
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

