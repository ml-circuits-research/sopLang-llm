@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    41,
    17,
    6,
    27,
    33,
    5,
    37
  ],
  "threshold": 18,
  "edges": [
    [
      5,
      6
    ],
    [
      6,
      17
    ],
    [
      17,
      27
    ],
    [
      33,
      37
    ],
    [
      37,
      41
    ]
  ],
  "target": 33
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

