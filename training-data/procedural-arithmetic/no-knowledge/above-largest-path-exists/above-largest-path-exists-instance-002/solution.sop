@slots literal
{
  "depot": "north depot",
  "unit": "sheets",
  "values": [
    8,
    6,
    41,
    37,
    41,
    11
  ],
  "threshold": 17,
  "edges": [
    [
      6,
      8
    ],
    [
      37,
      41
    ]
  ],
  "target": 8
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

