@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    18,
    20,
    25,
    42,
    12,
    21,
    24,
    13
  ],
  "threshold": 26,
  "edges": [
    [
      13,
      18
    ],
    [
      21,
      24
    ],
    [
      24,
      25
    ],
    [
      25,
      42
    ]
  ],
  "target": 13
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

