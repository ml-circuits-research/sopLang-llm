@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    26,
    18,
    30,
    36,
    10,
    6
  ],
  "threshold": 22,
  "edges": [
    [
      6,
      10
    ],
    [
      18,
      26
    ],
    [
      26,
      30
    ],
    [
      30,
      36
    ]
  ],
  "target": 26
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

