@slots literal
{
  "depot": "harbour depot",
  "unit": "tickets",
  "values": [
    8,
    16,
    38,
    24,
    36,
    32,
    9,
    26
  ],
  "threshold": 8,
  "edges": [
    [
      8,
      9
    ],
    [
      16,
      24
    ],
    [
      26,
      32
    ],
    [
      32,
      36
    ],
    [
      36,
      38
    ]
  ],
  "target": 24
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

