@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    38,
    20,
    20,
    8,
    37,
    8,
    15
  ],
  "threshold": 22,
  "edges": [
    [
      8,
      15
    ],
    [
      15,
      20
    ],
    [
      37,
      38
    ]
  ],
  "target": 8
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

