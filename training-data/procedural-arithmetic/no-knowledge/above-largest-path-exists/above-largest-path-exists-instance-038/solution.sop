@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    30,
    40,
    4,
    9,
    15,
    36
  ],
  "threshold": 11,
  "edges": [
    [
      4,
      9
    ],
    [
      15,
      30
    ],
    [
      36,
      40
    ]
  ],
  "target": 30
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

