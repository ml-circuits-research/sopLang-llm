@slots literal
{
  "depot": "hill depot",
  "unit": "crates",
  "values": [
    6,
    10,
    19,
    31,
    26,
    5
  ],
  "threshold": 18,
  "edges": [
    [
      5,
      6
    ],
    [
      6,
      10
    ],
    [
      19,
      26
    ],
    [
      26,
      31
    ]
  ],
  "target": 6
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

