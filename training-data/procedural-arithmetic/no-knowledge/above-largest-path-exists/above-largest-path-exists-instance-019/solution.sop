@slots literal
{
  "depot": "market depot",
  "unit": "parts",
  "values": [
    20,
    22,
    3,
    30,
    17,
    6,
    20,
    17
  ],
  "threshold": 25,
  "edges": [
    [
      6,
      17
    ],
    [
      17,
      20
    ],
    [
      20,
      22
    ],
    [
      22,
      30
    ]
  ],
  "target": 22
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

