@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    25,
    4,
    37,
    36,
    17,
    41
  ],
  "threshold": 17,
  "edges": [
    [
      25,
      36
    ],
    [
      37,
      41
    ]
  ],
  "target": 25
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

