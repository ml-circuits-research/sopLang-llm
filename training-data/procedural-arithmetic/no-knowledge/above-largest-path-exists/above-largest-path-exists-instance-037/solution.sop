@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    10,
    22,
    6,
    26,
    4,
    29,
    35,
    32
  ],
  "threshold": 18,
  "edges": [
    [
      4,
      6
    ],
    [
      6,
      10
    ],
    [
      10,
      22
    ],
    [
      22,
      26
    ],
    [
      32,
      35
    ]
  ],
  "target": 32
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

