@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    23,
    22,
    28,
    11,
    17,
    8
  ],
  "threshold": 25,
  "edges": [
    [
      8,
      11
    ],
    [
      11,
      17
    ],
    [
      17,
      22
    ],
    [
      23,
      28
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

