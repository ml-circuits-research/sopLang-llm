@slots literal
{
  "depot": "harbour depot",
  "unit": "tickets",
  "values": [
    3,
    15,
    36,
    41,
    24
  ],
  "threshold": 25,
  "edges": [
    [
      3,
      15
    ],
    [
      15,
      24
    ],
    [
      36,
      41
    ]
  ],
  "target": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

