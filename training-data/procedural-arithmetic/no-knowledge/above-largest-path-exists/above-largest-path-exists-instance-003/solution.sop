@slots literal
{
  "depot": "harbour depot",
  "unit": "litres",
  "values": [
    36,
    11,
    17,
    38,
    35,
    6,
    35,
    13
  ],
  "threshold": 19,
  "edges": [
    [
      11,
      13
    ],
    [
      17,
      35
    ],
    [
      36,
      38
    ]
  ],
  "target": 35
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

