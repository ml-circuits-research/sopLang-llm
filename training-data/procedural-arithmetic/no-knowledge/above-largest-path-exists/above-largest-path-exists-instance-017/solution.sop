@slots literal
{
  "depot": "harbour depot",
  "unit": "litres",
  "values": [
    12,
    35,
    33,
    12,
    26,
    18,
    7
  ],
  "threshold": 22,
  "edges": [
    [
      7,
      12
    ],
    [
      12,
      18
    ],
    [
      18,
      26
    ],
    [
      26,
      33
    ],
    [
      33,
      35
    ]
  ],
  "target": 26
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

