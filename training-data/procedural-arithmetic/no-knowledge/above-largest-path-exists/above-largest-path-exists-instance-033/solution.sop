@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    11,
    23,
    39,
    7,
    37,
    20,
    25
  ],
  "threshold": 15,
  "edges": [
    [
      7,
      11
    ],
    [
      11,
      20
    ],
    [
      25,
      37
    ],
    [
      37,
      39
    ]
  ],
  "target": 25
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

