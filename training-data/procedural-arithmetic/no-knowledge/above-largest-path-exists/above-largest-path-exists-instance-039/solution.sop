@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    14,
    25,
    5,
    4,
    13,
    8,
    9
  ],
  "threshold": 24,
  "edges": [
    [
      4,
      5
    ],
    [
      8,
      9
    ],
    [
      9,
      13
    ],
    [
      13,
      14
    ],
    [
      14,
      25
    ]
  ],
  "target": 9
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

