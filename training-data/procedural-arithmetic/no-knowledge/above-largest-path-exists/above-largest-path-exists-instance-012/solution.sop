@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    12,
    36,
    20,
    19,
    24,
    3
  ],
  "threshold": 8,
  "edges": [
    [
      12,
      19
    ],
    [
      19,
      20
    ],
    [
      24,
      36
    ]
  ],
  "target": 20
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

