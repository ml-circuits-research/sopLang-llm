@slots literal
{
  "depot": "river depot",
  "unit": "parts",
  "values": [
    20,
    12,
    9,
    6,
    37,
    17,
    22,
    32
  ],
  "threshold": 13,
  "edges": [
    [
      6,
      9
    ],
    [
      17,
      20
    ],
    [
      20,
      22
    ],
    [
      22,
      32
    ],
    [
      32,
      37
    ]
  ],
  "target": 20
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

