@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    40,
    16,
    37,
    23,
    14,
    20,
    37,
    7
  ],
  "threshold": 20,
  "edges": [
    [
      14,
      16
    ],
    [
      16,
      20
    ],
    [
      20,
      23
    ],
    [
      37,
      40
    ]
  ],
  "target": 16
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

