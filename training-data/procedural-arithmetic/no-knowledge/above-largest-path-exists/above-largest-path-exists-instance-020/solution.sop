@slots literal
{
  "depot": "north depot",
  "unit": "litres",
  "values": [
    26,
    10,
    22,
    37,
    38,
    42,
    36,
    16
  ],
  "threshold": 17,
  "edges": [
    [
      16,
      22
    ],
    [
      22,
      26
    ],
    [
      36,
      37
    ],
    [
      37,
      38
    ],
    [
      38,
      42
    ]
  ],
  "target": 37
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

