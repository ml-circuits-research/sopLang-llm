@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    12,
    22,
    15,
    27,
    30
  ],
  "threshold": 25,
  "edges": [
    [
      12,
      15
    ],
    [
      15,
      22
    ],
    [
      27,
      30
    ]
  ],
  "target": 27
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

