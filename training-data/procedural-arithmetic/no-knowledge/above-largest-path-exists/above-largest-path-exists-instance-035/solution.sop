@slots literal
{
  "depot": "hill depot",
  "unit": "litres",
  "values": [
    26,
    16,
    12,
    22,
    9,
    3,
    18
  ],
  "threshold": 15,
  "edges": [
    [
      3,
      9
    ],
    [
      9,
      12
    ],
    [
      16,
      18
    ],
    [
      22,
      26
    ]
  ],
  "target": 18
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

