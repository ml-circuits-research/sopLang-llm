@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    42,
    27,
    29,
    4,
    13
  ],
  "threshold": 17,
  "edges": [
    [
      4,
      13
    ],
    [
      13,
      27
    ],
    [
      29,
      42
    ]
  ],
  "target": 29
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

