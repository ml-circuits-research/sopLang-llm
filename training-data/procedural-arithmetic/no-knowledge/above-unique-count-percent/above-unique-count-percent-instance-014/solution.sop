@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    20,
    34,
    36,
    28,
    41,
    34,
    39
  ],
  "threshold": 21,
  "pct": 80
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: uniqueCount
const count1 = new Set(current).size;
current = count1;
// stage 3: percentOf
const adjusted2 = (current * slots.pct) / 100;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

