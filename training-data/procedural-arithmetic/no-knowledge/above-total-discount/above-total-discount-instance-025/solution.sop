@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    20,
    7,
    32,
    9,
    8,
    15,
    39,
    32
  ],
  "threshold": 11,
  "pct": 50
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: discount
const adjusted2 = current - (current * slots.pct) / 100;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

