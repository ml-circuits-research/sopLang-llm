@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    3,
    37,
    21,
    6,
    17,
    20,
    23,
    29
  ],
  "threshold": 19,
  "rate": 7
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepBelow
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
// stage 2: largest
const extreme1 = Math.max(...current);
current = extreme1;
// stage 3: addRate
const adjusted2 = current + slots.rate;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

