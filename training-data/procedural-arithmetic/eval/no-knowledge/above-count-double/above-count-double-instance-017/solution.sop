@slots literal
{
  "depot": "river depot",
  "unit": "parts",
  "values": [
    9,
    31,
    42,
    31,
    25,
    36,
    17
  ],
  "threshold": 17,
  "multiplier": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: count
const count1 = current.length;
current = count1;
// stage 3: double
const scaled2 = current * slots.multiplier;
current = scaled2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

