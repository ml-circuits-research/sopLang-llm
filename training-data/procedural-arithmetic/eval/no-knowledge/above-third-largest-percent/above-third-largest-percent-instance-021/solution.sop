@slots literal
{
  "depot": "market depot",
  "unit": "tickets",
  "values": [
    32,
    16,
    12,
    39,
    5,
    24,
    41
  ],
  "threshold": 21,
  "pct": 50,
  "nth": 3
}

@answer jsEval
const slots = $slots;
const values = slots.values;
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: nthLargest
const extreme1 = [...current].sort((left, right) => right - left)[slots.nth - 1];
current = extreme1;
// stage 3: percentOf
const adjusted2 = (current * slots.pct) / 100;
current = adjusted2;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

