@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    11,
    30,
    32,
    38,
    5,
    16
  ],
  "threshold": 20,
  "pct": 30
}

@answer jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
// stage 1: keepAbove
const kept0 = current.filter((value) => value > slots.threshold);
current = kept0;
// stage 2: total
const total1 = current.reduce((sum, value) => sum + value, 0);
current = total1;
// stage 3: percentOf
const adjusted2 = (current * slots.pct) / 100;
current = adjusted2;
// stage 4: discount
const adjusted3 = current - (current * slots.pct) / 100;
current = adjusted3;
probe(Number.isInteger(current) && current >= 0, "the answer must be a whole number that is not negative");
return current + " units.";

