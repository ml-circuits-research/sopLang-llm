@slots literal
{
  "depot": "north depot",
  "unit": "crates",
  "values": [
    7,
    17,
    27,
    11,
    18,
    39,
    31
  ],
  "threshold": 23,
  "edges": [
    [
      11,
      17
    ],
    [
      17,
      18
    ],
    [
      18,
      27
    ]
  ],
  "target": 27
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

