@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    25,
    27,
    42,
    41,
    11,
    28,
    19,
    5
  ],
  "threshold": 9,
  "edges": [
    [
      5,
      11
    ],
    [
      19,
      25
    ],
    [
      28,
      41
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

