@slots literal
{
  "depot": "river depot",
  "unit": "tickets",
  "values": [
    41,
    12,
    41,
    36,
    11
  ],
  "threshold": 16,
  "edges": [
    [
      11,
      12
    ],
    [
      36,
      41
    ]
  ],
  "target": 36
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

