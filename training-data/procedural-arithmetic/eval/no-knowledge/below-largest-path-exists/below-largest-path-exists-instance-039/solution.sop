@slots literal
{
  "depot": "harbour depot",
  "unit": "parts",
  "values": [
    16,
    35,
    10,
    25,
    5,
    4,
    15
  ],
  "threshold": 21,
  "edges": [
    [
      4,
      5
    ],
    [
      5,
      10
    ],
    [
      15,
      16
    ],
    [
      16,
      25
    ],
    [
      25,
      35
    ]
  ],
  "target": 10
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

