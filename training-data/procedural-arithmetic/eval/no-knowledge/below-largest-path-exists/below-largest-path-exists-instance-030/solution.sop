@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    10,
    32,
    5,
    7,
    40,
    28,
    42
  ],
  "threshold": 11,
  "edges": [
    [
      5,
      7
    ],
    [
      10,
      28
    ]
  ],
  "target": 7
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

