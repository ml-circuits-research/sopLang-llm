@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    21,
    29,
    28,
    32,
    39,
    38,
    30
  ],
  "threshold": 24,
  "edges": [
    [
      21,
      28
    ],
    [
      29,
      30
    ],
    [
      38,
      39
    ]
  ],
  "target": 29
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

