@slots literal
{
  "depot": "market depot",
  "unit": "litres",
  "values": [
    35,
    37,
    26,
    7,
    35,
    23,
    17,
    30
  ],
  "threshold": 18,
  "edges": [
    [
      7,
      17
    ],
    [
      17,
      23
    ],
    [
      23,
      26
    ],
    [
      30,
      35
    ],
    [
      35,
      37
    ]
  ],
  "target": 23
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

