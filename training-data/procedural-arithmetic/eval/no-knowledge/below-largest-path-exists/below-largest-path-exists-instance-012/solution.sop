@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    39,
    5,
    10,
    38,
    15,
    33,
    16
  ],
  "threshold": 20,
  "edges": [
    [
      10,
      15
    ],
    [
      16,
      33
    ],
    [
      33,
      38
    ],
    [
      38,
      39
    ]
  ],
  "target": 33
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

