@slots literal
{
  "depot": "harbour depot",
  "unit": "crates",
  "values": [
    4,
    4,
    21,
    28,
    32,
    10
  ],
  "threshold": 12,
  "edges": [
    [
      10,
      21
    ],
    [
      28,
      32
    ]
  ],
  "target": 21
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

