@slots literal
{
  "depot": "hill depot",
  "unit": "crates",
  "values": [
    23,
    42,
    26,
    38,
    26,
    22,
    13
  ],
  "threshold": 23,
  "edges": [
    [
      13,
      22
    ],
    [
      23,
      26
    ],
    [
      26,
      38
    ]
  ],
  "target": 26
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

