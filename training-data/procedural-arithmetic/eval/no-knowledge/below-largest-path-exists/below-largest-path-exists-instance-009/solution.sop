@slots literal
{
  "depot": "north depot",
  "unit": "sheets",
  "values": [
    3,
    12,
    3,
    10,
    5,
    29
  ],
  "threshold": 24,
  "edges": [
    [
      10,
      12
    ]
  ],
  "target": 10
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

