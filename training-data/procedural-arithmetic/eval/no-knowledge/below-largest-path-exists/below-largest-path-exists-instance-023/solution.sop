@slots literal
{
  "depot": "hill depot",
  "unit": "crates",
  "values": [
    4,
    42,
    38,
    12,
    36
  ],
  "threshold": 27,
  "edges": [
    [
      4,
      12
    ],
    [
      36,
      38
    ]
  ],
  "target": 4
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

