@slots literal
{
  "depot": "market depot",
  "unit": "sheets",
  "values": [
    8,
    12,
    7,
    17,
    40
  ],
  "threshold": 9,
  "edges": [
    [
      7,
      8
    ],
    [
      8,
      12
    ],
    [
      12,
      17
    ],
    [
      17,
      40
    ]
  ],
  "target": 17
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

