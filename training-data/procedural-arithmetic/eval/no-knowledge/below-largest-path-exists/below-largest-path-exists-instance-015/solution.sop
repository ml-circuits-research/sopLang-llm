@slots literal
{
  "depot": "harbour depot",
  "unit": "sheets",
  "values": [
    14,
    39,
    26,
    9,
    18,
    5
  ],
  "threshold": 21,
  "edges": [
    [
      5,
      9
    ],
    [
      9,
      14
    ],
    [
      14,
      18
    ],
    [
      18,
      26
    ],
    [
      26,
      39
    ]
  ],
  "target": 26
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

