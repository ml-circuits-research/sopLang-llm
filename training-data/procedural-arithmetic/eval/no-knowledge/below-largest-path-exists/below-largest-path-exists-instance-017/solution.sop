@slots literal
{
  "depot": "north depot",
  "unit": "parts",
  "values": [
    32,
    41,
    25,
    19,
    29,
    33,
    39
  ],
  "threshold": 27,
  "edges": [
    [
      19,
      25
    ],
    [
      25,
      29
    ],
    [
      32,
      33
    ],
    [
      33,
      39
    ],
    [
      39,
      41
    ]
  ],
  "target": 33
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

