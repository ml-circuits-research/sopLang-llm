@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    4,
    40,
    11,
    20,
    26,
    3,
    24
  ],
  "threshold": 8,
  "edges": [
    [
      4,
      11
    ],
    [
      26,
      40
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

