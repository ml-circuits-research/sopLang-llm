@slots literal
{
  "depot": "hill depot",
  "unit": "tickets",
  "values": [
    28,
    34,
    10,
    20,
    11
  ],
  "threshold": 26,
  "edges": [
    [
      11,
      20
    ],
    [
      20,
      28
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

