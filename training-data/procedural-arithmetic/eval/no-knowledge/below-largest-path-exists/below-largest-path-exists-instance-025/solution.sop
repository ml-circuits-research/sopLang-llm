@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    8,
    38,
    13,
    32,
    28,
    42,
    37,
    9
  ],
  "threshold": 15,
  "edges": [
    [
      8,
      9
    ],
    [
      9,
      13
    ],
    [
      13,
      28
    ],
    [
      32,
      37
    ],
    [
      37,
      38
    ],
    [
      38,
      42
    ]
  ],
  "target": 8
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

