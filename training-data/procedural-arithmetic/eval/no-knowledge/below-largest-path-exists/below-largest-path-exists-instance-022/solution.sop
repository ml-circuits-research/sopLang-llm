@slots literal
{
  "depot": "north depot",
  "unit": "parts",
  "values": [
    3,
    27,
    31,
    25,
    28,
    17,
    36,
    5
  ],
  "threshold": 19,
  "edges": [
    [
      3,
      5
    ],
    [
      5,
      17
    ],
    [
      27,
      28
    ],
    [
      28,
      31
    ]
  ],
  "target": 5
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

