@slots literal
{
  "depot": "market depot",
  "unit": "parts",
  "values": [
    40,
    20,
    32,
    15,
    42
  ],
  "threshold": 23,
  "edges": [
    [
      15,
      20
    ],
    [
      40,
      42
    ]
  ],
  "target": 15
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

