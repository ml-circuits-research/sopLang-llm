@slots literal
{
  "depot": "river depot",
  "unit": "crates",
  "values": [
    41,
    4,
    13,
    13,
    4
  ],
  "threshold": 24,
  "edges": [
    [
      4,
      13
    ],
    [
      13,
      41
    ]
  ],
  "target": 41
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

