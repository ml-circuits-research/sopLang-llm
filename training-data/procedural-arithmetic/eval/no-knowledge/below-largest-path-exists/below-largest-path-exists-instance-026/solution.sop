@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    14,
    39,
    32,
    11,
    25,
    12
  ],
  "threshold": 17,
  "edges": [
    [
      12,
      14
    ],
    [
      14,
      25
    ],
    [
      25,
      32
    ],
    [
      32,
      39
    ]
  ],
  "target": 12
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

