@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    4,
    12,
    9,
    11,
    24
  ],
  "threshold": 15,
  "edges": [
    [
      4,
      9
    ],
    [
      12,
      24
    ]
  ],
  "target": 9
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

