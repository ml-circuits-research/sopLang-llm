@slots literal
{
  "depot": "market depot",
  "unit": "sheets",
  "values": [
    9,
    11,
    33,
    25,
    28
  ],
  "threshold": 19,
  "edges": [
    [
      9,
      11
    ]
  ],
  "target": 9
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

