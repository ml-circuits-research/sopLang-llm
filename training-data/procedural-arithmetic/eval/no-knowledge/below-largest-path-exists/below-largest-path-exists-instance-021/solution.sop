@slots literal
{
  "depot": "hill depot",
  "unit": "parts",
  "values": [
    30,
    12,
    28,
    39,
    10,
    13
  ],
  "threshold": 14,
  "edges": [
    [
      10,
      12
    ],
    [
      12,
      13
    ],
    [
      13,
      28
    ],
    [
      28,
      30
    ],
    [
      30,
      39
    ]
  ],
  "target": 39
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

