@slots literal
{
  "depot": "north depot",
  "unit": "tickets",
  "values": [
    24,
    9,
    42,
    36,
    6,
    12
  ],
  "threshold": 12,
  "edges": [
    [
      6,
      9
    ],
    [
      9,
      12
    ],
    [
      36,
      42
    ]
  ],
  "target": 42
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

