@slots literal
{
  "depot": "market depot",
  "unit": "crates",
  "values": [
    42,
    39,
    6,
    17,
    16,
    23
  ],
  "threshold": 20,
  "edges": [
    [
      6,
      16
    ],
    [
      16,
      17
    ],
    [
      17,
      23
    ],
    [
      39,
      42
    ]
  ],
  "target": 42
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

