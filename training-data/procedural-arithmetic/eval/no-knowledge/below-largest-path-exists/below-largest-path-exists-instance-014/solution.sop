@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    36,
    25,
    11,
    37,
    18
  ],
  "threshold": 27,
  "edges": [
    [
      11,
      18
    ],
    [
      25,
      36
    ],
    [
      36,
      37
    ]
  ],
  "target": 11
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

