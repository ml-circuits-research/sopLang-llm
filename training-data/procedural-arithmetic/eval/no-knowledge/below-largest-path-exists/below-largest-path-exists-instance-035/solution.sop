@slots literal
{
  "depot": "hill depot",
  "unit": "crates",
  "values": [
    38,
    9,
    32,
    15,
    3,
    21,
    20,
    41
  ],
  "threshold": 23,
  "edges": [
    [
      3,
      9
    ],
    [
      9,
      15
    ],
    [
      20,
      21
    ],
    [
      21,
      32
    ],
    [
      32,
      38
    ],
    [
      38,
      41
    ]
  ],
  "target": 20
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

