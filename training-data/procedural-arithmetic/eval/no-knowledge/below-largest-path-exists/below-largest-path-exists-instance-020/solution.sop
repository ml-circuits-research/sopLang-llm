@slots literal
{
  "depot": "hill depot",
  "unit": "sheets",
  "values": [
    30,
    22,
    29,
    21,
    5
  ],
  "threshold": 8,
  "edges": [
    [
      5,
      21
    ],
    [
      21,
      22
    ],
    [
      22,
      29
    ]
  ],
  "target": 22
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

