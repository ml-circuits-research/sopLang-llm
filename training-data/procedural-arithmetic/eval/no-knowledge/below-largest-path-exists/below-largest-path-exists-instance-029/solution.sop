@slots literal
{
  "depot": "hill depot",
  "unit": "crates",
  "values": [
    3,
    11,
    39,
    29,
    4,
    16,
    5,
    24
  ],
  "threshold": 16,
  "edges": [
    [
      3,
      4
    ],
    [
      4,
      5
    ],
    [
      5,
      11
    ],
    [
      16,
      24
    ],
    [
      24,
      29
    ],
    [
      29,
      39
    ]
  ],
  "target": 3
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
probe(Array.isArray(values) && values.length > 0, "the records must be a non-empty list");
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

