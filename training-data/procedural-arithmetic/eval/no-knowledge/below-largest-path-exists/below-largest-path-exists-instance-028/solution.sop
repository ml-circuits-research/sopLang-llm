@slots literal
{
  "depot": "harbour depot",
  "unit": "litres",
  "values": [
    22,
    22,
    8,
    36,
    32,
    10,
    30
  ],
  "threshold": 26,
  "edges": [
    [
      8,
      10
    ],
    [
      22,
      30
    ],
    [
      30,
      32
    ],
    [
      32,
      36
    ]
  ],
  "target": 8
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

