@slots literal
{
  "depot": "river depot",
  "unit": "sheets",
  "values": [
    7,
    9,
    18,
    19,
    16,
    19,
    36
  ],
  "threshold": 25,
  "edges": [
    [
      7,
      9
    ],
    [
      18,
      19
    ]
  ],
  "target": 7
}

@stage0 jsEval
const slots = $slots;
const values = slots.values;
let current = values;
const kept0 = current.filter((value) => value < slots.threshold);
current = kept0;
const extreme1 = Math.max(...current);
current = extreme1;
return current;

@stage1 graphPath
from: $stage0
to: $slots.target
edges: $slots.edges

@answer jsEval
return $stage1 + ".";

