@slots literal
{
  "rules": [
    {
      "index": 1,
      "conditions": [
        {
          "name": "A",
          "value": "active"
        }
      ],
      "conclusion": {
        "name": "B",
        "value": "active"
      }
    },
    {
      "index": 2,
      "conditions": [
        {
          "name": "B",
          "value": "active"
        },
        {
          "name": "C",
          "value": "inactive"
        }
      ],
      "conclusion": {
        "name": "D",
        "value": "active"
      }
    },
    {
      "index": 3,
      "conditions": [
        {
          "name": "D",
          "value": "active"
        }
      ],
      "conclusion": {
        "name": "E",
        "value": "inactive"
      }
    },
    {
      "index": 4,
      "conditions": [
        {
          "name": "E",
          "value": "active"
        }
      ],
      "conclusion": {
        "name": "A",
        "value": "inactive"
      }
    }
  ],
  "observed": [
    {
      "name": "A",
      "value": "active"
    },
    {
      "name": "C",
      "value": "inactive"
    }
  ],
  "query": [
    "B",
    "D",
    "E"
  ],
  "askedRule": 4
}

@seed jsEval
const slots = $slots;
const facts = {};
for (const fact of slots.observed) {
  facts[fact.name] = fact.value;
}
return facts;

@closure jsEval
const slots = $slots;
const facts = Object.assign({}, $seed);
const applied = [];
let progressed = true;
while (progressed) {
  progressed = false;
  for (const rule of slots.rules) {
    if (applied.includes(rule.index) || !rule.conditions.every((c) => facts[c.name] === c.value)) continue;
    const known = facts[rule.conclusion.name];
    if (known !== undefined && known !== rule.conclusion.value) throw new Error("rule " + rule.index + " contradicts the known value of " + rule.conclusion.name);
    if (known === undefined) { facts[rule.conclusion.name] = rule.conclusion.value; applied.push(rule.index); progressed = true; }
  }
}
return { applied, conclusions: slots.query.map((name) => name + " must be " + facts[name]), pinned: slots.query.every((name) => facts[name] !== undefined) };

@deduce jsEval
const slots = $slots;
const closure = $closure;
probe(closure.pinned, "the stated rules must pin down every queried value");
probe(closure.applied.indexOf(slots.askedRule) === -1, "the asked rule must not be needed in this family");
return { conclusions: closure.conclusions, askedRule: slots.askedRule };

@answer jsEval
const words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
return $deduce.conclusions.join("; ") + ". Rule " + $deduce.askedRule + " is not needed for these " + words[$deduce.conclusions.length] + " conclusions in this case.";

