@slots literal
{
  "cells": [
    [
      "Ana",
      "Monday",
      3
    ],
    [
      "Ana",
      "Tuesday",
      5
    ],
    [
      "Dan",
      "Monday",
      4
    ],
    [
      "Dan",
      "Tuesday",
      2
    ]
  ],
  "row": "Dan",
  "column": "Monday"
}

@answer jsEval
const slots = $slots;
const found = slots.cells.find((cell) => cell[0] === slots.row && cell[1] === slots.column);
if (found === undefined) { throw new Error("the requested cell is not in the table"); }
return String(found[2]) + ".";

