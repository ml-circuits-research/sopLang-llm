@slots literal
{
  "answers": [
    "yes",
    "yes",
    "no",
    "suppose"
  ],
  "faulty": 2,
  "value": "yes"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const counts = new Map();
for (const answer of slots.answers) { counts.set(answer, (counts.get(answer) || 0) + 1); }
const ordered = Array.from(counts.entries()).sort((left, right) => right[1] - left[1]);
if (ordered[0][0] !== slots.value) { throw new Error("the claimed value is not the majority answer"); }
return slots.faulty * 2 < slots.answers.length ? "Yes." : "No.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

