@slots literal
{
  "moves": [
    "N",
    "E",
    "S",
    "W"
  ]
}

@answer jsEval
const slots = $slots;
let dx = 0; let dy = 0;
for (const move of slots.moves) {
  if (move === "E") dx += 1; else if (move === "W") dx -= 1;
  else if (move === "N") dy += 1; else if (move === "S") dy -= 1;
}
return (dx === 0 && dy === 0) ? "Yes." : "No.";

