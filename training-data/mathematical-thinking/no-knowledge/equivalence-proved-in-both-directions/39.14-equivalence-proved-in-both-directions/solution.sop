@slots literal
{
  "domain": [
    1,
    2,
    3,
    4
  ],
  "set": [
    2,
    4
  ]
}

@answer jsEval
const slots = $slots;
const holds = slots.domain.every((value) => (value % 2 === 0) === slots.set.includes(value));
return holds ? "Both directions must be checked; both are true." : "The directions do not both hold.";

