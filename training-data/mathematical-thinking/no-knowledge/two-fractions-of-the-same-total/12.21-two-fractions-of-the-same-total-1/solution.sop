@slots literal
{
  "total": 24,
  "a": {
    "numerator": 2,
    "denominator": 6
  },
  "b": {
    "numerator": 3,
    "denominator": 6
  }
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
if (slots.a.denominator !== slots.b.denominator) {
  throw new Error("the two fractions do not share a denominator");
}
if (slots.total % slots.a.denominator !== 0) {
  throw new Error("the total does not divide into equal parts");
}
const part = slots.total / slots.a.denominator;
return String(part * (slots.a.numerator + slots.b.numerator));
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

