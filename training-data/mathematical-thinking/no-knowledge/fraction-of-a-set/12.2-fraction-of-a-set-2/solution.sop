@slots literal
{
  "total": 30,
  "numerator": 2,
  "denominator": 5
}

@answer jsEval
const slots = $slots;
if (slots.total % slots.denominator !== 0) {
  throw new Error("the total does not divide into equal parts");
}
const part = slots.total / slots.denominator;
return String(part * slots.numerator);

