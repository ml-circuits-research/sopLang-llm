@slots literal
{
  "faces": [
    1,
    2
  ],
  "cubes": 2
}

@sums jsEval
const slots = $slots;
const sums = new Set();
const walk = (left, total) => {
  if (left === 0) {
    sums.add(total);
    return;
  }
  for (const face of slots.faces) {
    walk(left - 1, total + face);
  }
};
walk(slots.cubes, 0);
return [...sums].sort((left, right) => left - right);

@answer jsEval
let text;
if ($sums.length === 1) {
  text = String($sums[0]);
} else {
  text = $sums.slice(0, -1).join(", ") + ", and " + $sums[$sums.length - 1];
}
return text + ".";

