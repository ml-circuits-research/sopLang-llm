@slots literal
{
  "ruleProperty": "three corners",
  "ruleConsequence": "green",
  "observedProperty": "three corners",
  "observedValue": "red",
  "deniedValue": "green"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const contradicts = slots.observedProperty === slots.ruleProperty &&
  slots.deniedValue === slots.ruleConsequence &&
  slots.observedValue !== slots.ruleConsequence;
return contradicts ? "No; the description is incompatible with the rule." : "Yes; the description can be true.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

