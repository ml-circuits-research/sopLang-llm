@slots literal
{
  "cells": [
    [
      "Ana",
      "Monday",
      3
    ],
    [
      "Ana",
      "Tuesday",
      5
    ],
    [
      "Dan",
      "Monday",
      4
    ],
    [
      "Dan",
      "Tuesday",
      2
    ]
  ],
  "day": "Monday"
}

@answer jsEval
const slots = $slots;
const column = slots.cells.filter((cell) => cell[1] === slots.day);
if (column.length === 0) { throw new Error("the requested day is not a column of the table"); }
let total = 0;
for (const cell of column) { total += cell[2]; }
return String(total) + ".";

