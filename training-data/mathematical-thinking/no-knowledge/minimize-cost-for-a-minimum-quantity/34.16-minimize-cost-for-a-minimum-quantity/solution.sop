@slots literal
{
  "unitsA": 4,
  "costA": 5,
  "unitsB": 7,
  "costB": 8,
  "need": 8
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
let best = null;
const limitA = Math.ceil(slots.need / slots.unitsA) + 1;
const limitB = Math.ceil(slots.need / slots.unitsB) + 1;
for (let a = 0; a <= limitA; a += 1) {
  for (let b = 0; b <= limitB; b += 1) {
    if (a * slots.unitsA + b * slots.unitsB < slots.need) { continue; }
    const cost = a * slots.costA + b * slots.costB;
    if (best === null || cost < best.cost || (cost === best.cost && a + b < best.a + best.b)) { best = { a, b, cost, units: a * slots.unitsA + b * slots.unitsB }; }
  }
}
return best.a + " package" + (best.a === 1 ? "" : "s") + " A, cost " + best.cost + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

