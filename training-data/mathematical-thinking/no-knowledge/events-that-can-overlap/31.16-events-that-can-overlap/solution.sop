@slots literal
{
  "universe": [
    1,
    2,
    3,
    4,
    5,
    6
  ],
  "a": [
    2,
    4,
    6
  ],
  "b": [
    4,
    5,
    6
  ]
}

@answer jsEval
const slots = $slots;
const overlap = slots.a.filter((value) => slots.b.includes(value));
return overlap.length === 0 ? "No." : "Yes; " + overlap.join(" or ") + ".";

