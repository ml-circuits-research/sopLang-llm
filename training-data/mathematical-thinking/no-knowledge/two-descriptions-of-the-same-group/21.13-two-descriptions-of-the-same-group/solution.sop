@slots literal
{
  "listed": [
    2,
    4,
    6
  ],
  "lower": 1,
  "upper": 7
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const defined = [];
for (let value = slots.lower + 1; value < slots.upper; value += 1) {
  if (value % 2 === 0) { defined.push(value); }
}
const listed = slots.listed.slice().sort(function (left, right) { return left - right; });
let equal = listed.length === defined.length;
for (let index = 0; index < listed.length; index += 1) {
  if (listed[index] !== defined[index]) { equal = false; }
}
return equal ? "Yes, the groups are equal." : "No, the groups are different.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

