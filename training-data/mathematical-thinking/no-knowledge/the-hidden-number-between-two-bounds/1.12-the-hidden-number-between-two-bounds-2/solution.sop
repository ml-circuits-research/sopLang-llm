@slots literal
{
  "numbers": [
    6,
    8,
    11,
    14
  ],
  "lower": 7,
  "upper": 10
}

@answer jsEval
const slots = $slots;
const matching = slots.numbers.filter((value) => value > slots.lower && value < slots.upper);
if (matching.length !== 1) {
  throw new Error(`the bounds keep ${matching.length} candidates instead of one`);
}
return String(matching[0]);

