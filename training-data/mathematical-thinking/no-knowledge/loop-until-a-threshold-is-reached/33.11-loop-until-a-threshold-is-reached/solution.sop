@slots literal
{
  "start": 2,
  "limit": 10,
  "step": {
    "op": "add",
    "operand": 3
  }
}

@answer jsEval
const slots = $slots;
let value = slots.start;
const values = [value];
while (value < slots.limit) {
  value = value + slots.step.operand;
  values.push(value);
}
return "It stops at " + value + ".";

