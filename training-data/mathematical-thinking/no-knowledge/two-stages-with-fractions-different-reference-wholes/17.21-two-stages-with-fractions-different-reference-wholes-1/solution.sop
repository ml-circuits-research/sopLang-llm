@slots literal
{
  "total": 60,
  "numerator1": 2,
  "denominator1": 5,
  "numerator2": 1,
  "denominator2": 3
}

@answer jsEval
const slots = $slots;
const first = (slots.total / slots.denominator1) * slots.numerator1;
const remaining = slots.total - first;
return String((remaining / slots.denominator2) * slots.numerator2);

