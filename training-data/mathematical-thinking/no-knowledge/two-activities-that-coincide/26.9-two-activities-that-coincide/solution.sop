@slots literal
{
  "a": {
    "period": 2,
    "start": 2
  },
  "b": {
    "period": 3,
    "start": 3
  }
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const occursOn = (activity, day) => day >= activity.start && (day - activity.start) % activity.period === 0;
const limit = slots.a.start + slots.b.start + slots.a.period * slots.b.period;
let day = 1;
while (day <= limit && !(occursOn(slots.a, day) && occursOn(slots.b, day))) {
  day += 1;
}
if (day > limit) { throw new Error("the two activities never occur on the same day"); }
return "Day " + day + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

