@slots literal
{
  "original": "1100",
  "next": "0011"
}

@answer jsEval
const slots = $slots;
let first = 0;
for (const digit of String(slots.original)) {
  if (digit === "1") first += 1;
}
let second = 0;
for (const digit of String(slots.next)) {
  if (digit === "1") second += 1;
}
return first % 2 === second % 2 ? "No." : "Yes.";

