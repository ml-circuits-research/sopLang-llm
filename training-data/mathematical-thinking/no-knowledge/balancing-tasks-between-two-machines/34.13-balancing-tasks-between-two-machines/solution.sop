@slots literal
{
  "durations": [
    6,
    4,
    3,
    3
  ],
  "threshold": 8
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
let best = Infinity;
for (let mask = 0; mask < (1 << slots.durations.length); mask += 1) {
  let first = 0;
  let second = 0;
  for (let index = 0; index < slots.durations.length; index += 1) {
    if ((mask >> index) & 1) { first += slots.durations[index]; } else { second += slots.durations[index]; }
  }
  best = Math.min(best, Math.max(first, second));
}
return slots.threshold + (best <= slots.threshold ? " is possible; " : " is impossible; ") + "the minimum time is " + best + " minutes.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

