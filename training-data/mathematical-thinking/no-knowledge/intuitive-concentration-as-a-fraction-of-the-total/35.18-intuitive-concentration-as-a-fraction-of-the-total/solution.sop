@slots literal
{
  "syrup": 2,
  "water": 8
}

@answer jsEval
const slots = $slots;
function reduce(a, b) { return b === 0 ? a : reduce(b, a % b); }
const total = slots.syrup + slots.water;
const divide = reduce(slots.syrup, total);
return String(slots.syrup / divide) + "/" + String(total / divide) + ".";

