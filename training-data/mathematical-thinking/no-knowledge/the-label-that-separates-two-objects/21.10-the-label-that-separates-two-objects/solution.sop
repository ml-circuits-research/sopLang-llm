@slots literal
{
  "first": [
    "red",
    "round",
    "small"
  ],
  "second": [
    "red",
    "square",
    "small"
  ]
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
if (slots.first.length !== slots.second.length) { throw new Error("the two objects do not have comparable properties"); }
let property = null;
for (let index = 0; index < slots.first.length; index += 1) {
  if (slots.first[index] !== slots.second[index]) { property = slots.first[index]; break; }
}
if (property === null) { throw new Error("the two objects are indistinguishable"); }
return "“Is it " + property + "?”";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

