@slots literal
{
  "operator": "xor",
  "properties": [
    "red",
    "round"
  ],
  "pieces": [
    {
      "name": "A",
      "properties": [
        "red",
        "square"
      ]
    },
    {
      "name": "B",
      "properties": [
        "blue",
        "round"
      ]
    },
    {
      "name": "C",
      "properties": [
