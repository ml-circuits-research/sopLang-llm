@slots literal
{
  "positions": [
    {
      "minute": 0,
      "meters": 0
    },
    {
      "minute": 2,
      "meters": 8
    },
    {
      "minute": 5,
      "meters": 20
    }
  ],
  "from": 2,
  "to": 5
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const start = slots.positions.find((position) => position.minute === slots.from);
const end = slots.positions.find((position) => position.minute === slots.to);
if (start === undefined || end === undefined) { throw new Error("the segment bounds are not in the table"); }
return (end.meters - start.meters) / (end.minute - start.minute) + " m/min.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

