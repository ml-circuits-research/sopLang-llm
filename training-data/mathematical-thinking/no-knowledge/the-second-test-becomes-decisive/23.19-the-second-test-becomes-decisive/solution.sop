@slots literal
{
  "boxes": [
    "A",
    "B",
    "C"
  ],
  "failed": [
    "A",
    "B"
  ]
}

@remaining jsEval
const slots = $slots;
return slots.boxes.filter((box) => slots.failed.indexOf(box) === -1);

@answer jsEval
if ($remaining.length === 1) { return "The key opens box " + $remaining[0] + "."; }
return "It could be " + $remaining.join(" or ") + ".";

