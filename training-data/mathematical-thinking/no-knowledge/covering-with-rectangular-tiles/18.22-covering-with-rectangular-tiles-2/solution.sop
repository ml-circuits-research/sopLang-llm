@slots literal
{
  "surfaceLength": 15,
  "surfaceWidth": 10,
  "tileLength": 5,
  "tileWidth": 2
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
if (slots.surfaceLength % slots.tileLength !== 0 || slots.surfaceWidth % slots.tileWidth !== 0) {
  throw new Error("the tiles do not cover the surface exactly");
}
const alongLength = slots.surfaceLength / slots.tileLength;
const alongWidth = slots.surfaceWidth / slots.tileWidth;
return String(Math.round(alongLength * alongWidth));
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

