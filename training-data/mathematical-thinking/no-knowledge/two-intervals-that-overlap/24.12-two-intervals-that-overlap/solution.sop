@slots literal
{
  "a": {
    "lower": 10,
    "upper": 12
  },
  "b": {
    "lower": 11,
    "upper": 13
  }
}

@answer jsEval
const slots = $slots;
if (slots.a.upper < slots.b.lower) { return "B is certainly longer."; }
if (slots.b.upper < slots.a.lower) { return "A is certainly longer."; }
return "It cannot be determined with certainty.";

