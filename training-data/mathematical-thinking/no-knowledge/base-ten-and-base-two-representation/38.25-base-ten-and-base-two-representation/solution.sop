@slots literal
{
  "decimal": 5,
  "binary": "101",
  "weights": [
    4,
    2,
    1
  ]
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
if (String(slots.binary).length !== slots.weights.length) { throw new Error("the binary string does not match the number of weights"); }
let value = 0;
for (let index = 0; index < slots.weights.length; index += 1) {
  value += slots.weights[index] * Number(slots.binary[index]);
}
return value === slots.decimal ? "No; both represent the value " + value + "." : "Yes; the two notations give different values.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

