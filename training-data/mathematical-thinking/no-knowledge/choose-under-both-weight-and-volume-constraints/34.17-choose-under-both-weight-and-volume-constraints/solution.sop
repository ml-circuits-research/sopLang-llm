@slots literal
{
  "maxWeight": 10,
  "maxVolume": 8,
  "x": {
    "weight": 6,
    "volume": 5
  },
  "y": {
    "weight": 4,
    "volume": 4
  }
}

@answer jsEval
const slots = $slots;
const weight = slots.x.weight + slots.y.weight;
const volume = slots.x.volume + slots.y.volume;
return weight <= slots.maxWeight && volume <= slots.maxVolume ? "Yes." : "No.";

