@slots literal
{
  "steps": [
    {
      "op": "add",
      "operand": 4
    },
    {
      "op": "multiply",
      "operand": 2
    }
  ],
  "output": 20
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
let value = slots.output;
for (let index = slots.steps.length - 1; index >= 0; index -= 1) {
  const step = slots.steps[index];
  if (step.op === "add") { value = value - step.operand; }
  else if (step.op === "subtract") { value = value + step.operand; }
  else if (step.op === "multiply") { value = value / step.operand; }
  else { value = value * step.operand; }
}
return value + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

