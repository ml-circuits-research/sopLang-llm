@slots literal
{
  "initial": 16,
  "first": {
    "op": "add",
    "amount": 7
  },
  "second": {
    "op": "remove",
    "amount": 2
  }
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const apply = (value, change) => (change.op === "add" ? value + change.amount : value - change.amount);
const afterFirst = apply(slots.initial, slots.first);
const afterSecond = apply(afterFirst, slots.second);
if (afterSecond < 0) {
  throw new Error("the second rule would remove more than the box holds");
}
return String(afterSecond);
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

