@slots literal
{
  "tokens": 4,
  "moves": [
    1,
    2
  ]
}

@answer jsEval
const slots = $slots;
const winning = slots.moves.filter((move) => (slots.tokens - move) % 3 === 0);
if (winning.length !== 1) { throw new Error("the statement does not describe a single winning move"); }
const move = winning[0];
return "Take " + move + " token" + (move === 1 ? "" : "s") + ".";

