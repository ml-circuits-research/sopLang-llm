@slots literal
{
  "perimeter": 36,
  "known": 12
}

@answer jsEval
const slots = $slots;
const remaining = slots.perimeter - 2 * slots.known;
if (remaining % 2 !== 0) {
  throw new Error("the remaining length does not split into two equal sides");
}
const unknown = remaining / 2;
return unknown + " cm";

