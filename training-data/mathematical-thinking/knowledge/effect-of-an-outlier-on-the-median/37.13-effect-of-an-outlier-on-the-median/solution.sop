@facts literal
{"medianRule":{"odd":"middle","even":"mean-of-two-central"}}

@slots literal
{
  "values": [
    4,
    5,
    6
  ],
  "oldMedian": 5,
  "added": 20
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const rule = $facts.medianRule;
const ordered = [...slots.values, slots.added].sort((a, b) => a - b);
if (ordered.length % 2 !== 0) {
  throw new Error("the median rule for an even list of values is required");
}
const middle = ordered.length / 2;
const median = rule.even === "mean-of-two-central" ? (ordered[middle - 1] + ordered[middle]) / 2 : (() => { throw new Error("unsupported even median rule " + rule.even); })();
return String(median) + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

