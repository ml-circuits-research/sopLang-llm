@facts literal
{"degreesPerQuarterTurn":90,"quarterTurnSwapsTheAxes":true}

@slots literal
{
  "horizontal": 2,
  "vertical": 5,
  "degrees": 90
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const quarterTurns = Math.round(slots.degrees / $facts.degreesPerQuarterTurn);
const swapped = quarterTurns % 2 === 1 && $facts.quarterTurnSwapsTheAxes === true;
const horizontal = swapped ? slots.vertical : slots.horizontal;
const vertical = swapped ? slots.horizontal : slots.vertical;
return horizontal + "×" + vertical + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

