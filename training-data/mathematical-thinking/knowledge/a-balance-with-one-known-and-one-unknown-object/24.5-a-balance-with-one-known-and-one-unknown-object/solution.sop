@facts literal
{ "balanceScale": { "levelImplies": "equal total mass", "additive": true } }

@slots literal
{
  "left": 3,
  "right": 8
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const facts = $facts.balanceScale;
if (facts.levelImplies !== "equal total mass") { throw new Error("the balance semantics are unknown"); }
if (slots.right - slots.left <= 0) { throw new Error("the ball would have a non-positive mass"); }
return String(slots.right - slots.left) + " units.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

