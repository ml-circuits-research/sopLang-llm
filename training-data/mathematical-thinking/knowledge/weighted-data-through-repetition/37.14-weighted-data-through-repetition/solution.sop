@facts literal
{"meanRule":{"numerator":"sum","denominator":"count"}}

@slots literal
{
  "grades": [
    [
      8,
      2
    ],
    [
      10,
      1
    ]
  ]
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const VULGAR_FRACTION = new Map([["1/2", "½"], ["1/3", "⅓"], ["2/3", "⅔"], ["1/4", "¼"], ["3/4", "¾"], ["1/5", "⅕"], ["2/5", "⅖"], ["3/5", "⅗"], ["4/5", "⅘"], ["1/6", "⅙"], ["5/6", "⅚"], ["1/8", "⅛"], ["3/8", "⅜"], ["5/8", "⅝"], ["7/8", "⅞"]]);
function fractionText(numerator, denominator) {
  let a = Math.abs(numerator);
  let b = Math.abs(denominator);
  while (b !== 0) {
    const remainder = a % b;
    a = b;
    b = remainder;
  }
  const num = numerator / a;
  const den = denominator / a;
  if (den === 1) {
    return String(num);
  }
  const whole = Math.trunc(num / den);
  const remainder = num - whole * den;
  const glyph = VULGAR_FRACTION.get(remainder + "/" + den);
  const tail = glyph === undefined ? remainder + "/" + den : glyph;
  return whole === 0 ? tail : String(whole) + tail;
}
const slots = $slots;
const rule = $facts.meanRule;
const values = [];
for (const entry of slots.grades) {
  for (let index = 0; index < entry[1]; index += 1) {
    values.push(entry[0]);
  }
}
const numerator = rule.numerator === "sum" ? values.reduce((sum, value) => sum + value, 0) : (() => { throw new Error("unsupported numerator " + rule.numerator); })();
const denominator = rule.denominator === "count" ? values.length : (() => { throw new Error("unsupported denominator " + rule.denominator); })();
return fractionText(numerator, denominator) + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

