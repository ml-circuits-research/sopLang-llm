@facts literal
{"weekdays":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]}

@slots literal
{
  "today": "Monday",
  "offset": 17,
  "weekLength": 7
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const facts = (typeof $facts === "object" && $facts !== null) ? $facts : JSON.parse(String($facts));
const days = facts.weekdays;
const remainder = slots.offset % slots.weekLength;
const index = days.indexOf(slots.today);
if (index === -1) { throw new Error("unknown weekday \"" + slots.today + "\""); }
return days[(index + remainder) % days.length] + ".";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

