@facts literal
{"trials":2,"outcomes":["A","B"]}

@slots literal
{
  "success": "A"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const facts = $facts;
let space = [""];
for (let step = 0; step < facts.trials; step += 1) {
  space = space.flatMap((prefix) => facts.outcomes.map((symbol) => prefix + symbol));
}
const favorable = space.filter((outcome) => outcome.split("").filter((letter) => letter === slots.success).length === 1).length;
function gcd(a, b) { return b === 0 ? a : gcd(b, a % b); }
const factor = gcd(favorable, space.length);
const n = favorable / factor;
const d = space.length / factor;
return d === 1 ? String(n) : n + "/" + d;
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

