@facts literal
{"round": "circle"}

@slots literal
{
  "objects": [
    {
      "name": "A",
      "attributes": [
        "red",
        "circle"
      ]
    },
    {
      "name": "B",
      "attributes": [
        "red",
        "square"
      ]
    },
    {
      "name": "C",
      "attributes": [
        "blue",
        "circle"
      ]
    },
    {
      "name": "D",
      "attributes": [
        "blue",
        "square"
      ]
    }
  ],
  "asks": [
    {
      "word": "red",
      "positive": false
    },
    {
      "word": "round",
      "positive": true
    }
  ]
}

@target jsEval
const slots = $slots;
let target = null;
for (const object of slots.objects) {
  if (slots.asks.every((ask) => {
    const key = $facts[ask.word] !== undefined ? $facts[ask.word] : ask.word;
    return object.attributes.includes(key) === ask.positive;
  })) { target = object; break; }
}
if (target === null) { throw new Error("no object matches the given answers"); }
return target;

@answer jsEval
return $target.name + ".";

