@slots literal
{
  "start": {
    "row": 1,
    "column": 1
  },
  "library": {
    "row": 1,
    "column": 4
  },
  "target": {
    "row": 3,
    "column": 4
  }
}

@answer jsEval
const slots = $slots;
const distance = (a, b) => Math.abs(a.row - b.row) + Math.abs(a.column - b.column);
return (distance(slots.start, slots.library) + distance(slots.library, slots.target)) + " steps.";

