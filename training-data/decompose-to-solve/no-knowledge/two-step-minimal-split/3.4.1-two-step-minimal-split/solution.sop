@slots literal
{
  "workload": 105,
  "workUnit": "servings",
  "limitMinutes": 73,
  "blockCapacity": 17,
  "blockMinutes": 7,
  "setupMinutes": 12
}

@answer jsEval
const slots = $slots;
const blocks = Math.ceil(slots.workload / slots.blockCapacity);
const minutes = blocks * slots.blockMinutes + slots.setupMinutes;
return minutes + " minutes: " + (minutes <= slots.limitMinutes ? "feasible" : "not feasible") + ".";

