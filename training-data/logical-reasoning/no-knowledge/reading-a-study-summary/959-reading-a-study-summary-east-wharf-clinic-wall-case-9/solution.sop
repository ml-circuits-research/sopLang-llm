@slots literal
{
  "place": "East Wharf",
  "adults": 200,
  "pageThrower": "Omar",
  "resultThrower": "Pia",
  "keeper": "Rafi"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the wall summary must name the place of the clinic");
probe(Number.isInteger(slots.adults) && slots.adults > 0, "the summary must list a positive number of adults");
probe(slots.pageThrower !== slots.resultThrower && slots.resultThrower !== slots.keeper && slots.pageThrower !== slots.keeper, "the three readings must come from three different people");
return "The design and the listed result, plus a caution about independence \u2014 not an automatic bin, not an automatic halo.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

