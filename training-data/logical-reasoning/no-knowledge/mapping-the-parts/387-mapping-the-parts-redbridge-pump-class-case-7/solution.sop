@slots literal
{
  "place": "Redbridge",
  "circuits": 2,
  "loops": 2,
  "mapper": "Dora",
  "alternative": "Eli",
  "leveler": "Fran"
}

@answer jsEval
const slots = $slots;
const NUMBER_WORDS = ["zero", "one", "two", "three"];
const word = NUMBER_WORDS[slots.circuits];
return slots.mapper + "\u2019s " + word + "-loop pump. The card\u2019s engine is " + word + " circuits, not \u201cwater moves.\u201d";

