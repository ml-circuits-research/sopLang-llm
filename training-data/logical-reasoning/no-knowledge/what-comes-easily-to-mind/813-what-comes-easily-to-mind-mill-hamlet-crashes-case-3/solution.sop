@slots literal
{
  "picturedCrashes": 2,
  "place": "Mill Hamlet",
  "yearlyCountRose": false,
  "picturingVoice": "Farid",
  "availabilityVoice": "Gina",
  "tableVoice": "Pavel"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(Number.isInteger(slots.picturedCrashes) && slots.picturedCrashes > 0, "the week must picture at least one crash");
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place where the pictured crashes dominate talk");
probe(typeof slots.picturingVoice === "string" && slots.picturingVoice.length > 0, "the case must name the speaker who reads the pictures as rising frequency");
probe(typeof slots.availabilityVoice === "string" && slots.availabilityVoice.length > 0, "the case must name the speaker who names ease of recall");
probe(typeof slots.tableVoice === "string" && slots.tableVoice.length > 0, "the case must name the speaker who defends the table");
probe(slots.picturingVoice !== slots.availabilityVoice && slots.picturingVoice !== slots.tableVoice && slots.availabilityVoice !== slots.tableVoice, "the three readings must belong to three different speakers");
probe(slots.yearlyCountRose === false, "the case posts a listed yearly count that has not risen");
const supplied = "A feeling of commonness";
return supplied + ". The table is the count. Pictures can be urgent and still be a bad substitute for a year-list.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

