@slots literal
{
  "payer": "Farid",
  "place": "Mill Hamlet",
  "preferrer": "Farid",
  "liveVoice": "Gina",
  "wasteVoice": "Pavel",
  "mustStay": "Farid"
}

@answer jsEval
const slots = $slots;
const sunk = "The payment is sunk";
return sunk + ". It will not return if " + slots.payer + " stays. The live question is which next hour is better.";

