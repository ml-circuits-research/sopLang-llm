@slots literal
{
  "payer": "Harun",
  "place": "Wells Village",
  "preferrer": "Harun",
  "liveVoice": "Iona",
  "wasteVoice": "Ruth",
  "mustStay": "Harun"
}

@answer jsEval
const slots = $slots;
const sunk = "The payment is sunk";
return sunk + ". It will not return if " + slots.payer + " stays. The live question is which next hour is better.";

