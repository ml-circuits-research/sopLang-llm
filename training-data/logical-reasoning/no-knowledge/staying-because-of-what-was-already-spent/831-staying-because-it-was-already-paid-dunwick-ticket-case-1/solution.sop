@slots literal
{
  "payer": "Sam",
  "place": "Dunwick",
  "preferrer": "Sam",
  "liveVoice": "Tess",
  "wasteVoice": "Owen",
  "mustStay": "Sam"
}

@answer jsEval
const slots = $slots;
const sunk = "The payment is sunk";
return sunk + ". It will not return if " + slots.payer + " stays. The live question is which next hour is better.";

