@slots literal
{
  "place": "Mill Hamlet",
  "thresholdMonths": 8,
  "refusalApplier": "Farid",
  "applicantMonths": 6,
  "causeReader": "Gina",
  "mixedReader": "Pavel",
  "statedRefusalMonths": 6
