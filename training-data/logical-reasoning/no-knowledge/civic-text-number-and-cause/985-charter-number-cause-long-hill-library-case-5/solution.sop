@slots literal
{
  "place": "Long Hill",
  "thresholdMonths": 7,
  "refusalApplier": "Leo",
  "applicantMonths": 5,
  "causeReader": "Mira",
  "mixedReader": "Quinn",
  "statedRefusalMonths": 5
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
const readers = [slots.refusalApplier, slots.causeReader, slots.mixedReader];
probe(typeof slots.place === "string" && slots.place.length > 0, "the page must name the place of the library");
probe(Number.isInteger(slots.thresholdMonths) && slots.thresholdMonths > 0, "the charter must list a positive month threshold");
probe(Number.isInteger(slots.applicantMonths) && slots.applicantMonths > 0, "the applicant must have a positive number of listed months");
probe(slots.applicantMonths < slots.thresholdMonths, "the definition forces the refusal only when the listed months fall below the threshold");
probe(slots.statedRefusalMonths === slots.applicantMonths, "the two readings of the page must state the same number of listed months");
probe(readers.every((name) => typeof name === "string" && name.length > 0), "the page must name the three readers of the charter, the table, and the letter");
probe(new Set(readers).size === readers.length, "the three readings must come from three different people");
return "The refusal is forced by the definition (" + slots.applicantMonths + " < " + slots.thresholdMonths + "). The causal story about damage is not forced. Two families, two strengths.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

