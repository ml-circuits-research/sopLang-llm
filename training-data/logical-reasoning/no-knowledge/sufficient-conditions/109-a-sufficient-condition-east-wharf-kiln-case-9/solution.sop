@slots literal
{
  "place": "East Wharf",
  "instrument": "pyrometer",
  "threshold": 880,
  "action": "firing",
  "readInstrument": "pyrometer",
  "reading": 900,
  "subject": "Omar",
  "stopAction": "firing",
  "sayer": "Pia",
  "extraSign": "clay",
  "alternative": "cracking",
  "claimer": "Rafi",
  "namedReason": "heat"
}

@answer jsEval
const slots = $slots;
const alternative = slots.alternative.charAt(0).toUpperCase() + slots.alternative.slice(1);
return "Yes. The listed reading is sufficient for stopping. " + alternative + " would be another possible reason in another document.";

