@slots literal
{
  "place": "Mill Hamlet",
  "claim": "all swans are white",
  "counterexample": "black swan",
  "finishedSpeaker": "Farid",
  "proudSpeaker": "Gina",
  "panicSpeaker": "Pavel",
  "overreach": "most swans in this region are white"
}

@answer jsEval
const slots = $slots;
return "The strict universal “" + slots.claim + ".” It does not, by itself, refute a statistical sentence that was not on the card.";

