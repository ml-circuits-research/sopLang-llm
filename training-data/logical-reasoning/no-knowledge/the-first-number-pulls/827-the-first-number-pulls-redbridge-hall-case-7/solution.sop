@slots literal
{
  "place": "Redbridge",
  "anchor": 80,
  "firstCount": 18,
  "secondCount": 17,
  "guessWord": "forty",
  "guess": 40,
  "jokeVoice": "Dora",
  "anchoringVoice": "Eli",
  "liveVoice": "Fran",
  "liveAnchor": 80,
