@slots literal
{
  "place": "Little River",
  "anchor": 80,
  "firstCount": 18,
  "secondCount": 17,
  "guessWord": "forty",
  "guess": 40,
  "jokeVoice": "Ben",
  "anchoringVoice": "Cara",
  "liveVoice": "Nia",
  "liveAnchor": 80,
  "liveCount": 18
