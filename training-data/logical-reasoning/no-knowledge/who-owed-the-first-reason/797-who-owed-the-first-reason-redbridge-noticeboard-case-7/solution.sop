@slots literal
{
  "assertor": "Dora",
  "place": "Redbridge",
  "claim": "The well is unsafe.",
  "reporter": "Eli",
  "silence": "Fran"
}

@answer jsEval
const slots = $slots;
const assertor = slots.assertor;
return assertor + ", the assertor. Shifting the burden asks the room to disprove an unsupported claim. Silence is not a premise.";

