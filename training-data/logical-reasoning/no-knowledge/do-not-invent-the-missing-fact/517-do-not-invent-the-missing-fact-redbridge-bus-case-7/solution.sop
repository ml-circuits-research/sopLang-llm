@slots literal
{
  "place": "Redbridge",
  "inventor": "Dora",
  "sticker": "Eli",
  "booster": "Fran"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place of the late bus");
probe(typeof slots.inventor === "string" && slots.inventor.length > 0, "the case must name the speaker who invents the secret crash");
probe(typeof slots.sticker === "string" && slots.sticker.length > 0, "the case must name the speaker who stays with what is listed");
probe(typeof slots.booster === "string" && slots.booster.length > 0, "the case must name the speaker who calls the invention better science");
probe(slots.inventor !== slots.sticker && slots.inventor !== slots.booster && slots.sticker !== slots.booster, "the three speakers must be different people");
return "Listed facts. A secret crash is a new premise. Neatness does not mint facts. " + slots.sticker + " stops where the text stops.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

