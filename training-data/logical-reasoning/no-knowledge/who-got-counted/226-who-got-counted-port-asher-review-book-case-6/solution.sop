@slots literal
{
  "place": "Port Asher",
  "notes": 20,
  "namer": "Ade",
  "census": "Bela",
  "inventor": "Chris"
}

@answer jsEval
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place of the café");
probe(Number.isInteger(slots.notes) && slots.notes >= 2, "the review book must carry a sample of glowing notes");
probe(typeof slots.namer === "string" && slots.namer.length > 0, "the case must name the speaker who asks who bothers to write");
probe(typeof slots.census === "string" && slots.census.length > 0, "the case must name the speaker who treats the notes as a census");
probe(typeof slots.inventor === "string" && slots.inventor.length > 0, "the case must name the speaker who invents the angry novel");
probe(slots.namer !== slots.inventor && slots.namer !== slots.census && slots.census !== slots.inventor, "the three speakers must be three different people");
return "People who liked the café enough, or were polite enough, to write. That is not “everyone.” " + slots.namer + " named the filter. " + slots.inventor + " invented an equal opposite filter the page did not show.";

