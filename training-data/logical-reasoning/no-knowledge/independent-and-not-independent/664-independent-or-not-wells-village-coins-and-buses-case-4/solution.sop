@slots literal
{
  "place": "Wells Village",
  "tosses": 2,
  "streak": 4,
  "dueClaimant": "Harun",
  "independentClaimant": "Iona",
  "luckClaimant": "Ruth"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place holding the card");
probe(Number.isInteger(slots.tosses) && slots.tosses >= 2, "the card must toss its fair coin at least twice");
probe(Number.isInteger(slots.streak) && slots.streak >= 1, "the case must record the run of heads the due claim reads");
probe(typeof slots.dueClaimant === "string" && slots.dueClaimant.length > 0, "the case must name the speaker who calls the coin due");
probe(typeof slots.independentClaimant === "string" && slots.independentClaimant.length > 0, "the case must name the speaker who reads the tosses as independent");
probe(slots.dueClaimant !== slots.independentClaimant && slots.dueClaimant !== slots.luckClaimant && slots.independentClaimant !== slots.luckClaimant, "the three readings of the card must come from three different speakers");
return "The two tosses, as a fair coin on this card. “Due” invents a memory the coin is not given.";

