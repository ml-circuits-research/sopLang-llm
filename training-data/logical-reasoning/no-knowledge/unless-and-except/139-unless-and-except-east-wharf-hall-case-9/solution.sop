@slots literal
{
  "place": "East Wharf",
  "closing": "22:00",
  "cancelledClass": "roof-repair class",
  "warningPosted": false,
  "doubter": "Omar",
  "reader": "Pia",
  "overreach": "Rafi"
}

@answer jsEval
const slots = $slots;
return "Without a posted warning, the hall stays open until " + slots.closing + ". The " + slots.cancelledClass + " is the listed hole. Other classes still run.";

