@slots literal
{
  "place": "East Wharf",
  "successes": 9,
  "trials": 10,
  "deducer": "Omar",
  "climber": "Pia",
  "overhardener": "Rafi",
  "echoedSuccesses": 9,
  "echoedTrials": 10
