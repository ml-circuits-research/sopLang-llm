@slots literal
{
  "place": "Dunwick",
  "successes": 9,
  "trials": 10,
  "deducer": "Sam",
  "climber": "Tess",
  "overhardener": "Owen",
  "echoedSuccesses": 9,
  "echoedTrials": 10
}

@answer jsEval
const slots = $slots;
return "Yes, as practical induction. " + slots.climber + " has the family right. " + slots.overhardener + " over-hardened a climb into a law.";

