@slots literal
{
  "place": "Wells Village",
  "successes": 9,
  "trials": 10,
  "deducer": "Harun",
  "climber": "Iona",
  "overhardener": "Ruth",
  "echoedSuccesses": 9,
  "echoedTrials": 10
}

@answer jsEval
const slots = $slots;
return "Yes, as practical induction. " + slots.climber + " has the family right. " + slots.overhardener + " over-hardened a climb into a law.";

