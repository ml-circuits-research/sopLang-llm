@slots literal
{
  "place": "North Copse",
  "lampNoun": "lamp",
  "neighbourNoun": "lamp",
  "strip": "socket-strip",
  "fitting": "Jules",
  "part": "bulb",
  "rival": "Kat",
  "gridOwner": "town",
  "unlisted": "Ned",
  "unlistedStory": "rare moth jammed a hidden second switch",
  "unlistedAnimal": "moth"
}

@answer jsEval
const slots = $slots;
return slots.fitting + "\u2019s. A dead " + slots.part + " fits a dark " + slots.lampNoun + " beside a working neighbour. A whole-grid failure fights the neighbour " + slots.lampNoun + ". The " + slots.unlistedAnimal + " adds an unlisted engine.";

