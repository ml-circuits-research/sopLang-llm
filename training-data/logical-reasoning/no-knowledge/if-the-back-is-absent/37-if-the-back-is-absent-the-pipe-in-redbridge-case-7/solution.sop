@slots literal
{
  "place": "Redbridge",
  "antecedent": "the street pipe is frozen solid",
  "consequent": "every ground-floor tap gives no water",
  "tapOpener": "Dora",
  "denier": "Eli",
  "overreacher": "Fran"
}

@answer jsEval
const slots = $slots;
return slots.denier + " is forced (modus tollens). " + slots.overreacher + " affirms the back: a dry tap has more than one possible path. The card named one sufficient path to dryness, not the only path.";

