@slots literal
{
  "place": "Port Asher",
  "railWearer": "Ade",
  "homeMade": "Bela",
  "scopeHolder": "Chris"
}

@answer jsEval
const slots = $slots;
return "The rail vest is necessary. A home-made vest fails the named source. Wearing the rail vest is not yet shown to be sufficient. " + slots.scopeHolder + " has the scope right.";

