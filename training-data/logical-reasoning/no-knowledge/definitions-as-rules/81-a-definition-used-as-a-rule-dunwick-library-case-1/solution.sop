@slots literal
{
  "place": "Dunwick",
  "threshold": 6,
  "subject": "Sam",
  "actual": 4,
  "sayer": "Tess",
  "namedBorrower": "Sam",
  "applier": "Owen"
}

@answer jsEval
const slots = $slots;
return "No. " + slots.actual + " is less than " + slots.threshold + ". Carefulness is not a listed substitute. " + slots.applier + " is doing deduction. " + slots.sayer + " is writing a second charter.";

