@slots literal
{
  "place": "Redbridge",
  "cutoffMinutes": 600,
  "lateArrivalMinutes": 670,
  "earlyArrivalMinutes": 560,
  "lateVisitor": "Dora",
  "earlyVisitor": "Eli",
  "doubter": "Fran"
}

@answer jsEval
const slots = $slots;
return slots.lateVisitor + " must sign and wait (modus ponens). " + slots.earlyVisitor + " is not covered by this sentence. An empty lobby is not a written exception.";

