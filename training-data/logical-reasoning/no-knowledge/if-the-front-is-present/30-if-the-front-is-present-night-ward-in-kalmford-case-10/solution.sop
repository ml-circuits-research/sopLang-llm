@slots literal
{
  "place": "Kalmford",
  "cutoffMinutes": 540,
  "lateArrivalMinutes": 610,
  "earlyArrivalMinutes": 500,
  "lateVisitor": "Sol",
  "earlyVisitor": "Una",
  "doubter": "Wes"
}

@answer jsEval
const slots = $slots;
return slots.lateVisitor + " must sign and wait (modus ponens). " + slots.earlyVisitor + " is not covered by this sentence. An empty lobby is not a written exception.";

