@slots literal
{
  "place": "Wells Village",
  "cutoffMinutes": 660,
  "lateArrivalMinutes": 730,
  "earlyArrivalMinutes": 620,
  "lateVisitor": "Harun",
  "earlyVisitor": "Iona",
  "doubter": "Ruth"
}

@answer jsEval
const slots = $slots;
return slots.lateVisitor + " must sign and wait (modus ponens). " + slots.earlyVisitor + " is not covered by this sentence. An empty lobby is not a written exception.";

