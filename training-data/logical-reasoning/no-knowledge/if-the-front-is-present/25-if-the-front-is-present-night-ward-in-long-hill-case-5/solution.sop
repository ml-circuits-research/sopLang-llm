@slots literal
{
  "place": "Long Hill",
  "cutoffMinutes": 480,
  "lateArrivalMinutes": 550,
  "earlyArrivalMinutes": 440,
  "lateVisitor": "Leo",
  "earlyVisitor": "Mira",
  "doubter": "Quinn"
}

@answer jsEval
const slots = $slots;
return slots.lateVisitor + " must sign and wait (modus ponens). " + slots.earlyVisitor + " is not covered by this sentence. An empty lobby is not a written exception.";

