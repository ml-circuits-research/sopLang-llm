@slots literal
{
  "place": "East Wharf",
  "arrowSpeaker": "Omar",
  "exposure": "tea",
  "outcome": "headaches",
  "driverSpeaker": "Pia",
  "driver": "heat",
  "lifted": [
    "thirst",
    "headaches"
  ],
  "coincidenceSpeaker": "Rafi"
