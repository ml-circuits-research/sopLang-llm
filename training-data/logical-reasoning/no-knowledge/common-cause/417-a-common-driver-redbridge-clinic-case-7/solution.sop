@slots literal
{
  "place": "Redbridge",
  "arrowSpeaker": "Dora",
  "exposure": "tea",
  "outcome": "headaches",
  "driverSpeaker": "Eli",
  "driver": "heat",
  "lifted": [
    "thirst",
    "headaches"
  ],
  "coincidenceSpeaker": "Fran"
}

@answer jsEval
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place of the clinic table");
probe(typeof slots.driver === "string" && slots.driver.length > 0, "the case must name the driver the second reading offers");
probe(typeof slots.exposure === "string" && slots.exposure.length > 0, "the case must name the exposure the first reading blames");
probe(slots.lifted.indexOf(slots.outcome) >= 0, "the driver claim must cover the symptom the arrow claim blames");
probe(slots.exposure !== slots.driver, "the blamed exposure and the named driver must be different");
return "A common driver — " + slots.driver + " — sitting behind both rises. " + slots.exposure.charAt(0).toUpperCase() + slots.exposure.slice(1) + "-as-cause is a jump.";

