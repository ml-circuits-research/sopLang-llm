@slots literal
{
  "claims": [
    {
      "name": "Ade",
      "stance": "affirm-back"
    },
    {
      "name": "Bela",
      "stance": "rival-path"
    },
    {
      "name": "Chris",
      "stance": "affirm-back"
    }
  ]
}

@answer jsEval
const slots = $slots;
const affirmers = slots.claims.filter((claim) => claim.stance === "affirm-back").map((claim) => claim.name);
return "No. " + affirmers.join(" and ") + " affirm the back. The card gives rain as one sufficient path, not the only path.";

