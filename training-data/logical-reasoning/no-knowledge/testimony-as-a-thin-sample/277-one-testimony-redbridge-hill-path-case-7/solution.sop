@slots literal
{
  "witness": "Dora",
  "village": "Redbridge",
  "echoed": "Dora",
  "critic": "Eli",
  "third": "Fran"
}

@answer jsEval
const slots = $slots;
return "That " + slots.witness + " slipped once last March on that path. It does not by itself support \u201calways icy in March.\u201d";

