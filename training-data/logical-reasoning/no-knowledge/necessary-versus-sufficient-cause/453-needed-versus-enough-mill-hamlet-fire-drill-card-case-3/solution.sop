@slots literal
{
  "place": "Mill Hamlet",
  "cluster": [
    "fuel",
    "oxygen",
    "heat"
  ],
  "trigger": "match",
  "damp": "fuel",
  "withheld": "airflow",
  "sufficiencySpeaker": "Farid",
  "claimedFactor": "match",
  "triggerPlural": "matches",
  "clusterSpeaker": "Gina",
  "irrelevanceSpeaker": "Pavel",
  "missingFactor": "oxygen",
  "triggerPresent": "match"
}

@answer jsEval
const slots = $slots;
const cluster = slots.cluster;
return "No. The card listed a cluster. " + (/^[aeiou]/.test(slots.trigger) ? "An " : "A ") + slots.trigger + " is one factor. Necessary pieces of a cluster are not each sufficient.";

