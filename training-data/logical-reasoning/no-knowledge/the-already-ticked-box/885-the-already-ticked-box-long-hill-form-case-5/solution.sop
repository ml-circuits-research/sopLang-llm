@slots literal
{
  "place": "Long Hill",
  "option": "renew each year",
  "keeper": "Leo",
  "asker": "Mira",
  "subject": "renewal",
  "naturalist": "Quinn"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place where the form arrives");
probe(typeof slots.option === "string" && slots.option.length > 0, "the case must quote the option that arrives ticked");
probe(typeof slots.subject === "string" && slots.subject.length > 0, "the case must name the choice the tick stands for");
probe(typeof slots.keeper === "string" && slots.keeper.length > 0, "the case must name the person who leaves the tick");
probe(typeof slots.asker === "string" && slots.asker.length > 0, "the case must name the voice that asks about a blank form");
probe(typeof slots.naturalist === "string" && slots.naturalist.length > 0, "the case must name the voice that calls defaults nature");
probe(slots.asker !== slots.naturalist, "the two voices must be different people");
return "Status quo / default. Nature did not mark the box. Answer as if both boxes started empty.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

