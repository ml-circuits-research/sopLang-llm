@slots literal
{
  "town": "Long Hill",
  "mapper": "Leo",
  "wetness": "Mira",
  "third": "Quinn"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.town === "string" && slots.town.length > 0, "the case must name the town of the lesson");
probe(typeof slots.mapper === "string" && slots.mapper.length > 0, "the case must name the speaker who draws the mapping");
probe(typeof slots.wetness === "string" && slots.wetness.length > 0, "the case must name the speaker who transfers the wetness");
probe(slots.mapper !== slots.wetness && slots.mapper !== slots.third && slots.wetness !== slots.third, "the case must name three different speakers");
return "The structure: break the path, the working stops. Wetness is decorative.";
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

