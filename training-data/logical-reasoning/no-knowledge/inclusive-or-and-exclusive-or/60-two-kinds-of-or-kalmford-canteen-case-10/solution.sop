@slots literal
{
  "place": "Kalmford",
  "inclusiveSides": [
    "SOUP",
    "SALAD"
  ],
  "exclusiveSides": [
    "MEAT",
    "FISH"
  ],
  "pairTaker": "Sol",
  "takenPair": [
    "SOUP",
    "SALAD"
  ],
  "bothAsker": "Una",
  "askedPair": [
    "MEAT",
    "FISH"
  ],
  "reader": "Wes"
}

@answer jsEval
const slots = $slots;
const samePair = (left, right) => left[0] === right[0] && left[1] === right[1];
return slots.reader + ". Sign One is inclusive. Sign Two is exclusive. The word takes the sense the sentence writes.";

