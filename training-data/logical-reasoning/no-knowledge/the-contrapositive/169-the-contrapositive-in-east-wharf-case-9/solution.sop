@slots literal
{
  "contrapositive": "Omar",
  "converse": "Pia",
  "bystander": "Rafi"
}

@answer jsEval
const slots = $slots;
return "Only " + slots.contrapositive + "\u2019s twin \u2014 the contrapositive. " + slots.converse + " wrote the converse, a new claim. Wetness can arrive by a street-cleaning truck.";

