@slots literal
{
  "place": "Port Asher",
  "engine": "tilt",
  "rival": "distance",
  "lamp": "tilted lamp",
  "supporter": "Ade",
  "taught": "tilt",
  "preferrer": "Bela",
  "denier": "Chris"
