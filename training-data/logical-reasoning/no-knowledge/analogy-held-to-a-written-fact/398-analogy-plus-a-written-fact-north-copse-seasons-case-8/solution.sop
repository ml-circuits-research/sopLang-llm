@slots literal
{
  "place": "North Copse",
  "engine": "tilt",
  "rival": "distance",
  "lamp": "tilted lamp",
  "supporter": "Jules",
  "taught": "tilt",
  "preferrer": "Kat",
  "denier": "Ned"
