@slots literal
{
  "place": "Little River",
  "engine": "tilt",
  "rival": "distance",
  "lamp": "tilted lamp",
  "supporter": "Ben",
  "taught": "tilt",
  "preferrer": "Cara",
  "denier": "Nia"
