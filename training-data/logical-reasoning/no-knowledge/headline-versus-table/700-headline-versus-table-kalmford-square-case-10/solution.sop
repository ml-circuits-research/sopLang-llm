@slots literal
{
  "place": "Kalmford",
  "claim": "MARKET PROVES SALES DOUBLED.",
  "multiple": 2,
  "lastMonth": 40,
  "thisMonth": 42,
  "headlineClaimant": "Sol",
  "tableClaimant": "Una",
  "singClaimant": "Wes"
}

@answer jsEval
const slots = $slots;
const claimed = slots.lastMonth * slots.multiple;
return "The table. Double of " + slots.lastMonth + " would be " + claimed + ". " + slots.thisMonth + " is a small rise.";

