@slots literal
{
  "place": "North Copse",
  "object": "banner",
  "firstHour": "noon",
  "secondHour": "15:00",
  "outcome": "shower",
  "cause": "Jules",
  "causeObject": "banner",
  "causeOutcome": "shower",
  "sequence": "Kat",
  "remedy": "Ned",
  "remedyObject": "banner"
}

@answer jsEval
const slots = $slots;
return "None about the " + slots.object + " and the " + slots.outcome + ". A later event can follow anything you hung at " + slots.firstHour + ".";

