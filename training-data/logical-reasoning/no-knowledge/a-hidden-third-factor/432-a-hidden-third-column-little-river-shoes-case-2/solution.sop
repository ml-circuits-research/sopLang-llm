@slots literal
{
  "place": "Little River",
  "purchase": "running shoes",
  "outcome": "kilometres",
  "causalSpeaker": "Ben",
  "purchasedThing": "shoes",
  "causalOutcome": "kilometres",
  "confoundSpeaker": "Cara",
  "traitAdjective": "keen",
  "traitNoun": "runner",
  "factorThing": "shoes",
  "factorOutcome": "kilometres",
  "priceSpeaker": "Nia"
}

@answer jsEval
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the place of the shop notes");
probe(typeof slots.traitAdjective === "string" && slots.traitAdjective.length > 0, "the case must name the trait of the confound reading");
probe(typeof slots.traitNoun === "string" && slots.traitNoun.length > 0, "the case must name the person the trait describes");
probe(slots.causalOutcome === slots.outcome && slots.factorOutcome === slots.outcome, "every reading must log the same outcome the notes report");
probe(slots.purchase.slice(-slots.purchasedThing.length) === slots.purchasedThing && slots.factorThing === slots.purchasedThing, "the causal reading and the confound reading must name the same purchase");
return slots.traitAdjective.charAt(0).toUpperCase() + slots.traitAdjective.slice(1) + "ness can sit behind both columns. The table as written does not separate help from selection.";

