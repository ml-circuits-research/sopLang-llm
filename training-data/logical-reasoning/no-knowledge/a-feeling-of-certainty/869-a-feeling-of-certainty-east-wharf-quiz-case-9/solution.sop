@slots literal
{
  "place": "East Wharf",
  "person": "Omar",
  "total": 6,
  "right": 2,
  "tracker": "Pia",
  "selfProver": "Rafi"
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
const slots = $slots;
probe(typeof slots.place === "string" && slots.place.length > 0, "the case must name the quiz place");
probe(typeof slots.person === "string" && slots.person.length > 0, "the case must name the person who is extremely sure");
probe(typeof slots.tracker === "string" && slots.tracker.length > 0, "the case must name the voice that distrusts the feeling");
probe(typeof slots.selfProver === "string" && slots.selfProver.length > 0, "the case must name the voice that treats certainty as self-proving");
probe(slots.tracker !== slots.selfProver, "the two voices must be different people");
probe(Number.isInteger(slots.total) && slots.total > 0, "the sure record must list a positive number of times");
probe(Number.isInteger(slots.right) && slots.right >= 0, "the sure record must list a non-negative number of right calls");
probe(slots.right < slots.total, "the record must be short of certainty for the feeling to be weak evidence");
return "A nervous-system state. On this record it is weak evidence of accuracy (" + slots.right + " of " + slots.total + ").";

