@slots literal
{
  "place": "East Wharf",
  "observedPage": "A",
  "observedSubject": "evening tea",
  "observedOutcome": "easier nights",
  "assignedPage": "B",
  "assignedSubject": "tea",
  "assignedCount": 100,
  "restCount": 100,
  "measure": "rate",
  "equate": "Omar",
  "equatedLeft": "A",
  "equatedRight": "B",
  "design": "Pia",
  "leakyPage": "A",
  "betterPage": "B",
  "designSubject": "tea",
  "unnatural": "Rafi"
}

@answer jsEval
const slots = $slots;
return "Page " + slots.assignedPage + ", as written. Page " + slots.observedPage + " observes choosers. Design, not sincerity, is the difference.";

