@slots literal
{
  "layers": [
    "A",
    "B",
    "C",
    "D"
  ],
  "dated": [
    {
      "layer": "D",
      "year": 1320
    },
    {
      "layer": "C",
      "year": 1510
    },
    {
      "layer": "B",
      "year": 1680
    }
  ],
  "compared": [
    "C",
    "B"
  ],
  "askedLayer": "A",
  "crossDomain": null
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const describeCrossDomain = function describeCrossDomain(check) {
  if (check.kind === 'distance') {
    return `${check.centimetres * check.kilometresPerCentimetre} km.`;
  }
  if (check.kind === 'time') {
    const minutes = check.startHour * 60 + check.startMinute + check.hours * 60;
    const hour = String(Math.floor(minutes / 60)).padStart(2, '0');
    const minute = String(minutes % 60).padStart(2, '0');
    return `${hour}:${minute}.`;
  }
  if (check.kind === 'quorum') {
    return check.present >= check.threshold ? 'quorum is met.' : 'quorum is not met.';
  }
  if (check.kind === 'reports') {
    return `${check.total - check.duplicates} independent reports.`;
  }
  if (check.kind === 'sheets') {
    return `${check.start + check.received} map sheets.`;
  }
  throw new Error(`Unknown cross-domain check "${check.kind}".`);
};
const renderCrossDomain = function renderCrossDomain(checks) {
  if (checks === null || checks === undefined || checks.length === 0) {
    return '';
  }
  const parts = checks.map((check, index) => {
    const label = index === 1 ? 'Mixed-domain answer:' : 'Cross-domain answer:';
    return `${label} ${describeCrossDomain(check)}`;
  });
  return parts.join(' ');
};
const slots = $slots;
probe(Array.isArray(slots.layers) && slots.layers.length >= 3, "the statement must list the layers of an undisturbed sequence");
probe(Array.isArray(slots.compared) && slots.compared.length === 2, "the task must compare two named layers");
const left = slots.compared[0];
const right = slots.compared[1];
const leftDepth = slots.layers.indexOf(left);
const rightDepth = slots.layers.indexOf(right);
probe(leftDepth >= 0 && rightDepth >= 0, "both compared layers must appear in the stated sequence");
probe(leftDepth !== rightDepth, "the two compared layers must occupy different positions in the sequence");
const aged = slots.dated || [];
probe(Array.isArray(aged), "the dated objects of the layers must be a list");
const asksForYear = aged.some((item) => item.layer === slots.askedLayer);
probe(!asksForYear, "the asked layer must have no stated dated object, which is what makes its exact year undeducible");
const older = leftDepth > rightDepth ? left : right;
const younger = older === left ? right : left;
const main = "Layer " + older + " is older than Layer " + younger + ". The exact deposition year of Layer " + slots.askedLayer + " cannot be deduced.";
const suffix = renderCrossDomain(slots.crossDomain);
return suffix === "" ? main : main + " " + suffix;
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

