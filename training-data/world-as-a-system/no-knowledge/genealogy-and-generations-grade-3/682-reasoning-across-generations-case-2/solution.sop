@slots literal
{
  "links": [
    {
      "parent": "Maya",
      "child": "Noah"
    },
    {
      "parent": "Noah",
      "child": "Lina"
    },
    {
      "parent": "Maya",
      "child": "Owen"
    },
    {
      "parent": "Owen",
      "child": "Sara"
    }
  ],
  "subject": "Noah",
  "object": "Lina",
  "crossDomain": [
    {
      "kind": "quorum",
      "members": 15,
      "threshold": 8,
      "present": 14
    }
  ]
}

@cross jsEval
const describeCrossDomain = function describeCrossDomain(check) {
  if (check.kind === 'distance') {
    return `${check.centimetres * check.kilometresPerCentimetre} km.`;
  }
  if (check.kind === 'time') {
    const minutes = check.startHour * 60 + check.startMinute + check.hours * 60;
    const hour = String(Math.floor(minutes / 60)).padStart(2, '0');
    const minute = String(minutes % 60).padStart(2, '0');
    return `${hour}:${minute}.`;
  }
  if (check.kind === 'quorum') {
    return check.present >= check.threshold ? 'quorum is met.' : 'quorum is not met.';
  }
  if (check.kind === 'reports') {
    return `${check.total - check.duplicates} independent reports.`;
  }
  if (check.kind === 'sheets') {
    return `${check.start + check.received} map sheets.`;
  }
  throw new Error(`Unknown cross-domain check "${check.kind}".`);
};
const renderCrossDomain = function renderCrossDomain(checks) {
  if (checks === null || checks === undefined || checks.length === 0) {
    return '';
  }
  const parts = checks.map((check, index) => {
    const label = index === 1 ? 'Mixed-domain answer:' : 'Cross-domain answer:';
    return `${label} ${describeCrossDomain(check)}`;
  });
  return parts.join(' ');
};
const slots = $slots;
return { suffix: renderCrossDomain(slots.crossDomain) };

@family jsEval
const slots = $slots;
const parents = new Map();
const children = new Map();
for (const link of slots.links) {
  if (!parents.has(link.child)) { parents.set(link.child, new Set()); }
  parents.get(link.child).add(link.parent);
  if (!children.has(link.parent)) { children.set(link.parent, new Set()); }
  children.get(link.parent).add(link.child);
}
return { parents, children };

@descendants jsEval
const slots = $slots;
const parents = $family.parents;
const children = $family.children;
const left = slots.subject, right = slots.object;
const leftParents = parents.get(left) || new Set(), rightParents = parents.get(right) || new Set();
const grandkids = (person) => {
  const result = new Set();
  for (const child of children.get(person) || []) {
    for (const grand of children.get(child) || []) { result.add(grand); }
  }
  return result;
};
const siblings = [...leftParents].some((p) => rightParents.has(p));
return { left, right, leftParents, rightParents, leftGrandchildren: grandkids(left), rightGrandchildren: grandkids(right), siblings };

@cousins jsEval
const parents = $family.parents;
const leftParents = $descendants.leftParents, rightParents = $descendants.rightParents;
const ancestors = (personSet) => {
  const result = new Set();
  for (const p of personSet) {
    for (const g of parents.get(p) || []) { result.add(g); }
  }
  return result;
};
const cousins = [...ancestors(leftParents)].some((g) => ancestors(rightParents).has(g));
return { cousins };

@relation jsEval
const left = $descendants.left, right = $descendants.right;
const d = $descendants;
let relation = null;
if (d.leftParents.has(right)) { relation = right + " is a parent of " + left + "."; }
else if (d.rightParents.has(left)) { relation = left + " is a parent of " + right + "."; }
else if (d.leftGrandchildren.has(right)) { relation = left + " is a grandparent of " + right + "."; }
else if (d.rightGrandchildren.has(left)) { relation = right + " is a grandparent of " + left + "."; }
else if (d.siblings) { relation = left + " and " + right + " are siblings."; }
else if ($cousins.cousins) { relation = left + " and " + right + " are cousins under the implied family tree."; }
probe(relation !== null, "the stated links must determine the relation between the two named people");
return relation;

@answer jsEval
const relation = $relation;
return $cross.suffix === "" ? relation : relation + " " + $cross.suffix;

