    },
    {
      "name": "Tool C",
      "start": 1700,
      "end": 2000
    },
    {
      "name": "Practice D",
      "start": 1300,
      "end": 1450
    }
  ],
  "year": 1400,
  "mentioned": [
    "Technology A",
    "Tool C"
  ],
