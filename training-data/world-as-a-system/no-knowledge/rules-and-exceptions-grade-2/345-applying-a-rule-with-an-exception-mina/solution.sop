@slots literal
{
  "name": "Mina",
  "age": 15,
  "minimumAge": 12,
  "permit": true,
  "drill": true
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
const slots = $slots;
probe(typeof slots.name === "string" && slots.name.length > 0, "the statement must name the person the rule is applied to");
probe(typeof slots.age === "number" && Number.isInteger(slots.age) && slots.age >= 0, "the person must have a stated whole-number age");
probe(typeof slots.minimumAge === "number" && Number.isInteger(slots.minimumAge) && slots.minimumAge >= 0, "the rule must state a whole-number minimum age");
probe(typeof slots.permit === "boolean", "the statement must state whether the adult permit is present");
probe(typeof slots.drill === "boolean", "the statement must state whether an evacuation drill is active");
const ageCondition = slots.age >= slots.minimumAge;
const allowed = !slots.drill && ageCondition && slots.permit;
return allowed ? "Yes, " + slots.name + " may enter." : "No, " + slots.name + " may not enter.";

