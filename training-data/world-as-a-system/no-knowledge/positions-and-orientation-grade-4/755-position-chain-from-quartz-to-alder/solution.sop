@slots literal
{
  "origin": "Quartz",
  "target": "Alder",
  "relations": [
    {
      "place": "Yarrow",
      "units": 1,
      "direction": "north",
      "reference": "Quartz"
    },
    {
      "place": "Kite",
      "units": 1,
      "direction": "east",
      "reference": "Yarrow"
    },
    {
      "place": "Grove",
      "units": 1,
      "direction": "south",
      "reference": "Kite"
    },
    {
      "place": "Alder",
      "units": 1,
      "direction": "west",
      "reference": "Grove"
    }
  ],
  "irrelevantFact": true
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.origin === "string" && slots.origin.length > 0, "the origin of the relation chain must be named");
probe(typeof slots.target === "string" && slots.target.length > 0, "the target of the relation chain must be named");
probe(Array.isArray(slots.relations) && slots.relations.length > 0, "the statement must state at least one relative move");
const vectors = { east: [1, 0], west: [-1, 0], north: [0, 1], south: [0, -1] };
const adjacency = new Map();
const link = (from, to, vector) => {
  if (!adjacency.has(from)) {
    adjacency.set(from, []);
  }
  adjacency.get(from).push({ to, vector });
};
for (const relation of slots.relations) {
  const vector = vectors[relation.direction];
  probe(vector !== undefined, "every stated direction must be one of east, west, north, south");
  const step = [vector[0] * relation.units, vector[1] * relation.units];
  link(relation.place, relation.reference, [-step[0], -step[1]]);
  link(relation.reference, relation.place, step);
}
const seen = new Set([slots.origin]);
const queue = [{ name: slots.origin, position: [0, 0] }];
let position = null;
while (queue.length > 0 && position === null) {
  const current = queue.shift();
  if (current.name === slots.target) {
    position = current.position;
    break;
  }
  for (const edge of adjacency.get(current.name) || []) {
    if (seen.has(edge.to)) {
      continue;
    }
    seen.add(edge.to);
    queue.push({ name: edge.to, position: [current.position[0] + edge.vector[0], current.position[1] + edge.vector[1]] });
  }
}
probe(position !== null, "the target must be reachable from the origin through the stated moves");
const dx = position[0];
const dy = position[1];
const vertical = dy > 0 ? "north" : dy < 0 ? "south" : "";
const horizontal = dx > 0 ? "east" : dx < 0 ? "west" : "";
const phrase = dx === 0 && dy === 0 ? "the same position of" : vertical !== "" && horizontal !== "" ? vertical + "-" + horizontal + " of" : vertical + horizontal + " of";
const where = slots.target + " is " + phrase + " " + slots.origin + "; grid displacement " + (Math.abs(dx) + Math.abs(dy)) + " unit(s).";
return slots.irrelevantFact ? where + " The museum fact is irrelevant." : where;
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

