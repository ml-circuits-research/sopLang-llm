@slots literal
{
  "name": "Leo",
  "age": 14,
  "minimumAge": 11,
  "permit": true,
  "drill": true
}

@answer jsEval
const slots = $slots;
const ageCondition = slots.age >= slots.minimumAge;
const allowed = !slots.drill && ageCondition && slots.permit;
return allowed ? "Yes, " + slots.name + " may enter." : "No, " + slots.name + " may not enter.";

