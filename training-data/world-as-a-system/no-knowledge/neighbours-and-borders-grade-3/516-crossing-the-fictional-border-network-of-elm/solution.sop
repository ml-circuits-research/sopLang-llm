@slots literal
{
  "states": [
    "Elm",
    "Kite",
    "Willow",
    "Stone",
    "Oak",
    "Fern"
  ],
  "pairs": [
    [
      "Elm",
      "Kite"
    ],
    [
      "Kite",
      "Willow"
    ],
    [
      "Willow",
      "Stone"
    ],
    [
      "Elm",
      "Oak"
    ],
    [
      "Oak",
      "Fern"
    ],
    [
      "Fern",
      "Stone"
    ]
  ],
  "from": "Elm",
  "to": "Stone",
  "candidate": "Kite"
}

@adjacency jsEval
const slots = $slots;
const adjacency = {};
for (const pair of slots.pairs) {
  const left = pair[0];
  const right = pair[1];
  if (!adjacency[left]) {
    adjacency[left] = [];
  }
  if (!adjacency[right]) {
    adjacency[right] = [];
  }
  adjacency[left].push(right);
  adjacency[right].push(left);
}
return adjacency;

@reach jsEval
const distances = new Map([[ $slots.from, 0 ]]);
const queue = [$slots.from];
while (queue.length > 0) {
  const state = queue.shift();
  for (const neighbour of $adjacency[state] ?? []) {
    if (!distances.has(neighbour)) {
      distances.set(neighbour, distances.get(state) + 1);
      queue.push(neighbour);
    }
  }
}
return distances;

@distance jsEval
const found = $reach.has($slots.to);
probe(found, "the stated borders must connect the two endpoints of the crossing question");
return $reach.get($slots.to);

@unavoidable jsEval
const visited = new Set([$slots.from]);
const queue = [$slots.from];
while (queue.length > 0) {
  const state = queue.shift();
  for (const neighbour of $adjacency[state] ?? []) {
    if (neighbour !== $slots.candidate && !visited.has(neighbour)) {
      visited.add(neighbour);
      queue.push(neighbour);
    }
  }
}
return visited.has($slots.to);

@answer jsEval
return $distance + " border crossing(s); " + $slots.candidate + ($unavoidable ? " is not unavoidable." : " is unavoidable.");

