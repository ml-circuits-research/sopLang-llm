@slots literal
{
  "asker": "Hugo",
  "place": "Little River",
  "friends": 4,
  "yes": 3,
  "announcedPercent": 75,
  "declaredRepresentative": false
}

@answer jsEval
const slots = $slots;
const legitPercent = slots.yes + "/" + slots.friends;
return legitPercent + " of these friends, not of the country.";

