@slots literal
{
  "person": "Ned",
  "amount": 70,
  "saidAmount": 70,
  "vignetteText": "Ned paid 70 for a poor course and stays “so as not to lose 70”, although the remaining hours do not bring the money back, the text says.",
  "definitions": [
    {
      "label": "confirmation",
      "definition": "you hunt only proof you are right"
    },
    {
      "label": "anchor",
      "definition": "the first price seen pulls the estimate"
    },
    {
      "label": "sunk cost",
      "definition": "you continue because “I already put money in”"
    }
  ]
}

@answer jsEval
const slots = $slots;
const trap = slots.definitions.find((entry) => /already put money in/.test(entry.definition));
const label = trap.label.charAt(0).toUpperCase() + trap.label.slice(1);
const answer = label + ". The " + slots.amount + " are gone on both branches. The next hour is a new cost of time.";
return answer;

