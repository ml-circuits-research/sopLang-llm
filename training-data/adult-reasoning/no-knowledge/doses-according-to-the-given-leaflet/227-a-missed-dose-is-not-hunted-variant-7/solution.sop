@slots literal
{
  "adultDoseMl": 10,
  "adultIntervalHours": 8,
  "adultMaxDoses": 3,
  "adultMaxMl": 30,
  "person": "Sam",
  "age": 34,
  "weightKg": 78,
  "takenMl": 10,
  "takenAt": "07:00",
  "missedAt": "15:00",
  "askAt": "19:30",
  "wantedMl": 20
}

@answer jsEval
const slots = $slots;
return "At most " + slots.adultDoseMl + " ml (not " + slots.wantedMl + "). Weight is not a parameter of the adult schedule.";

