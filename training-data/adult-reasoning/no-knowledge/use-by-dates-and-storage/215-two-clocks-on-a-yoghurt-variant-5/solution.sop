@answer jsEval
const slots = $slots;
const ordinal = (value) => {
  const rest = value % 100;
  if (rest >= 11 && rest <= 13) return value + "th";
  if (value % 10 === 1) return value + "st";
  if (value % 10 === 2) return value + "nd";
  if (value % 10 === 3) return value + "rd";
  return value + "th";
};
const windowEndDay = slots.opened.day + slots.openWindowDays - 1;
const expiresFirst = Math.min(slots.sealed.day, windowEndDay);
return "No. Opened on the " + ordinal(slots.opened.day) + " → window " + slots.opened.day + "–" + windowEndDay + " (" + slots.openWindowDays + " days). The 20th/21st overruns both the sealed date (" + slots.sealed.day + ") and the open window.";

