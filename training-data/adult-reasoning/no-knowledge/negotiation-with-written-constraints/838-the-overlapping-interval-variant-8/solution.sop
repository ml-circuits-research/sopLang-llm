@slots literal
{
  "seller": "Elena",
  "buyer": "Farid",
  "floor": 470,
  "ceiling": 520,
  "oneObject": true,
  "cashToday": true
}

@answer jsEval
const slots = $slots;
const middle = (slots.floor + slots.ceiling) / 2;
return "Yes, [" + slots.floor + ", " + slots.ceiling + "]. Example: " + middle + " cash today.";

