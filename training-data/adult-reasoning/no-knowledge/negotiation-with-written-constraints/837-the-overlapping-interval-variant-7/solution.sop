@slots literal
{
  "seller": "Ann",
  "buyer": "Ben",
  "floor": 460,
  "ceiling": 510,
  "oneObject": true,
  "cashToday": true
}

@answer jsEval
const slots = $slots;
const middle = (slots.floor + slots.ceiling) / 2;
return "Yes, [" + slots.floor + ", " + slots.ceiling + "]. Example: " + middle + " cash today.";

