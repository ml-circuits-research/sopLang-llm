@slots literal
{
  "seller": "Ines",
  "buyer": "Jules",
  "floor": 480,
  "ceiling": 530,
  "oneObject": true,
  "cashToday": true
}

@answer jsEval
const slots = $slots;
const middle = (slots.floor + slots.ceiling) / 2;
return "Yes, [" + slots.floor + ", " + slots.ceiling + "]. Example: " + middle + " cash today.";

