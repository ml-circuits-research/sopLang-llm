@slots literal
{
  "seller": "Rita",
  "buyer": "Sam",
  "floor": 450,
  "ceiling": 500,
  "oneObject": true,
  "cashToday": true
}

@answer jsEval
const slots = $slots;
const middle = (slots.floor + slots.ceiling) / 2;
return "Yes, [" + slots.floor + ", " + slots.ceiling + "]. Example: " + middle + " cash today.";

