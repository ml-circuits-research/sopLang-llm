@slots literal
{
  "placer": "Jules",
  "placerAlone": true,
  "witness": "Jules",
  "waiting": "Kara",
  "opener": "Leo",
  "asker": "Kara",
  "askedAbout": "Leo",
  "denier": "Jules"
}

@answer jsEval
const slots = $slots;
return slots.placer + " and " + slots.opener + " know. " + slots.waiting + " does not. " + slots.placer + " did not see " + slots.opener + "\u2019s act and said \u201Cnobody\u201D.";

