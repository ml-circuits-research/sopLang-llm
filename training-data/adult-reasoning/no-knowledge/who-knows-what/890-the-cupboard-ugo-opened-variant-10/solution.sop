@slots literal
{
  "placer": "Sam",
  "placerAlone": true,
  "witness": "Sam",
  "waiting": "Tess",
  "opener": "Ugo",
  "asker": "Tess",
  "askedAbout": "Ugo",
  "denier": "Sam"
}

@answer jsEval
const slots = $slots;
return slots.placer + " and " + slots.opener + " know. " + slots.waiting + " does not. " + slots.placer + " did not see " + slots.opener + "\u2019s act and said \u201Cnobody\u201D.";

