@slots literal
{
  "placer": "Farid",
  "placerAlone": true,
  "witness": "Farid",
  "waiting": "Gina",
  "opener": "Hugo",
  "asker": "Gina",
  "askedAbout": "Hugo",
  "denier": "Farid"
}

@answer jsEval
const slots = $slots;
return slots.placer + " and " + slots.opener + " know. " + slots.waiting + " does not. " + slots.placer + " did not see " + slots.opener + "\u2019s act and said \u201Cnobody\u201D.";

