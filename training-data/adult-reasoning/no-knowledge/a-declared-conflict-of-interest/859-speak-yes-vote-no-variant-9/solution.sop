@slots literal
{
  "place": "Harbour Town",
  "member": "Tess",
  "soldItem": "paint",
  "votedTopic": "paint firm",
  "interestMatchesTopic": true
}

@answer jsEval
const slots = $slots;
const voteClause = slots.interestMatchesTopic ? "Does not vote." : "May vote.";
return voteClause + " May speak.";

