@slots literal
{
  "first": {
    "name": "Ann",
    "north": 200,
    "east": 100
  },
  "second": {
    "name": "Ben",
    "north": 200,
    "east": 100
  },
  "town": "Maple Ward",
  "gridWithoutDiagonals": true
}

@answer jsEval
const slots = $slots;
probe(typeof slots.first === "object" && slots.first !== null, "the case must describe the first walker");
probe(typeof slots.second === "object" && slots.second !== null, "the case must describe the second walker");
probe(slots.first.name !== slots.second.name, "the two walkers must be different people");
probe(slots.first.north > 0 && slots.first.east > 0, "both legs of the first walk must be positive distances");
probe(slots.second.north > 0 && slots.second.east > 0, "both legs of the second walk must be positive distances");
probe(slots.gridWithoutDiagonals === true, "the statement must place the walks on a grid without diagonals");
probe(slots.first.north === slots.second.north && slots.first.east === slots.second.east, "the two walks must cover the same north and east distances in the opposite order");
return "Yes. On a grid, north " + slots.first.north + " + east " + slots.first.east + " = east " + slots.second.east + " + north " + slots.second.north + ".";

