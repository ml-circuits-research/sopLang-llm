@slots literal
{
  "messages": [
    {
      "id": "M1",
      "text": "Maybe we’ll sort that thing sometime.",
      "missing": [
        "time",
        "place",
        "precise object",
        "refusal channel"
      ]
    },
    {
      "id": "M2",
      "text": "Thursday 18:00, door 3, bring the short key. If you can’t, write by Wednesday 12:00.",
      "missing": []
    }
  ]
}

@answer jsEval
const slots = $slots;
const actionable = slots.messages.find((message) => message.missing.length === 0);
const vague = slots.messages.find((message) => message.missing.length > 0);
return actionable.id + " yes. " + vague.id + ": no " + vague.missing.join(", ") + ".";

