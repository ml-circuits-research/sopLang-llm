@slots literal
{
  "actor": "Olga",
  "lightTravelsStraight": true,
  "shadowRequiresLight": true,
  "screenOpaque": true,
  "screenBetween": true,
  "shadowVanishes": true,
  "believesMovedIntoBook": true
}

@answer jsEval
const probe = (condition, message) => { if (!condition) { throw new Error("probe failed: " + message); } };
probe(typeof $slots === "object" && $slots !== null && !Array.isArray($slots), "the compiled slots wire must carry an object");
probe(Object.keys($slots).length > 0, "the compiled slots wire must not be empty");
const answer = await (async () => {
const slots = $slots;
probe(typeof slots.actor === "string" && slots.actor.length > 0, "the case must name the actor");
probe(/^[A-Z][a-z]+$/.test(slots.actor), "the actor must be a plain capitalised name");
probe(slots.lightTravelsStraight === true, "the sheet must keep light straight in uniform air");
probe(slots.shadowRequiresLight === true, "the sheet must require the object to be lit");
probe(slots.screenOpaque === true && slots.screenBetween === true, "the case must put an opaque screen between lamp and mug");
probe(slots.shadowVanishes === true, "the case must report that the mug shadow vanished");
const mugLit = !(slots.screenOpaque && slots.screenBetween);
const litClause = slots.shadowRequiresLight && !mugLit
  ? "The mug is no longer lit."
  : "The mug is still in the light of the lamp.";
const screenClause = slots.screenOpaque
  ? "The book has its own shadow; the mug sits in it."
  : "The book lets the light through, so the mug keeps its own shadow.";
const returnClause = slots.lightTravelsStraight
  ? "Without the book, the mug’s shadow returns in a straight line."
  : "Without the book, the mug’s shadow returns.";
return litClause + " " + screenClause + " " + returnClause;
})();
probe(answer !== undefined && answer !== null && String(answer).length > 0, "the computation returned an empty answer");
return answer;

